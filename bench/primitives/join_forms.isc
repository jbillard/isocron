// The forms of `join` (D607), each over 4096 texts (the large ones over
// `big` texts): texts of 60 bytes, of 7, of 0 to 6, of 0 to 130 and of 300
// bytes, separators of 0, 1, 3 and 70 bytes, known to the compiler or not,
// joins of 2 and of 6 texts, a join of 1 MiB or more (by ranges in
// parallel), a join read once by a `map` of its bytes (never made). Each
// line of the output: a name, the nanoseconds of one text joined (the mean
// over `rounds` rounds, `bench`) and a value of the result. One form at a
// time (to count its cycles and instructions: `perf stat` of two numbers of
// rounds, their difference over the texts between them), or all of them. No
// floor in C: measured against the same program built by another compiler.
// usage: join_forms <form | all> <rounds> <separator of one byte> <big>

// the line i: 60 letters
function line(i: i64): string {
    return stringOf(map(iota(60), (j) => u8(65 + (i * 7 + j * 13 + j * j) % 26)));
}

function text(n: i64, i: i64): string {
    return stringOf(map(iota(n), (j) => u8(97 + (i + j * 7) % 26)));
}

function ends(t: string): i64 {
    const b = bytes(t);
    return b.length == 0 ? 0 : b.length * 1000 + i64(b[0]) + i64(b[b.length - 1]);
}

action main(args: string[k]): i32 {
    const n = 4096;
    const form = args[0];
    const r = parseI64(args[1]);
    const s1 = args[2];
    const big = parseI64(args[3]);
    const all = form == "all";
    const ls = map(iota(n), line);
    const nums = map(iota(n), (i) => toString(1000000 + i * 997));
    const mixed = map(iota(n), (i) => text((i * 37) % 131, i));
    const short = map(iota(n), (i) => text(i % 7, i));
    const longs = map(iota(n / 2), (i) => text(300, i));
    const rows = map(iota(n), (i) => map(iota(6), (f) => toString(i * 31 + f * 1000)));
    const many = map(iota(big), line);
    const few = map(iota(64), (i) => text(300, i));
    const pairs = map(iota(n), (i) => [ls[i], ls[(i * 7 + 1) % n]]);
    const wide = text(70, 3);
    const each = f64(r * n);
    if (all || form == "join.line") {
        const [a, t] = bench(r, () => join(ls, ",").length);
        print(`join.line ${(f64(t) / each).toFixed(3)} ${a}`);
    }
    if (all || form == "join.kept") {
        const [a, t] = bench(r, () => join(ls, ","));
        print(`join.kept ${(f64(t) / each).toFixed(3)} ${ends(a)}`);
    }
    if (all || form == "join.nums") {
        const [a, t] = bench(r, () => join(nums, ","));
        print(`join.nums ${(f64(t) / each).toFixed(3)} ${ends(a)}`);
    }
    if (all || form == "join.empty") {
        const [a, t] = bench(r, () => join(ls, ""));
        print(`join.empty ${(f64(t) / each).toFixed(3)} ${ends(a)}`);
    }
    if (all || form == "join.sep3") {
        const [a, t] = bench(r, () => join(ls, "--|"));
        print(`join.sep3 ${(f64(t) / each).toFixed(3)} ${ends(a)}`);
    }
    if (all || form == "join.sepvar") {
        const [a, t] = bench(r, () => join(ls, s1));
        print(`join.sepvar ${(f64(t) / each).toFixed(3)} ${ends(a)}`);
    }
    if (all || form == "join.mixed") {
        const [a, t] = bench(r, () => join(mixed, ", "));
        print(`join.mixed ${(f64(t) / each).toFixed(3)} ${ends(a)}`);
    }
    if (all || form == "join.short") {
        const [a, t] = bench(r, () => join(short, ","));
        print(`join.short ${(f64(t) / each).toFixed(3)} ${ends(a)}`);
    }
    if (all || form == "join.long") {
        const [a, t] = bench(r, () => join(longs, "\n"));
        print(`join.long ${(f64(t) / each).toFixed(3)} ${ends(a)}`);
    }
    if (all || form == "join.long64") {
        // 64 texts of 300 bytes, in the caches: 64 joins a round
        const [a, t] = bench(r, () => sum(map(iota(64), (i) => join(few, "\n").length + i)));
        print(`join.long64 ${(f64(t) / each).toFixed(3)} ${a}`);
    }
    if (all || form == "join.sep70") {
        const [a, t] = bench(r, () => join(ls, wide));
        print(`join.sep70 ${(f64(t) / each).toFixed(3)} ${ends(a)}`);
    }
    if (all || form == "join.pair") {
        // 4096 joins of 2 texts of 60 bytes
        const [a, t] = bench(r, () => sum(map(iota(n), (i) => join(pairs[i], ", ").length)));
        print(`join.pair ${(f64(t) / each).toFixed(3)} ${a}`);
    }
    if (all || form == "join.six") {
        // 4096 joins of 6 texts each
        const [a, t] = bench(r, () => sum(map(iota(n), (i) => join(rows[i], ",").length)));
        print(`join.six ${(f64(t) / each).toFixed(3)} ${a}`);
    }
    if (all || form == "join.six.var") {
        const [a, t] = bench(r, () => sum(map(iota(n), (i) => join(rows[i], s1).length)));
        print(`join.six.var ${(f64(t) / each).toFixed(3)} ${a}`);
    }
    if (all || form == "join.large") {
        // `big` lines: by ranges in parallel from 1 MiB on
        const [a, t] = bench(r, () => join(many, "\n"));
        print(`join.large ${(f64(t) / f64(r * big)).toFixed(3)} ${ends(a)}`);
    }
    if (all || form == "joinmap") {
        // a join read once by a map of its bytes: never made
        const [a, t] = bench(r, () => {
            const j = join(ls, "\n");
            const c = map(bytes(j), (b) => b | 32u8);
            return c.length + i64(c[0]) + i64(c[c.length - 1]) + i64(c[c.length / 2]);
        });
        print(`joinmap ${(f64(t) / each).toFixed(3)} ${a}`);
    }
    if (all || form == "joinmap.large") {
        const [a, t] = bench(r, () => {
            const j = join(many, "\n");
            const c = map(bytes(j), (b) => b | 32u8);
            return c.length + i64(c[0]) + i64(c[c.length - 1]) + i64(c[c.length / 2]);
        });
        print(`joinmap.large ${(f64(t) / f64(r * big)).toFixed(3)} ${a}`);
    }
    return 0;
}
