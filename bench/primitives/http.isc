// The audit of every form against the machine (D301): the module `http`
// on the local machine, one thread. The client (D340): a response written
// by the server side, then the request sent and the response read by
// `exchange`: a small body by its length, 64 chunks of 1 KiB. The server
// (D342): 8 connections with 200 requests each written first, then all of
// them answered by `serveOn` (only it timed). Each line: a name, the
// nanoseconds of one exchange or request (the mean over `rounds`), a
// checksum; against `http.c` (the floor).
// usage: http <rounds>
import * as http from "http";
import * as net from "net";

const CONNS = 8;
const PER_CONN = 200;

function hello(r: http.Request): http.Response {
    return http.textResponse(200, "hello, world!");
}

// the same answer by an action (D352): `serveOn` answers one request at a
// time (D386)
action helloAction(r: http.Request): http.Response {
    return http.textResponse(200, "hello, world!");
}

// the bytes of `c` until `want` of them
action readSome(c: net.Conn, got: i64, want: i64): i64 {
    if (got >= want) {
        return got;
    }
    return match (net.read(c, 65536)) {
        Ok(b) => b.length == 0 ? got : readSome(c, got + b.length, want),
        Err(e) => got,
    };
}

// `n` connections to `port`, the requests written on each, the server run,
// then the responses read: the nanoseconds of the server and the bytes of
// the responses
action conns(l: net.Listener, port: i64, n: i64, requests: string, act: boolean): [u64, i64] {
    if (n == 0) {
        const t0 = clock();
        const r = act ? http.serveOn(l, helloAction, CONNS * PER_CONN) : http.serveOn(l, hello, CONNS * PER_CONN);
        return [clock() - t0, 0] as const;
    }
    return match (net.connect("127.0.0.1", port)) {
        Ok(c) => {
            const w = net.writeText(c, requests);
            const [t, got] = conns(l, port, n - 1, requests, act);
            const mine = readSome(c, 0, 1099511627776);
            net.close(c);
            return [t, got + mine] as const;
        },
        Err(e) => {
            net.closeListener(l);
            return [0u64, -1] as const;
        },
    };
}

// `r` rounds of the server: its nanoseconds and the bytes answered
action serveRounds(r: i64, t: u64, bytes: i64, act: boolean): [u64, i64] {
    if (r == 0) {
        return [t, bytes] as const;
    }
    const requests = join(map(iota(PER_CONN), (i) => "GET /hello HTTP/1.1\r\nHost: bench\r\n\r\n"), "");
    return match (net.listen("127.0.0.1", 0)) {
        Ok(l) => {
            const port = net.port(l);
            const [dt, got] = conns(l, port, CONNS, requests, act);
            return serveRounds(r - 1, t + dt, bytes + got, act);
        },
        Err(e) => [t, -1] as const,
    };
}

action exchanges(c: net.Conn, s: net.Conn, response: u8[n], r: i64, acc: i64): i64 {
    if (r == 0) {
        return acc;
    }
    const w = net.write(s, response);
    return match (http.exchange(c, "GET", "example.test", 80, 80, "/a", [], [])) {
        Ok(x) => exchanges(c, s, response, r - 1, acc + x.status + x.body.length),
        Err(e) => -1,
    };
}

action main(args: string[k]): i32 {
    const r = parseI64(args[0]);
    // the pure functions of the module (D392): 4096 of each
    const m = 4096;
    const urls = map(iota(m), (i) => `http://host${i % 10}.example:${8000 + i % 100}/path/${i}?q=${i}`);
    const [p1, u1] = bench(r, () => sum(map(urls, (u) => match (http.parseUrl(u)) {
        Ok(x) => {
            const [scheme, host, port, target] = x;
            return port + target.length;
        },
        Err(e) => -1,
    })));
    print(`parseUrl ${f64(u1) / f64(r * m)} ${p1}`);
    const hs = [["Server", "isc"] as const, ["Content-Type", "text/plain"] as const, ["Content-Length", "13"] as const, ["Date", "now"] as const, ["Connection", "keep-alive"] as const, ["X-Id", "42"] as const, ["Cache-Control", "no-cache"] as const, ["Vary", "Accept"] as const];
    const names = ["content-length", "date", "x-id", "vary", "server", "missing", "CONNECTION", "cache-control"];
    const [p2, u2] = bench(r, () => sum(map(iota(m), (i) => (http.headerOf(hs, names[i % 8]) ?? "").length)));
    print(`headerOf ${f64(u2) / f64(r * m)} ${p2}`);
    const resp: http.Response = { status: 200, headers: hs, body: bytes(join(map(iota(1024), (i) => "x"), "")) };
    const [p3, u3] = bench(r, () => sum(map(iota(m), (i) => (http.header(resp, names[i % 8]) ?? "").length)));
    print(`header ${f64(u3) / f64(r * m)} ${p3}`);
    const [p4, u4] = bench(r, () => sum(map(iota(m), (i) => http.text(resp).length + i % 2)));
    print(`text.1k ${f64(u4) / f64(r * m)} ${p4}`);
    const bodies = map(iota(m), (i) => `hello number ${i}`);
    const [p5, u5] = bench(r, () => sum(map(bodies, (b) => http.textResponse(200, b).body.length)));
    print(`textResponse ${f64(u5) / f64(r * m)} ${p5}`);
    const [p6, u6] = bench(r, () => sum(map(iota(m), (i) => http.httpDate(1767225600000000000 + i * 997123456789).length)));
    print(`httpDate ${f64(u6) / f64(r * m)} ${p6}`);
    const errs = map(iota(m), (i) => i % 3 == 0 ? http.Malformed("the head") : (i % 3 == 1 ? http.TooLarge(65536) : http.BadUrl("ftp://x")));
    const [p7, u7] = bench(r, () => sum(map(errs, (e) => http.message(e).length)));
    print(`message ${f64(u7) / f64(r * m)} ${p7}`);
    const small = bytes("HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\nContent-Length: 13\r\n\r\nhello, world!");
    const piece = join(map(iota(1024), (i) => "x"), "");
    const chunked = bytes("HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n" + join(map(iota(64), (i) => "400\r\n" + piece + "\r\n"), "") + "0\r\n\r\n");
    match (net.listen("127.0.0.1", 0)) {
        Ok(l) => {
            match (net.connect("127.0.0.1", net.port(l))) {
                Ok(c) => match (net.accept(l)) {
                    Ok([s, peer]) => {
                        const t0 = clock();
                        const a = exchanges(c, s, small, r, 0);
                        const t1 = clock();
                        print(`exchange.small ${f64(t1 - t0) / f64(r)} ${a / r}`);
                        const t2 = clock();
                        const b = exchanges(c, s, chunked, r, 0);
                        const t3 = clock();
                        print(`exchange.chunked64 ${f64(t3 - t2) / f64(r)} ${b / r}`);
                        net.close(s);
                        net.close(c);
                    },
                    Err(e) => net.close(c),
                },
                Err(e) => print("connect failed"),
            };
            net.closeListener(l);
        },
        Err(e) => print("listen failed"),
    };
    // the server: a tenth of the rounds, each of 1600 requests
    const sr = Math.max(r / 10, 1);
    const [st, sb] = serveRounds(sr, 0u64, 0, false);
    print(`serve.pipelined ${f64(st) / f64(sr * CONNS * PER_CONN)} ${sb / (sr * CONNS * PER_CONN)}`);
    const [at, ab] = serveRounds(sr, 0u64, 0, true);
    print(`serve.action.pipelined ${f64(at) / f64(sr * CONNS * PER_CONN)} ${ab / (sr * CONNS * PER_CONN)}`);
    return 0;
}
