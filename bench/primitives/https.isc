// The audit of every form against the machine (D301): the client of the
// module `https` (D343) against `openssl s_server` on the local machine
// (started by `run.py`: `// bench-server: tls`), one thread: a request on a
// connection of its own (the connection, the handshake of TLS 1.3, the
// request, the response, the end), its body of 13 bytes, then of 64 KiB.
// Each line: a name, the nanoseconds of one request (the mean over half of
// `rounds`), a checksum; against `https.c` (the floor: OpenSSL called
// directly, the same requests). The requests with the authorities of the
// system (`get`, `request`) read the authority of the session from
// `SSL_CERT_FILE`, which `run.py` sets, as OpenSSL reads it (D431); a server
// of TLS opened and closed on a listener (`serverOfTls`), its certificate
// and its key next to the authority.
// usage: https <rounds> <port> <authority.pem>
// bench-server: tls
import * as https from "https";
import * as net from "net";

// `n` requests of `url`: the sum of their statuses and lengths
action gets(url: string, ca: string, n: i64, acc: i64): i64 {
    if (n == 0) {
        return acc;
    }
    return match (https.getWith(url, ca)) {
        Ok(r) => gets(url, ca, n - 1, acc + r.status + r.body.length),
        Err(e) => -1,
    };
}

action main(args: string[k]): i32 {
    const r = Math.max(parseI64(args[0]) / 2, 1);
    const ca = readText(args[2]);
    const base = `https://localhost:${args[1]}`;
    const t0 = clock();
    const a = gets(base + "/hello.txt", ca, r, 0);
    const t1 = clock();
    print(`get.small ${f64(t1 - t0) / f64(r)} ${a / r}`);
    const t2 = clock();
    const b = gets(base + "/64k.bin", ca, r, 0);
    const t3 = clock();
    print(`get.64k ${f64(t3 - t2) / f64(r)} ${b / r}`);
    // the request with its method, headers and body, and the handshake
    // alone on a connection of `net` (D424)
    const t4 = clock();
    const c4 = requests(base + "/hello.txt", ca, r, 0);
    const t5 = clock();
    print(`requestWith.small ${f64(t5 - t4) / f64(r)} ${c4 / r}`);
    const t6 = clock();
    const h = handshakes(parseI64(args[1]), ca, r, 0);
    const t7 = clock();
    print(`startTls ${f64(t7 - t6) / f64(r)} ${h / r}`);
    // with the authorities of the system (D431)
    const t8 = clock();
    const g = systemGets(base + "/hello.txt", r, 0);
    const t9 = clock();
    print(`get.system.small ${f64(t9 - t8) / f64(r)} ${g / r}`);
    const t10 = clock();
    const q = systemRequests(base + "/hello.txt", r, 0);
    const t11 = clock();
    print(`request.system.small ${f64(t11 - t10) / f64(r)} ${q / r}`);
    // a server of TLS on a listener, opened and closed
    const dir = args[2].slice(0, args[2].length - 6);
    const cert = readText(dir + "server.pem");
    const key = readText(dir + "server.key");
    const t12 = clock();
    const s = tlsServers(cert, key, r, 0);
    const t13 = clock();
    print(`serverOfTls.close ${f64(t13 - t12) / f64(r)} ${s / r}`);
    return 0;
}

// `n` requests `GET url` by `get`, the authorities of the system: the sum
// of their statuses and lengths
action systemGets(url: string, n: i64, acc: i64): i64 {
    if (n == 0) {
        return acc;
    }
    return match (https.get(url)) {
        Ok(r) => systemGets(url, n - 1, acc + r.status + r.body.length),
        Err(e) => -1,
    };
}

// `n` requests by `request`, a header, the authorities of the system
action systemRequests(url: string, n: i64, acc: i64): i64 {
    if (n == 0) {
        return acc;
    }
    return match (https.request("GET", url, [["Accept", "text/plain"] as const], [])) {
        Ok(r) => systemRequests(url, n - 1, acc + r.status + r.body.length),
        Err(e) => -1,
    };
}

// `n` servers of TLS of a listener of a port of the system, each closed
action tlsServers(cert: string, key: string, n: i64, acc: i64): i64 {
    if (n == 0) {
        return acc;
    }
    const k = match (net.listen("127.0.0.1", 0)) {
        Ok(l) => match (net.serverOfTls(l, cert, key)) {
            Ok(s) => {
                net.closeServer(s);
                return 1;
            },
            Err(e) => 0,
        },
        Err(e) => 0,
    };
    return tlsServers(cert, key, n - 1, acc + k);
}

// `n` requests `GET url` by `requestWith`: the sum of their statuses and lengths
action requests(url: string, ca: string, n: i64, acc: i64): i64 {
    if (n == 0) {
        return acc;
    }
    return match (https.requestWith(ca, "GET", url, [["Accept", "text/plain"] as const], [])) {
        Ok(r) => requests(url, ca, n - 1, acc + r.status + r.body.length),
        Err(e) => -1,
    };
}

// `n` connections made clients of TLS (the handshake, the name checked), closed
action handshakes(port: i64, ca: string, n: i64, acc: i64): i64 {
    if (n == 0) {
        return acc;
    }
    const k = match (net.connect("localhost", port)) {
        Ok(c) => {
            const ok = match (net.startTls(c, "localhost", ca)) {
                Ok(_) => 1,
                Err(e) => 0,
            };
            net.close(c);
            return ok;
        },
        Err(e) => 0,
    };
    return handshakes(port, ca, n - 1, acc + k);
}
