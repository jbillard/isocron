// The pilot of the text of a float written in Isocron (SPEC section 17,
// order 2): `toString` of a `f64` or a `f32` by kinds of values, one kind
// a run, so that the cycles and the instructions of an element are read
// with `perf stat` as the difference between two numbers of rounds. Its
// line: the kind, the nanoseconds of a text (the mean over the rounds,
// `bench`), the sum of the lengths of the texts, two of the texts. The
// Rust version (the runtime's `isc_to_string_f64` and `isc_to_string_f32`)
// is measured by building this file with a compiler that still has it.
// The kinds, 4096 values each by default (as many branches as a processor
// learns: `rand`, `randhalf` and `randdec` are measured on 65536):
//   thirds     16 or 17 digits, the point inside (those of `numbers.isc`)
//   decimals   thousandths, 1 to 6 digits
//   ints       integers below 2^53
//   small      16 or 17 digits after `0.` and zeros
//   large      16 or 17 digits and zeros before the point
//   huge tiny  about 200 zeros after or before the digits
//   sub        subnormal doubles
//   zero half  0, and halves (an integer or a point, in turn)
//   mixed      20 digits before the point to 20 zeros after it, in a cycle
//   rand       the same, at random; randhalf, randdec: halves and decimals
//              of 0 to 5 places at random
//   thirds32 decimals32 ints32 small32 large32 mixed32: the same for `f32`
// usage: float_pilot <kind> <rounds> [values]

function pick(kind: string, i: i64): f64 {
    const third = (i % 2 == 0 ? 1.0 : -1.0) * f64(i * i * 7 + 1) / 3.0;
    return kind == "thirds" ? third
        : kind == "decimals" ? f64((i * 7919) % 1000003 - 500000) / 1000.0
        : kind == "ints" ? f64((i * 7919 * 104729) % 1000000007 - 500000000)
        : kind == "small" ? third * 1e-12
        : kind == "large" ? third * 1e15
        : kind == "huge" ? third * 1e200
        : kind == "tiny" ? third * 1e-200
        : kind == "sub" ? f64(i * i * i * 7919 + 1) * 5e-324
        : kind == "zero" ? 0.0
        : kind == "half" ? f64(i % 64) * 0.5
        : kind == "rand" ? (random(7, i) - 0.5) * 10.0 ** f64(randomInt(8, i, 41) - 20)
        : kind == "randhalf" ? f64(randomInt(9, i, 2000)) * 0.5
        : kind == "randdec" ? f64(randomInt(10, i, 2000000) - 1000000) / f64(10 ** randomInt(11, i, 6))
        : third * 10.0 ** f64((i * 7919) % 41 - 20);
}

function pick32(kind: string, i: i64): f32 {
    const third = f32((i % 2 == 0 ? 1.0 : -1.0) * f64(i * i * 7 + 1) / 3.0);
    return kind == "thirds32" ? third
        : kind == "decimals32" ? f32(f64((i * 7919) % 100003 - 50000) / 100.0)
        : kind == "ints32" ? f32((i * 7919) % 1000003 - 500000)
        : kind == "small32" ? third * 1e-12f32
        : kind == "large32" ? third * 1e15f32
        : third * f32(10.0 ** f64((i * 7919) % 41 - 20));
}

action main(args: string[k]): i32 {
    const n = args.length > 2 ? parseI64(args[2]) : 4096;
    const kind = args[0];
    const r = parseI64(args[1]);
    if (kind.endsWith("32")) {
        const ys = map(iota(n), (i) => pick32(kind, i));
        const [a, t] = bench(r, () => sum(map(ys, (y) => toString(y).length)));
        print(`${kind} ${(f64(t) / f64(r * n)).toFixed(3)} ${a} ${toString(ys[1])} ${toString(ys[4094])}`);
    } else {
        const xs = map(iota(n), (i) => pick(kind, i));
        const [a, t] = bench(r, () => sum(map(xs, (x) => toString(x).length)));
        print(`${kind} ${(f64(t) / f64(r * n)).toFixed(3)} ${a} ${toString(xs[1])} ${toString(xs[4094])}`);
    }
    return 0;
}
