// The audit of every form against the machine (D301): the module `net`
// (D339) on the local machine, one thread: a round trip of 64 bytes on a
// connection (written, read by the peer, written back, read), a connection
// made (`connect`, `accept`, both closed), 64 KiB sent and received. Each
// line: a name, the nanoseconds of one (the mean over `rounds`), a
// checksum; against `net.c` (the floor: the same calls of the system). A
// listener opened and closed, a name of `/etc/hosts` resolved (D412); a
// name asked to `dns_server.c` (started by `run.py`), its records A then
// AAAA (D414).
// usage: net <rounds> <port of DNS>
// bench-server: dns
import * as net from "net";

// the bytes of `c` until `n` of them are read: their sum
action readN(c: net.Conn, n: i64, sum: i64): i64 {
    if (n <= 0) {
        return sum;
    }
    return match (net.read(c, n)) {
        Ok(b) => b.length == 0 ? -1 : readN(c, n - b.length, sum + b.length),
        Err(e) => -1,
    };
}

action trips(c: net.Conn, s: net.Conn, x: u8[n], r: i64, acc: i64): i64 {
    if (r == 0) {
        return acc;
    }
    const w = net.write(c, x);
    const a = readN(s, x.length, 0);
    const w2 = net.write(s, x);
    const b = readN(c, x.length, 0);
    return trips(c, s, x, r - 1, acc + a + b);
}

action connects(l: net.Listener, port: i64, r: i64, acc: i64): i64 {
    if (r == 0) {
        return acc;
    }
    return match (net.connect("127.0.0.1", port)) {
        Ok(c) => match (net.accept(l)) {
            Ok([s, peer]) => {
                net.close(s);
                net.close(c);
                return connects(l, port, r - 1, acc + 1);
            },
            Err(e) => {
                net.close(c);
                return -1;
            },
        },
        Err(e) => -1,
    };
}

action sends(c: net.Conn, s: net.Conn, x: u8[n], r: i64, acc: i64): i64 {
    if (r == 0) {
        return acc;
    }
    const w = net.write(c, x);
    return sends(c, s, x, r - 1, acc + readN(s, x.length, 0));
}

action main(args: string[k]): i32 {
    const r = parseI64(args[0]);
    match (net.listen("127.0.0.1", 0)) {
        Ok(l) => {
            const port = net.port(l);
            match (net.connect("127.0.0.1", port)) {
                Ok(c) => match (net.accept(l)) {
                    Ok([s, peer]) => {
                        const small = map(iota(64), (i) => u8(i));
                        const t0 = clock();
                        const a = trips(c, s, small, r, 0);
                        const t1 = clock();
                        print(`roundtrip.64 ${f64(t1 - t0) / f64(r)} ${a / r}`);
                        const big = map(iota(65536), (i) => u8(i % 251));
                        const t2 = clock();
                        const b = sends(c, s, big, r, 0);
                        const t3 = clock();
                        print(`send.64k ${f64(t3 - t2) / f64(r)} ${b / r}`);
                        net.close(s);
                        net.close(c);
                    },
                    Err(e) => net.close(c),
                },
                Err(e) => print("connect failed"),
            };
            const t4 = clock();
            const n = connects(l, port, r, 0);
            const t5 = clock();
            print(`connect ${f64(t5 - t4) / f64(r)} ${n / r}`);
            net.closeListener(l);
        },
        Err(e) => print("listen failed"),
    };
    const t6 = clock();
    const o = listens(r, 0);
    const t7 = clock();
    print(`listen.close ${f64(t7 - t6) / f64(r)} ${o / r}`);
    const t8 = clock();
    const h = resolves("ip6-localhost", r, 0);
    const t9 = clock();
    print(`resolve.hosts ${f64(t9 - t8) / f64(r)} ${h / r}`);
    const dns = parseI64(args[1]);
    const t10 = clock();
    const q = lookups("bench.test", dns, r, 0);
    const t11 = clock();
    print(`lookup ${f64(t11 - t10) / f64(r)} ${q / r}`);
    // the functions of a `Server` and of a connection kept (D424)
    match (net.listen("127.0.0.1", 0)) {
        Ok(l) => {
            const port = net.port(l);
            match (net.connect("127.0.0.1", port)) {
                Ok(c) => match (net.accept(l)) {
                    Ok([s, peer]) => {
                        const t12 = clock();
                        const tm = timeouts(c, r, 0);
                        const t13 = clock();
                        print(`setTimeout ${f64(t13 - t12) / f64(r)} ${tm / r}`);
                        net.close(s);
                        net.close(c);
                    },
                    Err(e) => net.close(c),
                },
                Err(e) => print("connect failed"),
            };
            const t14 = clock();
            const cw = closeWrites(l, port, r, 0);
            const t15 = clock();
            print(`connect.closeWrite ${f64(t15 - t14) / f64(r)} ${cw / r}`);
            net.closeListener(l);
        },
        Err(e) => print("listen failed"),
    };
    const t16 = clock();
    const so = serverOpens(r, 0);
    const t17 = clock();
    print(`server.open.close ${f64(t17 - t16) / f64(r)} ${so / r}`);
    match (net.listen("127.0.0.1", 0)) {
        Ok(l) => {
            const port = net.port(l);
            match (net.serverOf(l)) {
                Ok(s) => {
                    match (net.connect("127.0.0.1", port)) {
                        Ok(c) => {
                            const x = map(iota(64), (i) => u8(i));
                            const t18 = clock();
                            const sr = serverRounds(s, c, x, r, 0);
                            const t19 = clock();
                            print(`server.roundtrip.64 ${f64(t19 - t18) / f64(r)} ${sr / r}`);
                            net.close(c);
                        },
                        Err(e) => print("connect failed"),
                    };
                    const t20 = clock();
                    const sc = serverConns(s, port, r, 0);
                    const t21 = clock();
                    print(`server.conn ${f64(t21 - t20) / f64(r)} ${sc / r}`);
                    net.closeServer(s);
                },
                Err(e) => print("no server"),
            };
        },
        Err(e) => print("listen failed"),
    };
    return 0;
}

// `r` time limits set on `c`: how many set
action timeouts(c: net.Conn, r: i64, acc: i64): i64 {
    if (r == 0) {
        return acc;
    }
    const k = match (net.setTimeout(c, 1000)) {
        Ok(_) => 1,
        Err(e) => 0,
    };
    return timeouts(c, r - 1, acc + k);
}

// `r` connections made, the sending side of each closed, both ends closed
action closeWrites(l: net.Listener, port: i64, r: i64, acc: i64): i64 {
    if (r == 0) {
        return acc;
    }
    return match (net.connect("127.0.0.1", port)) {
        Ok(c) => match (net.accept(l)) {
            Ok([s, peer]) => {
                const k = match (net.closeWrite(c)) {
                    Ok(_) => 1,
                    Err(e) => 0,
                };
                net.close(s);
                net.close(c);
                return closeWrites(l, port, r - 1, acc + k);
            },
            Err(e) => {
                net.close(c);
                return -1;
            },
        },
        Err(e) => -1,
    };
}

// `r` servers of a listener of a port of the system, each closed
action serverOpens(r: i64, acc: i64): i64 {
    if (r == 0) {
        return acc;
    }
    const k = match (net.listen("127.0.0.1", 0)) {
        Ok(l) => match (net.serverOf(l)) {
            Ok(s) => {
                net.closeServer(s);
                return 1;
            },
            Err(e) => 0,
        },
        Err(e) => 0,
    };
    return serverOpens(r - 1, acc + k);
}

// the bytes of one connection waited for: its number and their count
action arrival(s: net.Server, tries: i64): [i64, i64] {
    if (tries == 0) {
        return [-1, 0] as const;
    }
    return match (net.wait(s, 65536, 1000)) {
        Ok(xs) => {
            const got = filter(xs, (a) => a.bytes.length > 0);
            return got.length > 0 ? [got[0].id, got[0].bytes.length] as const : arrival(s, tries - 1);
        },
        Err(e) => [-1, 0] as const,
    };
}

// `r` exchanges of `x` through the server: written by the client, waited
// for, sent back by `sendTo`, read
action serverRounds(s: net.Server, c: net.Conn, x: u8[n], r: i64, acc: i64): i64 {
    if (r == 0) {
        return acc;
    }
    const w = net.write(c, x);
    const [id, k] = arrival(s, 10);
    const sent = net.sendTo(s, id, x);
    const back = readN(c, x.length, 0);
    return serverRounds(s, c, x, r - 1, acc + k + back);
}

// `r` connections to the server, a byte from each waited for, each closed
// by `closeConn`
action serverConns(s: net.Server, port: i64, r: i64, acc: i64): i64 {
    if (r == 0) {
        return acc;
    }
    const k = match (net.connect("127.0.0.1", port)) {
        Ok(c) => {
            const w = net.writeText(c, "x");
            const [id, n] = arrival(s, 10);
            net.closeConn(s, id);
            net.close(c);
            return n;
        },
        Err(e) => 0,
    };
    return serverConns(s, port, r - 1, acc + k);
}

// `r` lookups of `host` asked to the server of DNS on `port`: its
// addresses, 100 each and their lengths
action lookups(host: string, port: i64, r: i64, acc: i64): i64 {
    if (r == 0) {
        return acc;
    }
    const k = match (net.lookup(host, "127.0.0.1", port)) {
        Ok(xs) => 100 * xs.length + sum(map(xs, (x) => x.length)),
        Err(e) => -1,
    };
    return lookups(host, port, r - 1, acc + k);
}

// `r` listeners on a port of the system, each closed: how many opened
action listens(r: i64, acc: i64): i64 {
    if (r == 0) {
        return acc;
    }
    const k = match (net.listen("127.0.0.1", 0)) {
        Ok(l) => {
            net.closeListener(l);
            return 1;
        },
        Err(e) => 0,
    };
    return listens(r - 1, acc + k);
}

// `r` resolutions of `host` (a name of `/etc/hosts`): its addresses, 100
// each and their lengths
action resolves(host: string, r: i64, acc: i64): i64 {
    if (r == 0) {
        return acc;
    }
    const k = match (net.resolve(host)) {
        Ok(xs) => 100 * xs.length + sum(map(xs, (x) => x.length)),
        Err(e) => -1,
    };
    return resolves(host, r - 1, acc + k);
}
