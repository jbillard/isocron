// The audit of every form against the machine (D301): the functions of
// the module `time` (D334) on 4096 instants of 2026, one per 997 seconds
// and 123456789 ns. Each line: a name, the nanoseconds of one call (the
// mean over `rounds`), a checksum; against `time.c` (the floor).
// usage: time <rounds>
import * as time from "time";

action nowLoop(r: i64, acc: i64): i64 {
    if (r == 0) {
        return acc;
    }
    return nowLoop(r - 1, acc + (time.now() > 0 ? 1 : 0));
}

action main(args: string[k]): i32 {
    const r = parseI64(args[0]);
    const n = 4096;
    const ins = map(iota(n), (i) => 1767225600000000000 + i * 997123456789);
    const texts = map(ins, (i) => time.formatIso(i));
    // r times n calls (D372: r calls, 4 µs for 200, counted a cost paid
    // once of about 2 µs as 10 ns a call)
    const t0 = clock();
    const a0 = nowLoop(r * n, 0);
    const t1 = clock();
    print(`now ${f64(t1 - t0) / f64(r * n)} ${a0 / (r * n)}`);
    const each = f64(r * n);
    const [a1, t2] = bench(r, () => sum(map(ins, (i) => time.toDateTime(i, 60).time.minute)));
    print(`toDateTime ${f64(t2) / each} ${a1}`);
    const [a2, t3] = bench(r, () => sum(map(ins, (i) => time.formatIso(i).length)));
    print(`formatIso ${f64(t3) / each} ${a2}`);
    const [a3, t4] = bench(r, () => sum(map(texts, (s) => match (time.parseIso(s)) {
        Ok(d) => d.time.second,
        Err(e) => -1,
    })));
    print(`parseIso ${f64(t4) / each} ${a3}`);
    const [a4, t5] = bench(r, () => sum(map(iota(n), (i) => time.daysOf(time.dateOf(i * 37 - 70000)))));
    print(`dateOf.daysOf ${f64(t5) / each} ${a4}`);
    // the other functions of the module (D392): 4096 dates, times and
    // years each
    const dates = map(iota(n), (i) => time.dateOf(i * 37 - 70000));
    const times = map(ins, (i) => time.toDateTime(i, 60));
    const [a5, t6] = bench(r, () => count(iota(n), (i) => time.isLeapYear(1600 + i)));
    print(`isLeapYear ${f64(t6) / each} ${a5}`);
    const [a6, t7] = bench(r, () => sum(map(iota(n), (i) => time.daysInMonth(1900 + i / 12, i % 12 + 1))));
    print(`daysInMonth ${f64(t7) / each} ${a6}`);
    const [a7, t8] = bench(r, () => sum(map(dates, (d) => time.weekday(d))));
    print(`weekday ${f64(t8) / each} ${a7}`);
    const [a8, t9] = bench(r, () => sum(map(iota(n), (i) => time.addDays(dates[i], i - 2000).day)));
    print(`addDays ${f64(t9) / each} ${a8}`);
    const [a9, t10] = bench(r, () => sum(map(iota(n), (i) => time.addMonths(dates[i], i % 25 - 12).day)));
    print(`addMonths ${f64(t10) / each} ${a9}`);
    const [a10, t11] = bench(r, () => sum(map(iota(n), (i) => time.daysBetween(dates[i], dates[i / 2]))));
    print(`daysBetween ${f64(t11) / each} ${a10}`);
    const [a11, t12] = bench(r, () => count(iota(n), (i) => time.toInstant(times[i]) == ins[i]));
    print(`toInstant ${f64(t12) / each} ${a11}`);
    const [a12, t13] = bench(r, () => sum(map(times, (d) => time.formatDateTime(d).length)));
    print(`formatDateTime ${f64(t13) / each} ${a12}`);
    const [a13, t14] = bench(r, () => sum(map(times, (d) => time.format(d, "YYYY/MM/DD HH:mm:ss.SSS Z").length)));
    print(`format ${f64(t14) / each} ${a13}`);
    return 0;
}
