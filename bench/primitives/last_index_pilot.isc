// The pilot of `lastIndexOf` written in Isocron (SPEC section 17, order 2;
// D626): one kind of search a run, so that the cycles and the
// instructions of a search are read with `perf stat` as the difference
// between two numbers of rounds. Its line: the kind, the nanoseconds of a
// search (the mean over the rounds, `bench`), the sum of the places found,
// the length of a text. The Rust version (the runtime's
// `isc_last_index_of`: windows of 16 bytes up to 64, `memrchr`,
// `memmem::rfind`) is measured by building this file with a compiler that
// still has it.
// The kinds `<text>.<needle>.<where>`:
//   text    line: 60 bytes of 16 letters, 4096 texts; long: 4096 bytes,
//           256 texts; utf8: 60 bytes, a character of two bytes in five
//   needle  its bytes: 1, 2, 5, 30
//   where   end: its one place 5 bytes before the end; start: its one
//           place 3 bytes after the start; never: none, its bytes in no
//           text; near: none, its first and last bytes everywhere (texts of
//           4 letters, the needle `a`, then `z`s, then `d`)
// usage: last_index_pilot <kind> <rounds> [texts]

// `n` letters from `base`, of `span` kinds, at random (the seed `i`)
function letters(i: i64, n: i64, base: i64, span: i64): string {
    return stringOf(map(iota(n), (j) => u8(base + randomInt(i, j, span))));
}

// `n` bytes, a character of two bytes in five
function utf8(i: i64, n: i64): string {
    return join(map(iota(n / 5), (g) => letters(i + g, 3, 97, 16) + "\u{e9}"), "") + letters(i, n % 5, 97, 16);
}

function needle(where: string, m: i64): string {
    return where == "near" ? (m == 1 ? "z" : "a" + letters(0, m - 2, 122, 1) + "d")
        : where == "never" ? letters(5, m, 113, 6)
        : letters(3, m, 119, 4);
}

function body(shape: string, where: string, i: i64, n: i64): string {
    return shape == "utf8" ? utf8(i, n) : letters(i, n, 97, where == "near" ? 4 : 16);
}

function text(shape: string, where: string, p: string, m: i64, i: i64): string {
    const n = shape == "long" ? 4096 : 60;
    return where == "end" ? body(shape, where, i, n - m - 5) + p + letters(i, 5, 97, 16)
        : where == "start" ? letters(i, 3, 97, 16) + p + body(shape, where, i, n - m - 3)
        : body(shape, where, i, n);
}

action main(args: string[k]): i32 {
    const kind = args[0];
    const parts = split(kind, ".");
    const r = parseI64(args[1]);
    const n = args.length > 2 ? parseI64(args[2]) : parts[0] == "long" ? 256 : 4096;
    const m = parseI64(parts[1]);
    const p = needle(parts[2], m);
    const xs = map(iota(n), (i) => text(parts[0], parts[2], p, m, i));
    const [a, t] = bench(r, () => sum(map(xs, (s) => s.lastIndexOf(p))));
    print(`${kind} ${(f64(t) / f64(r * n)).toFixed(3)} ${a} ${xs[n - 1].length}`);
    return 0;
}
