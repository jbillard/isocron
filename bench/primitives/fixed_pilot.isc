// The pilot of `toFixed` written in Isocron (SPEC section 17, order 2):
// `x.toFixed(d)` by kinds of values and numbers of decimals, one kind a
// run, so that the cycles and the instructions of a call are read with
// `perf stat` as the difference between two numbers of rounds. Its line:
// the kind and the decimals, the nanoseconds of a call (the mean over the
// rounds, `bench`), the sum of the lengths of the texts, two of the texts.
// The Rust version (the runtime's `isc_to_fixed`) is measured by building
// this file with a compiler that still has it. The kinds, 4096 values
// each by default:
//   thirds   thirds from 0.3 to 4e7 of both signs (those of `numbers.isc`)
//   unit     thirds below 1
//   small    below 2^-11: a fraction of more than 64 bits
//   tiny     about 1e-30: zeros up to 18 decimals, digits beyond
//   ints     integers below 2^53
//   big      integers from 2^52 on, below 1e21
//   zero     0
//   ties     eighths: halfway between two numbers of 2 decimals in turn
//   nines    just below an integer: the decimals round to the next one
//   huge     from 1e21 on (the text of `print`)
//   nan      what is not a number: NaN, inf and -inf in turn
//   mixed    1e-20 to 1e20, in a cycle
// usage: fixed_pilot <kind> <decimals> <rounds> [values]

function pick(kind: string, i: i64): f64 {
    const third = (i % 2 == 0 ? 1.0 : -1.0) * f64(i * i * 7 + 1) / 3.0;
    return kind == "thirds" ? third
        : kind == "unit" ? third / 40000000.0
        : kind == "small" ? third * 1e-12
        : kind == "tiny" ? third * 1e-37
        : kind == "ints" ? f64((i * 7919 * 104729) % 1000000007 - 500000000)
        : kind == "big" ? (i % 2 == 0 ? 1.0 : -1.0) * f64(i * 7 + 4) * 4503599627370496.0 / 3.0
        : kind == "zero" ? 0.0
        : kind == "ties" ? f64(i % 800 - 400) / 8.0
        : kind == "nines" ? f64(i % 1000 + 1) - 1.0 / f64(1024 * (i % 7 + 1) * 1048576)
        : kind == "huge" ? third * 1e25
        : kind == "nan" ? (i % 3 == 0 ? parseF64("NaN") : i % 3 == 1 ? parseF64("inf") : parseF64("-inf"))
        : third * 10.0 ** f64((i * 7919) % 41 - 20);
}

action main(args: string[k]): i32 {
    const kind = args[0];
    const d = parseI64(args[1]);
    const r = parseI64(args[2]);
    const n = args.length > 3 ? parseI64(args[3]) : 4096;
    const xs = map(iota(n), (i) => pick(kind, i));
    const [a, t] = bench(r, () => sum(map(xs, (x) => x.toFixed(d).length)));
    print(`${kind}.${d} ${(f64(t) / f64(r * n)).toFixed(3)} ${a} ${xs[1].toFixed(d)} ${xs[n - 2].toFixed(d)}`);
    return 0;
}
