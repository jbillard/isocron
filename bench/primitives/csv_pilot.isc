// The pilot of the readers of CSV written in Isocron (SPEC section 17,
// order 2; D626): `parseCsvF64`, and `readCsvF64` and
// `tryReadCsvF64` of a file, one kind of text a run, so that the cycles
// and the instructions of a field are read with `perf stat` as the
// difference between two numbers of rounds. Its line: the kind, the
// nanoseconds of a field (the mean over the rounds), the rows, the
// columns, the sum of the values. The Rust version (the runtime's
// `isc_parse_csv_f64`, `isc_read_csv_f64`, `isc_try_read_csv_f64`: each
// field read twice by `str::parse`, once to count, once to keep) is
// measured by building this file with a compiler that still has it.
// The kinds `[read.|try.]<columns>.<numbers>[.<form>]`:
//   columns  few: 3, 1024 rows; many: 40, 100 rows
//   numbers  short: integers of 1 to 3 digits; long: 17 digits, a point
//            inside, half of them negative
//   form     crlf: lines ended by `\r\n`; spaced: `, ` between the fields
//            and spaces at the ends of the lines; blank: a header (skipped)
//            and a blank line in 8
//   read., try.: the text written to the file `args[2]` once, then read
//            by `readCsvF64` or `tryReadCsvF64` at each round
// usage: csv_pilot <kind> <rounds> [file]

function number(long: boolean, i: i64): string {
    return long ? toString((i % 2 == 0 ? 1.0 : -1.0) * f64(i * i * 7 + 1) / 3.0) : toString(randomInt(3, i, 1000));
}

function line(cols: i64, long: boolean, form: string, i: i64): string {
    const fields = join(map(iota(cols), (j) => number(long, i * cols + j)), form == "spaced" ? ", " : ",");
    return form == "spaced" ? `  ${fields} ` : fields;
}

function csv(cols: i64, rows: i64, long: boolean, form: string): string {
    const eol = form == "crlf" ? "\r\n" : "\n";
    const head = form == "blank" ? `a,b,c${eol}` : "";
    return head + join(map(iota(rows), (i) => line(cols, long, form, i) + eol + (form == "blank" && i % 8 == 7 ? eol : "")), "");
}

// `r` readings of the text, a sum of what they gave
action rounds(t: string, skip: i64, r: i64, acc: f64): f64 {
    if (r == 0) {
        return acc;
    }
    const m = parseCsvF64(t, skip);
    return rounds(t, skip, r - 1, acc + m[0][0] + f64(m.length));
}

action roundsRead(path: string, skip: i64, r: i64, acc: f64): f64 {
    if (r == 0) {
        return acc;
    }
    const m = readCsvF64(path, skip);
    return roundsRead(path, skip, r - 1, acc + m[0][0] + f64(m.length));
}

action roundsTry(path: string, skip: i64, r: i64, acc: f64): f64 {
    if (r == 0) {
        return acc;
    }
    const v = match (tryReadCsvF64(path, skip)) {
        Ok(m) => m[0][0] + f64(m.length),
        Err(e) => -1.0,
    };
    return roundsTry(path, skip, r - 1, acc + v);
}

action main(args: string[k]): i32 {
    const kind = args[0];
    const parts = split(kind, ".");
    const io = parts[0] == "read" || parts[0] == "try";
    const at = io ? 1 : 0;
    const few = parts[at] == "few";
    const cols = few ? 3 : 40;
    const rows = few ? 1024 : 100;
    const long = parts[at + 1] == "long";
    const form = parts.length > at + 2 ? parts[at + 2] : "";
    const skip = form == "blank" ? 1 : 0;
    const r = parseI64(args[1]);
    const t = csv(cols, rows, long, form);
    const m = parseCsvF64(t, skip);
    const total = sum(map(m, (row) => sum(row)));
    if (io) {
        writeText(args[2], t);
    }
    const t0 = clock();
    const a = parts[0] == "read" ? roundsRead(args[2], skip, r, 0.0) : parts[0] == "try" ? roundsTry(args[2], skip, r, 0.0) : rounds(t, skip, r, 0.0);
    const ns = clock() - t0;
    print(`${kind} ${(f64(ns) / f64(r * rows * cols)).toFixed(3)} ${m.length} ${m[0].length} ${total} ${a}`);
    return 0;
}
