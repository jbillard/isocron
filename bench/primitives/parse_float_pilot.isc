// The pilot of the reading of a float written in Isocron (SPEC section 17,
// order 2): `parseF64` by kinds of texts, one kind a run, so that the
// cycles and the instructions of a text are read with `perf stat` as the
// difference between two numbers of rounds. Its line: the kind, the
// nanoseconds of a text (the mean over the rounds, `bench`), a checksum of
// the values, two of the texts. The Rust version (the runtime's
// `isc_parse_f64`) is measured by building this file with a compiler that
// still has it. The kinds, 4096 texts each by default:
//   decimals   thousandths from -500 to 500 (those of `numbers.isc`)
//   short      hundredths below 1000, no sign: 1 to 6 bytes
//   ints6      integers of 1 to 7 digits
//   ints       integers of 9 digits, half of them negative
//   money      hundredths of 9 to 12 bytes, half of them negative
//   thirds     16 or 17 digits, the point inside
//   exps       1 to 4 digits and an exponent of -20 to 20
//   sci        9 digits and an exponent of -30 to 30: 12 to 15 bytes
//   sci3       12 digits and an exponent of 3 digits: 17 to 19 bytes
//   exps17     17 digits and an exponent of -300 to 300
//   ints17     integers of 17 to 19 digits
//   small      16 or 17 digits after `0.` and zeros (more than 24 bytes)
//   large      16 or 17 digits and zeros before the point
//   huge tiny  about 200 zeros after or before the digits
//   long       25 digits: more than a word holds
//   ties       21 digits, the middle of two floats and a digit: decided by
//              the digits themselves
//   names      `inf`, `-inf`, `NaN`, `infinity`
//   mixed      decimals, thirds, exps, ints in turn
//   rand       the same four at random (measured on 65536 texts)
// usage: parse_float_pilot <kind> <rounds> [values]

function third(i: i64): f64 {
    return (i % 2 == 0 ? 1.0 : -1.0) * f64(i * i * 7 + 1) / 3.0;
}

function decimal(i: i64): string {
    return toString(f64((i * 7919) % 1000003 - 500000) / 1000.0);
}

function exponent(i: i64): string {
    return `${f64((i * 7919) % 10007) / f64(10 ** (i % 4))}e${(i * 31) % 41 - 20}`;
}

function integer(i: i64): string {
    return toString((i * 7919 * 104729) % 1000000007 - 500000000);
}

function text(kind: string, i: i64): string {
    return kind == "decimals" ? decimal(i)
        : kind == "short" ? toString(f64((i * 7919) % 100000) / 100.0)
        : kind == "ints6" ? toString((i * 7919) % 1000003)
        : kind == "ints" ? integer(i)
        : kind == "money" ? toString(f64((i * 7919 * 104729) % 10000000007 - 5000000000) / 100.0)
        : kind == "thirds" ? toString(third(i))
        : kind == "exps" ? exponent(i)
        : kind == "sci" ? `${f64((i * 7919 * 104729) % 900000000 + 100000000) / 100000000.0}e${(i * 31) % 61 - 30}`
        : kind == "sci3" ? `${f64((i * 7919 * 104729) % 900000000007 + 100000000000) / 100000000000.0}e${i % 2 == 0 ? "-" : ""}${100 + (i * 31) % 200}`
        : kind == "ints17" ? toString(((i * 7919 * 104729) % 1000000007 + 100000000) * (i % 3 == 0 ? 123456789 : i % 3 == 1 ? 1234567891 : 7000000007))
        : kind == "exps17" ? `${toString(1.0 + f64(i * 7 + 1) / f64(i * 7 + 2) * (i % 2 == 0 ? 1.0 : -3.0))}e${(i * 7919) % 601 - 300}`
        : kind == "small" ? toString(third(i) * 1e-12)
        : kind == "large" ? toString(third(i) * 1e15)
        : kind == "huge" ? toString(third(i) * 1e200)
        : kind == "tiny" ? toString(third(i) * 1e-200)
        : kind == "long" ? `${toString(third(i))}${10000000 + (i * 7919) % 89999999}`
        : kind == "ties" ? `${9007199254740993 + 2 * i}.000${i % 9 + 1}`
        : kind == "names" ? (i % 4 == 0 ? "inf" : i % 4 == 1 ? "-inf" : i % 4 == 2 ? "NaN" : "infinity")
        : kind == "rand" ? pick(randomInt(7, i, 4), i)
        : pick(i % 4, i);
}

function pick(which: i64, i: i64): string {
    return which == 0 ? decimal(i) : which == 1 ? toString(third(i)) : which == 2 ? exponent(i) : integer(i);
}

action main(args: string[k]): i32 {
    const n = args.length > 2 ? parseI64(args[2]) : 4096;
    const kind = args[0];
    const r = parseI64(args[1]);
    const xs = map(iota(n), (i) => text(kind, i));
    const [a, t] = bench(r, () => sum(map(xs, (s) => i64(parseF64(s) * 3.0))));
    print(`${kind} ${(f64(t) / f64(r * n)).toFixed(3)} ${a} ${xs[1]} ${xs[n - 2]}`);
    return 0;
}
