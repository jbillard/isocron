// The test of the small blocks of `kernel_alloc.isc` on several threads
// (D603): each task takes blocks, marks them with its number, checks its
// marks and gives the blocks back, many times; a part of the blocks of each
// round is kept and freed at the next, so that the lists of the threads
// overflow into the shared ones and are refilled from them.

function wanted(i: i64): i64 {
    return 1 + (i * 37) % 1024;
}

function held(i: i64): i64 {
    return (wanted(i) + 63) / 64 * 64;
}

// One round of the task `t`: 200 blocks marked, checked, given back; the
// marks that were wrong.
action round(t: i64, r: i64): i64 {
    const per = 200;
    const ps = map(iota(per), (i) => {
        const p = $kAlloc(wanted(i + r * 7 + t));
        $store64(p, u64(t * 1000000 + i));
        $store64(p + u64(held(i + r * 7 + t) - 8), u64(t + 1));
        return p;
    });
    const marks = map(iota(per), (i) => $load64(ps[i]) == u64(t * 1000000 + i) && $load64(ps[i] + u64(held(i + r * 7 + t) - 8)) == u64(t + 1) ? 0 : 1);
    const f = map(iota(per), (i) => $kFree(ps[i]));
    return sum(marks);
}

action task(t: i64): i64 {
    return sum(map(iota(300), (r) => round(t, r)));
}

action main(args: string[k]): i32 {
    const base = $kStart();
    const wrong = mapParallel(iota(16), task);
    print(wrong);
    print(i64(($load64(base) - base) / 1048576u64) < 64 ? 1 : 0);
    return 0;
}
