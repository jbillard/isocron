// The rows of a `map` of rows (D593): borrowed (an array, the bytes of a
// text, a branch of an `if`), computed, moved at their last use; read from
// the array made, or by a consumer of the `map` itself.

function pick(x: i64[n], y: i64[n], k: i64): i64[n] {
    return k % 2 == 0 ? x : y;
}

function scaled(x: i64[n], k: i64): i64[n] {
    return map(x, (v) => v * k);
}

action main(args: string[k]): i32 {
    const q = parseI64(args[0]);
    const ls = map(iota(4), (i) => toString(1000 * q + i));
    const a = map(iota(3), (i) => i + q);
    const b = map(iota(3), (i) => i * q);

    // borrowed rows, each copied into the block of the rows
    print(map(iota(4), (i) => i % 2 == 0 ? a : b));
    print(map(iota(4), (i) => match (i % 3) { 0 => a, 1 => b, _ => a }));
    print(map(iota(4), (i) => i == 0 ? a : i == 1 ? b : i == 2 ? map(a, (x) => -x) : a));
    print(map(iota(4), (i) => pick(a, b, i)));
    print(map(iota(4), (i) => { const z = i % 2 == 0 ? a : b; return z; }));
    print(map(iota(2), (i) => a.slice(i, i + 2)));

    // the bytes of a text read where it is
    const s = ls[1] + "x";
    print(map(iota(3), (i) => bytes(s)));
    const bs = map(iota(4), (i) => bytes(ls[i]));
    print(bs);
    print(sum(map(iota(4), (i) => i64(bs[i][3]))));
    print(map(iota(4), (i) => i % 2 == 0 ? bytes(ls[i]) : bytes(ls[0])));
    print(map(iota(4), (i) => bytes(ls[i].slice(1, 3))));
    print(map(filter(ls, (t) => t.length > 0), (t) => bytes(t)));

    // rows of texts
    const m = [ls, ls];
    print(map(iota(3), (i) => i % 2 == 0 ? m[i / 2] : ls));

    // a row at its last use: moved
    const z1 = map(a, (x) => x * 2);
    print(map(iota(1), (i) => z1));
    const z2 = map(a, (x) => x * 3);
    print(map(iota(2), (i) => i == 0 ? z2 : a));

    // rows in a tuple
    const ps = map(iota(4), (i) => [i % 2 == 0 ? a : b, i] as const);
    print(map(ps, (p) => { const [r, j] = p; return r[0] + j; }));

    // a `map` of rows read by its consumer: no row lost
    print(sum(map(map(iota(4), (i) => map(a, (x) => x + i)), (r) => r[1])));
    print(sum(map(map(iota(4), (i) => map(a, (x) => x + i)), (r) => sum(r))));
    print(sum(map(map(iota(4), (i) => i % 2 == 0 ? a : b), (r) => r[1])));
    print(sum(map(map(iota(4), (i) => scaled(a, i)), (r) => r[2])));
    print(sum(map(map(iota(4), (i) => map(a, (x) => x + i)).slice(1, 3), (r) => r[1])));
    print(sum(map(map(iota(4), (i) => map(a, (x) => toString(x + i))), (r) => r[1].length)));
    print(fold(map(iota(4), (i) => map(a, (x) => x + i)), 0, (acc, r) => acc + r[2]));
    print(count(map(iota(4), (i) => map(a, (x) => x + i)), (r) => r[1] > q + 1));
    print(map(iota(4), (i) => map(a, (x) => x + i)).length);
    // rows that are views of an array that lives longer: read where they are
    print(sum(map(map(iota(2), (i) => m[i]), (r) => r[2].length)));

    // rows folded, filled
    print(fold([a, b, a], a, (acc, r) => r[1] > acc[1] ? r : acc));
    print(fold([a, b, a], map(iota(3), (j) => 0), (acc, r) => map(iota(3), (j) => acc[j] + r[j])));
    print(fill(3, map(a, (x) => x + 1)));
    print(fill(2, a));
    print(count([a, b, a], (r) => r[1] > q));

    print(ls);
    print(a);
    print(b);
    return 0;
}
