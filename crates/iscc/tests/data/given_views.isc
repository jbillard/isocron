// A state of many numbers kept through rounds by four forms that copied it
// whole at each call before D666: a number read from it before it is made
// anew (`guarded`); a view of it given beside it to a function that takes
// it (`edited`); a function that makes it anew from its parts, the part
// kept read before (`redrawn`); a state made anew as the component of a
// tuple (`paired`).
type Vm = { heap: f64[], n: i64 };
type Row = { name: string, args: f64[] };
type App = { vm: Vm, rows: Row[], ran: boolean, tag: string };
type Frame = { side: i64, cells: f64[], count: i64 };

@noInline
function set(v: Vm, i: i64, x: f64): Vm {
    return { ...v, heap: v.heap.with(i % v.heap.length, x) };
}

function look(v: Vm, i: i64): i64 {
    return v.n + i;
}

// a number read from the state, a path that gives it back whole
@noInline
function guarded(a: App, k: i64): App {
    const t = look(a.vm, k);
    if (t < 0) {
        return a;
    }
    const v1 = set(a.vm, k, 1.0);
    return { ...a, vm: set(v1, k + 1, 2.0), ran: true };
}

// a row of the state given beside it
@noInline
function used(a: App, r: Row, k: i64): App {
    return { ...a, vm: set(a.vm, k, f64(r.args.length)), tag: r.name };
}

@noInline
function edited(a: App, k: i64): App {
    const p = k % a.rows.length;
    return p < 0 ? a : used(a, a.rows[p], k);
}

// a frame made anew from the last: its side kept, its cells read
@noInline
function redrawn(f: Frame, k: i64): Frame {
    const again = f.side == 16;
    const cells = map(iota(f.cells.length), (i) => again && i == k % f.cells.length ? f.cells[i] + 1.0 : f.cells[i]);
    return { side: f.side, cells: cells, count: f.count + 1 };
}

// the state made anew as the first component of a tuple
@noInline
function paired(a: App, k: i64): [App, i64[]] {
    return [{ ...a, vm: set(a.vm, k, 3.0) }, []] as const;
}

// the rows of the state (each its own size of arguments)
function rowsOf(): Row[] {
    const one: Row = { name: "x", args: [1.0, 2.0] };
    const two: Row = { name: "y", args: [3.0] };
    return [one, two];
}

action rounds(a: App, f: Frame, k: i64): [App, Frame] {
    if (k == 0) {
        return [a, f] as const;
    }
    const [a1, none] = paired(edited(guarded(a, k), k), k);
    return rounds(a1, redrawn(f, k), k - 1);
}

action main(args: string[k]): i32 {
    const n = parseI64(args[0]);
    const r = parseI64(args[1]);
    const a = { vm: { heap: fill(n, 0.0), n: 3 }, rows: rowsOf(), ran: false, tag: "" };
    const f = { side: 16, cells: fill(1000, 0.0), count: 0 };
    const [a1, f1] = rounds(a, f, r);
    print([i64(reduce(a1.vm.heap, (x, y) => x + y, 0.0)), a1.tag, i64(reduce(f1.cells, (x, y) => x + y, 0.0)), f1.count] as const);
    return 0;
}
