// A machine of registers whose state, a record of arrays, is given from
// function to function in a cycle (`run`, `enter`, `lib`, `run` again), as
// the machine of Lua of isocron-ui (D659). Each array updated in place:
// an element of a part read by another component of the new state
// (`LOADK`), an argument of a function inlined read after its first one
// (`LOOP`), an element of the state read by the arguments of a call after
// the state itself (`CALL`), texts of the state compared beside it
// (`LESS`), the state made anew at each step of a `fold` (`BUMP`).
type Vm = { code: i64[], kT: i64[], kI: i64[], rT: i64[], rI: i64[], strs: string[], pc: i64, base: i64, depth: i64, acc: i64 };

function ins(op: i64, a: i64, b: i64, c: i64): i64 {
    return op + a * 256 + b * 65536 + c * 16777216;
}

function setReg(vm: Vm, r: i64, t: i64, i: i64): Vm {
    return { ...vm, rT: vm.rT.with(r, t), rI: vm.rI.with(r, i) };
}

// the loop of the register `a`: back by `back` while below the limit in
// the register `lim`
function loopStep(vm: Vm, a: i64, back: i64, lim: i64): Vm {
    const i = vm.rI[a] + 1;
    return i < vm.rI[lim] ? { ...setReg(vm, a, 3, i), pc: vm.pc + back } : vm;
}

// the functions of the library: 1 runs the code from 20 (a call back into
// the machine), 2 doubles its argument and adds it to `acc`
function lib(vm: Vm, id: i64, x: i64): [Vm, i64] {
    if (id == 1) {
        const pc = vm.pc;
        const v1 = run({ ...vm, pc: 20, depth: vm.depth + 1 }, vm.depth + 1);
        return [{ ...v1, pc: pc }, v1.acc % 1000];
    }
    return [{ ...vm, acc: vm.acc + x }, x * 2];
}

function enter(vm: Vm, a: i64): Vm {
    if (vm.rT[a] == 9) {
        const [v1, r] = lib(vm, vm.rI[a], vm.rI[a + 1]);
        return setReg(v1, a, 3, r);
    }
    return vm;
}

function less(vm: Vm, x: i64, y: i64): [Vm, boolean] {
    if (x == y) {
        return [vm, false];
    }
    const s = vm.strs[x];
    const u = vm.strs[y];
    return [vm, s < u];
}

function run(vm: Vm, stop: i64): Vm {
    if (vm.depth < stop) {
        return vm;
    }
    const pc = vm.pc;
    const word = vm.code[pc];
    const op = word & 255;
    const ra = vm.base + ((word >> 8) & 255);
    const b = (word >> 16) & 255;
    const c = (word >> 24) & 255;
    const next = pc + 1;
    return match (op) {
        0 => run({ ...vm, rT: vm.rT.with(ra, vm.kT[b]), rI: vm.rI.with(ra, vm.kI[b]), pc: next }, stop),
        1 => run({ ...setReg(vm, ra, 3, vm.rI[vm.base + b] + vm.rI[vm.base + c]), pc: next }, stop),
        2 => run(loopStep({ ...vm, pc: next }, ra, b - 128, vm.base + c), stop),
        3 => run(enter({ ...vm, pc: next }, ra), stop),
        4 => {
            const [v1, lt] = less(vm, vm.rI[vm.base + b], vm.rI[vm.base + c]);
            return run({ ...setReg(v1, ra, 3, lt ? 1 : 0), pc: next }, stop);
        },
        5 => run({ ...fold(iota(b), vm, (acc, i) => ({ ...acc, rI: acc.rI.with(ra + i, acc.rI[ra + i] + 1) })), pc: next }, stop),
        6 => ({ ...vm, depth: vm.depth - 1 }),
        _ => vm,
    };
}

action main(args: string[k]): i32 {
    const n = parseI64(args[0]);
    const code = [
        ins(0, 0, 0, 0), ins(0, 1, 1, 0), ins(0, 7, 4, 0), ins(0, 8, 5, 0), ins(0, 2, 2, 0),
        ins(1, 3, 0, 0), ins(3, 2, 0, 0), ins(1, 4, 4, 2), ins(0, 2, 2, 0), ins(4, 5, 7, 8),
        ins(5, 9, 3, 0), ins(2, 0, 121, 1), ins(0, 2, 3, 0), ins(3, 2, 0, 0), ins(7, 0, 0, 0),
        ins(7, 0, 0, 0), ins(7, 0, 0, 0), ins(7, 0, 0, 0), ins(7, 0, 0, 0), ins(7, 0, 0, 0),
        ins(1, 12, 12, 1), ins(6, 0, 0, 0),
    ];
    // (registers enough for a copy of them at each step to show)
    const vm = {
        code: code, kT: [3, 3, 9, 9, 3, 3], kI: [0, n, 2, 1, 0, 1], rT: fill(65536, 0), rI: fill(65536, 0),
        strs: ["apple", "banana"], pc: 0, base: 0, depth: 0, acc: 0,
    };
    const end = run(vm, 0);
    print([end.rI[2], end.rI[4], end.rI[5], end.rI[9], end.rI[10], end.rI[11], end.rI[12], end.acc, end.depth, end.pc]);
    return 0;
}
