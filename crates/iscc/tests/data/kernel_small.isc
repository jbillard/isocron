// The test of the small blocks of the prelude on one thread (D602).

// the bytes asked for the block `i`
function wanted(i: i64): i64 {
    return 1 + (i * 37) % 1024;
}

// the bytes of the class of the block `i`
function held(i: i64): i64 {
    return (wanted(i) + 63) / 64 * 64;
}

// the blocks of `ps` (those of the requests `first`, `first + step`, ...)
// are on 64 bytes and none is over another: in the order of their
// addresses, each ends before the header of the next
function apart(ps: u64[n], first: i64, step: i64): i64 {
    const order = sortBy(iota(n), (i) => ps[i]);
    const ok = count(iota(n - 1), (j) => ps[order[j]] + u64(held(first + step * order[j])) + 64u64 <= ps[order[j + 1]]);
    return count(ps, (p) => p % 64u64 == 0u64) == n && ok == n - 1 ? 1 : 0;
}

action main(args: string[k]): i32 {
    const base = $kStart();
    print(base != 0u64 ? 1 : 0);
    const n = 3000;
    // n blocks, each marked at the first and the last 8 bytes of its class
    const ps = map(iota(n), (i) => {
        const p = $kAlloc(wanted(i));
        $store64(p, u64(i));
        $store64(p + u64(held(i) - 8), u64(i * 7 + 1));
        return p;
    });
    print(apart(ps, 0, 1));
    const whole = map(iota(n), (i) => $load64(ps[i]) == u64(i) && $load64(ps[i] + u64(held(i) - 8)) == u64(i * 7 + 1) ? 1 : 0);
    print(sum(whole));
    // every other block freed, then the same requests again: nothing new
    // is cut, and the blocks in use (those kept, those taken again) are
    // apart
    const cut = $load64(base);
    const freed = map(iota(n / 2), (i) => $kFree(ps[2 * i]));
    const again = map(iota(n / 2), (i) => $kAlloc(wanted(2 * i)));
    const live = map(iota(n), (i) => i % 2 == 0 ? again[i / 2] : ps[i]);
    print([apart(live, 0, 1), $load64(base) == cut ? 1 : 0]);
    // the blocks kept were not touched
    const kept = map(iota(n / 2), (i) => $load64(ps[2 * i + 1]) == u64(2 * i + 1) ? 1 : 0);
    print(sum(kept));
    // everything freed, then every request again: nothing new is cut, the
    // blocks apart as the first time
    const f1 = map(iota(n / 2), (i) => $kFree(again[i]));
    const f2 = map(iota(n / 2), (i) => $kFree(ps[2 * i + 1]));
    const qs = map(iota(n), (i) => $kAlloc(wanted(i)));
    print([apart(qs, 0, 1), $load64(base) == cut ? 1 : 0]);
    // a block freed twice: a panic
    const f3 = $kFree(qs[0]);
    print(sum(freed) + sum(f1) + sum(f2) + f3 >= 0 ? 1 : 0);
    const f4 = $kFree(qs[0]);
    print(f4);
    return 0;
}
