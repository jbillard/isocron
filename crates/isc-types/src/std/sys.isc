// The module `sys` of the standard library (SPEC section 18, D322): the
// environment of the program, its folders and files, over the primitives
// `sys*` of the runtime. Every action that can fail for a reason outside
// the program returns a `Result` with an `IoError` (D323).

// An error of the system: its kind and what it is about (a path); `Tls`:
// a fault of TLS, its text saying which (a certificate not trusted, a name
// that is not the server's, the handshake, no library of TLS, D343)
export type IoError = NotFound(string) | PermissionDenied(string) | AlreadyExists(string) | NotEmpty(string) | Refused(string) | TimedOut(string) | Tls(string) | Other(i64, string);

// the error of the code `code` of a primitive (1 to 6 its kinds, below 0
// the error of the system negated) about `what` (the other modules of the
// system give theirs by it: `net`)
export function ioError(code: i64, what: string): IoError {
    if (code == 1) {
        return NotFound(what);
    }
    if (code == 2) {
        return PermissionDenied(what);
    }
    if (code == 3) {
        return AlreadyExists(what);
    }
    if (code == 4) {
        return NotEmpty(what);
    }
    if (code == 5) {
        return Refused(what);
    }
    if (code == 6) {
        return TimedOut(what);
    }
    if (code == 20 || code == 21) {
        return Tls(what);
    }
    return Other(-code, what);
}

// the text of an error, the same on every target for the first six kinds
export function message(e: IoError): string {
    return match (e) {
        NotFound(w) => `not found: ${w}`,
        PermissionDenied(w) => `permission denied: ${w}`,
        AlreadyExists(w) => `already exists: ${w}`,
        NotEmpty(w) => `not empty: ${w}`,
        Refused(w) => `refused: ${w}`,
        TimedOut(w) => `timed out: ${w}`,
        Tls(w) => `tls: ${w}`,
        Other(c, w) => `error ${c} of the system: ${w}`,
    };
}

// nothing, or the error of `code` about `what`
function done(code: i64, what: string): Result<void, IoError> {
    return code == 0 ? Ok(()) : Err(ioError(code, what));
}

// the variable `name` of the environment
export action env(name: string): Option<string> {
    const [value, found] = sysGetenv(name);
    if (found == 0) {
        return None;
    } else {
        return Some(value);
    }
}

// every variable of the environment, [name, value], in the order of the
// bytes of their names
export action envAll(): [string, string][k] {
    const all = sysEnviron();
    return map(all, (e) => {
        const i = e.indexOf("=");
        return i < 0 ? [e, ""] as const : [e.slice(0, i), e.slice(i + 1, e.length)] as const;
    });
}

// the folder of the program
export action cwd(): Result<string, IoError> {
    const [path, code] = sysCwd();
    return code == 0 ? Ok(path) : Err(ioError(code, "."));
}

// a file or a folder is at `path`
export action exists(path: string): boolean {
    const [kind, count, at, code] = sysStat(path);
    return code == 0;
}

export action isFile(path: string): boolean {
    const [kind, count, at, code] = sysStat(path);
    return code == 0 && kind == 1;
}

export action isDir(path: string): boolean {
    const [kind, count, at, code] = sysStat(path);
    return code == 0 && kind == 2;
}

// the bytes of the file at `path`
export action fileSize(path: string): Result<i64, IoError> {
    const [kind, count, at, code] = sysStat(path);
    return code == 0 ? Ok(count) : Err(ioError(code, path));
}

// the time of the last change of `path`, in nanoseconds since 1970 (UTC)
export action modified(path: string): Result<i64, IoError> {
    const [kind, count, at, code] = sysStat(path);
    return code == 0 ? Ok(at) : Err(ioError(code, path));
}

// the names in the folder `path`, without `.` and `..`, in the order of
// their bytes
export action listDir(path: string): Result<string[k], IoError> {
    const [names, code] = sysReadDir(path);
    return code == 0 ? Ok(names) : Err(ioError(code, path));
}

// a new folder
export action makeDir(path: string): Result<void, IoError> {
    return done(sysMkdir(path), path);
}

// the folders of the first `i` parts of `parts`, then the others
action makeFrom(parts: string[n], i: i64): Result<void, IoError> {
    if (i > parts.length) {
        return Ok(());
    }
    const path = join(parts.slice(0, i), "/");
    const code = path == "" ? 0 : sysMkdir(path);
    if (code != 0 && !(code == 3 && isDir(path))) {
        return Err(ioError(code, path));
    }
    return makeFrom(parts, i + 1);
}

// the folder `path` and the folders above it that are not there; nothing
// when it is there
export action makeDirs(path: string): Result<void, IoError> {
    return makeFrom(path.split("/"), 1);
}

// the file, or the empty folder, at `path`
export action remove(path: string): Result<void, IoError> {
    return isDir(path) ? done(sysRemoveDir(path), path) : done(sysRemoveFile(path), path);
}

// the entries `names` of the folder `path` from the `i`-th removed with all
// they hold
action removeEntries(path: string, names: string[n], i: i64): Result<void, IoError> {
    if (i >= names.length) {
        return Ok(());
    }
    const r = removeAll(`${path}/${names[i]}`);
    return match (r) {
        Ok(_) => removeEntries(path, names, i + 1),
        Err(e) => Err(e),
    };
}

// the file at `path`, or the folder and everything in it (a link is
// removed, not followed)
export action removeAll(path: string): Result<void, IoError> {
    if (!isDir(path)) {
        return remove(path);
    }
    return match (listDir(path)) {
        Ok(names) => match (removeEntries(path, names, 0)) {
            Ok(_) => done(sysRemoveDir(path), path),
            Err(e) => Err(e),
        },
        Err(e) => Err(e),
    };
}

// the file or folder `from` now at `to`
export action rename(from: string, to: string): Result<void, IoError> {
    return done(sysRename(from, to), from);
}

// the bytes of the file at `path`
export action readFile(path: string): Result<u8[k], IoError> {
    const [bytes, code] = sysReadFile(path);
    return code == 0 ? Ok(bytes) : Err(ioError(code, path));
}

// the bytes of `b` are UTF-8 as the runtime takes them (D451): each
// character a lead byte then the continuations it wants, the first in the
// range its lead allows (no overlong form, no surrogate, nothing above
// U+10FFFF). The state of the fold: -1 (not UTF-8), 0 (between
// characters), or the continuations still wanted times 65536 plus the
// range of the next one (its lowest byte times 256 plus its highest).
function utf8(b: u8[n]): boolean {
    const left = fold(b, 0, (s, x) => {
        if (s < 0) {
            return -1;
        }
        const c = i64(x);
        if (s > 0) {
            const want = s / 65536;
            const fits = c >= (s / 256) % 256 && c <= s % 256;
            return fits ? (want == 1 ? 0 : (want - 1) * 65536 + 0x80BF) : -1;
        }
        if (c < 0x80) {
            return 0;
        }
        if (c >= 0xC2 && c <= 0xDF) {
            return 65536 + 0x80BF;
        }
        if (c >= 0xE0 && c <= 0xEF) {
            return 2 * 65536 + (c == 0xE0 ? 0xA0BF : (c == 0xED ? 0x809F : 0x80BF));
        }
        if (c >= 0xF0 && c <= 0xF4) {
            return 3 * 65536 + (c == 0xF0 ? 0x90BF : (c == 0xF4 ? 0x808F : 0x80BF));
        }
        return -1;
    });
    return left == 0;
}

// the text of the file at `path` (UTF-8: otherwise an error)
export action readText(path: string): Result<string, IoError> {
    const [bytes, code] = sysReadFile(path);
    if (code != 0) {
        return Err(ioError(code, path));
    }
    if (!utf8(bytes)) {
        return Err(Other(0, `${path}: not UTF-8`));
    }
    return Ok(stringOf(bytes));
}

// the file at `path` made or emptied, then `x` written into it
export action writeFile(path: string, x: u8[n]): Result<void, IoError> {
    return done(sysWriteFile(path, x, false), path);
}

// `x` written at the end of the file at `path`, made if it is not there
export action appendFile(path: string, x: u8[n]): Result<void, IoError> {
    return done(sysWriteFile(path, x, true), path);
}

export action writeText(path: string, s: string): Result<void, IoError> {
    return done(sysWriteFile(path, bytes(s), false), path);
}

export action appendText(path: string, s: string): Result<void, IoError> {
    return done(sysWriteFile(path, bytes(s), true), path);
}
