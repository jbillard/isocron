// The module `win32` of the standard library (D636): Windows only (a
// program for Linux or WebAssembly that reaches it is refused at compile
// time, D324, unless it reaches it in a branch for Windows, D635). A window
// of Windows, the events it receives, the image it shows: what a library of
// interfaces needs of the system. Its primitives are calls of `user32` and
// `gdi32` made by the compiled program itself; the procedure of the window
// is written by the compiler and queues the events, read by `events`. A
// `Window` is unique as a `Conn` (D339): closed once by `close`.
import { IoError, ioError } from "sys";

export type Window = sysWindow;

// what happened to a window: closing asked (the window stays until
// `close`); its inside resized; the pointer at (x, y) of its inside; a
// button (0 left, 1 right, 2 middle) pressed or released, at the place of
// the pointer just before; the wheel turned (120 a notch, forwards
// positive); a key (its virtual code, pressed or released, its scan code);
// a character typed (a unit of UTF-16); a part of the window to draw
// again; its dots per inch (96: a scale of 1); the focus taken or lost;
// the wheel turned across (a tilt of the wheel, two fingers on a touchpad:
// 120 a notch, right positive, D674)
export type Event = Close | Resize(i64, i64) | Pointer(i64, i64) | Button(i64, boolean) | Wheel(i64) | Key(i64, boolean, i64) | Char(i64) | Paint | Dpi(i64) | Focus(boolean) | HWheel(i64) | Unknown(i64);

// a window titled `title` whose inside has `width` by `height` units of 96
// dots per inch (pixels at 100 %; 1.5 pixel each at 150 %, D649), shown:
// resized by its edges, its buttons that minimize and maximize it there
export action open(title: string, width: i64, height: i64): Result<Window, IoError> {
    return openWith(title, width, height, true, true, true);
}

// `open`, the window resized by its edges or of a fixed size (`resizable`),
// with its button that minimizes it or not, with its button that maximizes
// it or not (a window of a fixed size has none, D669)
export action openWith(title: string, width: i64, height: i64, resizable: boolean, minimizable: boolean, maximizable: boolean): Result<Window, IoError> {
    return opened(title, width, height, (resizable ? 1 : 0) | (minimizable ? 2 : 0) | (maximizable ? 4 : 0));
}

// `openWith`, the title of the window drawn by the program in its inside
// (D670): no title of Windows above it, its edges kept (they resize it, the
// top too); the program tells which areas of its inside move the window
// (`setCaption`) and moves it itself (`command`: its buttons)
export action openDrawn(title: string, width: i64, height: i64, resizable: boolean, minimizable: boolean, maximizable: boolean): Result<Window, IoError> {
    return opened(title, width, height, (resizable ? 1 : 0) | (minimizable ? 2 : 0) | (maximizable ? 4 : 0) | 8);
}

action opened(title: string, width: i64, height: i64, options: i64): Result<Window, IoError> {
    const [w, code] = sysWinOpen(title, width, height, options);
    if (code == 0) {
        return Ok(w);
    }
    sysWinClose(w);
    return Err(ioError(code, title));
}

// the event of the four words from `at`
function eventAt(x: i64[n], at: i64): Event {
    const k = x[at];
    const a = x[at + 1];
    const b = x[at + 2];
    return k == 1 ? Close
        : (k == 2 ? Resize(a, b)
        : (k == 3 ? Pointer(a, b)
        : (k == 4 ? Button(a, b != 0)
        : (k == 5 ? Wheel(a)
        : (k == 6 ? Key(a, b != 0, x[at + 3])
        : (k == 7 ? Char(a)
        : (k == 8 ? Paint
        : (k == 9 ? Dpi(a)
        : (k == 10 ? Focus(a != 0)
        : (k == 11 ? HWheel(a) : Unknown(k)))))))))));
}

// the events of `w` since the last call, in their order; when there are
// none, waiting for one at most `ms` milliseconds (-1: without limit)
export action events(w: Window, ms: i64): Result<Event[], IoError> {
    const [words, code] = sysWinEvents(w, ms);
    if (code != 0) {
        return Err(ioError(code, "events"));
    }
    return Ok(map(iota(words.length / 4), (i) => eventAt(words, 4 * i)));
}

// the `width` by `height` pixels `px` (`0xAARRGGBB`, rows from the top)
// shown at the top left of the inside of `w`
export action show(w: Window, px: u32[n], width: i64, height: i64): Result<void, IoError> {
    const code = sysWinShow(w, px, width, height);
    return code == 0 ? Ok(()) : Err(ioError(code, "show"));
}

// the size of the inside of `w`: [width, height]
export action clientSize(w: Window): [i64, i64] {
    return sysWinSize(w);
}

// the message `message` of Windows put in the queue of `w` with its two
// numbers (`PostMessageW`): what wakes a loop, or plays an input in a test
export action post(w: Window, message: i64, wparam: i64, lparam: i64): Result<void, IoError> {
    const code = sysWinPost(w, message, wparam, lparam);
    return code == 0 ? Ok(()) : Err(ioError(code, "post"));
}

// what the inside of `w` shows: its pixels, `0xAARRGGBB`, rows from the
// top, its size that of `clientSize(w)`
export action capture(w: Window): Result<u32[], IoError> {
    const [px, code] = sysWinCapture(w);
    return code == 0 ? Ok(px) : Err(ioError(code, "capture"));
}

// the areas of the inside of a window whose title the program draws
// (`openDrawn`), in pixels: those that move it when dragged (`moves`: a
// title, a free part of its bar) and those that are the program's (`keeps`:
// its buttons, its menus within them); a point is the last area's holding
// it, `moves` before `keeps`; 256 areas at most (D670). Four numbers each:
// x, y, width, height.
export action setCaption(w: Window, moves: i64[n], keeps: i64[m]): void {
    const words = concat(map(iota(n / 4 * 5), (k) => k % 5 == 4 ? 1 : moves[k / 5 * 4 + k % 5]), map(iota(m / 4 * 5), (k) => k % 5 == 4 ? 0 : keeps[k / 5 * 4 + k % 5]));
    const code = sysWinCaption(w, words);
}

// the window minimized, as by its button (D670)
export action minimize(w: Window): void {
    const code = sysWinCommand(w, 0);
}

// the window maximized, or restored when it is (D670)
export action toggleMaximized(w: Window): void {
    const code = sysWinCommand(w, sysWinZoomed(w) != 0 ? 2 : 1);
}

// whether the window is maximized (D670)
export action maximized(w: Window): boolean {
    return sysWinZoomed(w) != 0;
}

// the window closed: it cannot be used after
// a box of messages of Windows titled `title` showing `text`, with its
// button OK, in front of the other windows; returns when it is closed (D643:
// what a program without a console shows of a failure)
export action alert(title: string, text: string): void {
    const shown = sysWinAlert(title, text);
}

// the path of the file of the program running (D643: the folder of its
// files beside it, whatever the current folder)
export action programPath(): Result<string, IoError> {
    const [b, code] = sysWinProgram();
    return code == 0 ? Ok(stringOf(b)) : Err(ioError(code, "program"));
}

// the density of the screen of `w`, in dots per inch (96: 100 %, 120:
// 125 %, 144: 150 %; D649). A window is opened at the density of the
// system: its inside `width` by `height` units of 96 dots per inch;
// `Dpi(d)` comes when it moves to a screen of another density, the window
// resized by Windows (`Resize`)
export action dpi(w: Window): i64 {
    return sysWinDpi(w);
}

// the shape of the pointer over the inside of `w`: 0 an arrow, 1 a hand, 2
// a bar of text (D646: the cursors of the system, set at once when the
// pointer is over the window)
export action setCursor(w: Window, shape: i64): void {
    const set = sysWinCursor(w, shape);
}

// `text` put on the clipboard of the system (as Unicode), `w` its owner
// (D646)
export action clipboardSet(w: Window, text: string): Result<void, IoError> {
    const code = sysWinClipSet(w, text);
    return code == 0 ? Ok(()) : Err(ioError(code, "clipboard"));
}

// the text on the clipboard of the system ("" for none, D646)
export action clipboardGet(w: Window): Result<string, IoError> {
    const [b, code] = sysWinClipGet(w);
    return code == 0 ? Ok(stringOf(b)) : Err(ioError(code, "clipboard"));
}

export action close(w: Window): void {
    const code = sysWinClose(w);
}
