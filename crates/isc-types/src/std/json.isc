// The module `json` of the standard library (SPEC section 18, D335, D336):
// JSON (RFC 8259) read and written in Isocron. The text is indexed first,
// in passes over its bytes and no loop: a `scan` tells the bytes inside a
// string (a state 0 outside, 1 inside, 2 after a backslash), another the
// depth of the brackets outside strings; an opening and its closing have
// the same level and follow each other in the order (level, place), so
// that one sort pairs them; the commas of a container are a run of the
// commas in that order, found by halving. A value is then checked, its
// faults found with their path, and built, which cannot fail: the elements
// of each container by a `map`, in parallel.

export type Json = Null | Bool(boolean) | Num(f64) | Str(string) | Arr(Json[k]) | Obj(string[m], Json[m]);

// an error: its line and column (from 1) and what it is
export type JsonError = { line: i64, column: i64, message: string };

// the index of a text (D337): after each byte, the depth of the brackets
// outside strings and the state of the strings (0 outside, 1 inside, 2
// after a backslash), as `4 * depth + state`, by one pass of `scan`; the
// closing of a container and the commas of an array are found from it
// where they are read
type Index = Ix(i32[s1]);

function ixPacked(ix: Index): i32[k] {
    return match (ix) {
        Ix(p) => p,
    };
}

// the state before the byte `i`
function stateBefore(packed: i32[k], i: i64): i32 {
    return i == 0 ? 0i32 : packed[i - 1] & 3i32;
}

// the error at the byte `at` of `b`
function errorAt(b: u8[n], at: i64, message: string): JsonError {
    const lines = count(iota(Math.min(at, b.length)), (i) => b[i] == 10u8);
    const lineStart = fold(iota(Math.min(at, b.length)), -1, (s, i) => b[i] == 10u8 ? i : s);
    return { line: lines + 1, column: at - lineStart, message: message };
}

function isSpace(c: u8): boolean {
    return c == 32u8 || c == 9u8 || c == 10u8 || c == 13u8;
}

// the first place from `at` that is not a space
function skip(b: u8[n], at: i64): i64 {
    return at < b.length && isSpace(b[at]) ? skip(b, at + 1) : at;
}

// the bytes of `b` are UTF-8 as the runtime takes them (D451): each
// character a lead byte then the continuations it wants, the first in the
// range its lead allows (no overlong form, no surrogate, nothing above
// U+10FFFF). The state of the fold: -1 (not UTF-8), 0 (between
// characters), or the continuations still wanted times 65536 plus the
// range of the next one (its lowest byte times 256 plus its highest).
function utf8(b: u8[n]): boolean {
    return fold(b, 0, (s, x) => {
        if (s < 0) {
            return -1;
        }
        const c = i64(x);
        if (s > 0) {
            const want = s / 65536;
            const fits = c >= (s / 256) % 256 && c <= s % 256;
            return fits ? (want == 1 ? 0 : (want - 1) * 65536 + 0x80BF) : -1;
        }
        if (c < 0x80) {
            return 0;
        }
        if (c >= 0xC2 && c <= 0xDF) {
            return 65536 + 0x80BF;
        }
        if (c >= 0xE0 && c <= 0xEF) {
            return 2 * 65536 + (c == 0xE0 ? 0xA0BF : (c == 0xED ? 0x809F : 0x80BF));
        }
        if (c >= 0xF0 && c <= 0xF4) {
            return 3 * 65536 + (c == 0xF0 ? 0x90BF : (c == 0xF4 ? 0x808F : 0x80BF));
        }
        return -1;
    }) == 0;
}

// the value of the hexadecimal digit `c`, or -1
function hexDigit(c: u8): i64 {
    if (c >= 48u8 && c <= 57u8) {
        return i64(c - 48u8);
    }
    if (c >= 97u8 && c <= 102u8) {
        return i64(c - 87u8);
    }
    if (c >= 65u8 && c <= 70u8) {
        return i64(c - 55u8);
    }
    return -1;
}

// the four hexadecimal digits at `at`, or -1
function hex4(b: u8[n], at: i64): i64 {
    if (at + 4 > b.length) {
        return -1;
    }
    return fold(iota(4), 0, (v, j) => v < 0 || hexDigit(b[at + j]) < 0 ? -1 : v * 16 + hexDigit(b[at + j]));
}

// the code point `u` in UTF-8
function utf8Of(u: i64): string {
    if (u < 0x80) {
        return stringOf([u8(u)]);
    }
    if (u < 0x800) {
        return stringOf([u8(0xC0 | (u >> 6)), u8(0x80 | (u & 0x3F))]);
    }
    if (u < 0x10000) {
        return stringOf([u8(0xE0 | (u >> 12)), u8(0x80 | ((u >> 6) & 0x3F)), u8(0x80 | (u & 0x3F))]);
    }
    return stringOf([u8(0xF0 | (u >> 18)), u8(0x80 | ((u >> 12) & 0x3F)), u8(0x80 | ((u >> 6) & 0x3F)), u8(0x80 | (u & 0x3F))]);
}

// the escapes of the string whose bytes are from `a` to `z`: the places of
// their backslashes (a backslash not itself escaped, by the index)
function escapesIn(b: u8[n], ix: Index, a: i64, z: i64): i64[k] {
    const packed = ixPacked(ix);
    return map(filter(iota(z - a), (j) => b[a + j] == 92u8 && stateBefore(packed, a + j) == 1i32), (j) => a + j);
}

// the code of the escape \u at `p` that is a high surrogate followed by its
// low one, or -1
function pairAt(b: u8[n], p: i64, z: i64): i64 {
    const u = hex4(b, p + 2);
    if (u < 0xD800 || u >= 0xDC00 || p + 12 > z || b[p + 6] != 92u8 || b[p + 7] != 117u8) {
        return -1;
    }
    const low = hex4(b, p + 8);
    return low >= 0xDC00 && low < 0xE000 ? 0x10000 + ((u - 0xD800) << 10) + (low - 0xDC00) : -1;
}

// the escape at `ps[i]` is the low surrogate of the escape before it
function consumed(b: u8[n], ps: i64[k], i: i64, z: i64): boolean {
    return i > 0 && ps[i - 1] + 6 == ps[i] && b[ps[i - 1] + 1] == 117u8 && pairAt(b, ps[i - 1], z) >= 0;
}

// the fault of the escape at `p` (the `i`-th of `ps`), or -1
function escapeFault(b: u8[n], ps: i64[k], i: i64, z: i64): [i64, string] {
    const p = ps[i];
    const c = b[p + 1];
    if (c == 117u8) {
        const u = hex4(b, p + 2);
        if (u < 0 || p + 6 > z) {
            return [p, ": an escape \\u without four hexadecimal digits"] as const;
        }
        if (u >= 0xD800 && u < 0xDC00 && pairAt(b, p, z) < 0) {
            return [p, ": a high surrogate without its low one"] as const;
        }
        if (u >= 0xDC00 && u < 0xE000 && !consumed(b, ps, i, z)) {
            return [p, ": a low surrogate alone"] as const;
        }
        return fine();
    }
    return c == 34u8 || c == 92u8 || c == 47u8 || c == 98u8 || c == 102u8 || c == 110u8 || c == 114u8 || c == 116u8 ? fine() : [p, ": an unknown escape"] as const;
}

// the bytes that the escape at `ps[i]` takes
function escapeLength(b: u8[n], ps: i64[k], i: i64, z: i64): i64 {
    const p = ps[i];
    if (b[p + 1] != 117u8) {
        return 2;
    }
    return pairAt(b, p, z) >= 0 ? 12 : 6;
}

// the text of the escape at `ps[i]`
function escapeText(b: u8[n], ps: i64[k], i: i64, z: i64): string {
    const p = ps[i];
    const c = b[p + 1];
    if (c == 117u8) {
        if (consumed(b, ps, i, z)) {
            return "";
        }
        const pair = pairAt(b, p, z);
        return utf8Of(pair >= 0 ? pair : hex4(b, p + 2));
    }
    return c == 34u8 ? "\"" : (c == 92u8 ? "\\" : (c == 47u8 ? "/" : (c == 98u8 ? stringOf([8u8]) : (c == 102u8 ? stringOf([12u8]) : (c == 110u8 ? "\n" : (c == 114u8 ? "\r" : "\t"))))));
}

// the string that opens at `at` (a quote), its escapes read, and the place
// after it; or the place of its fault and what it is
function stringAt(b: u8[n], text: string, ix: Index, at: i64): Result<[string, i64], [i64, string]> {
    const z = stringEnd(b, ix, at + 1);
    if (z < 0) {
        return Err([at, ": a string without its end"] as const);
    }
    const a = at + 1;
    const controls = filter(iota(z - a), (j) => b[a + j] < 32u8);
    if (controls.length > 0) {
        return Err([a + controls[0], ": a control character in a string"] as const);
    }
    const ps = escapesIn(b, ix, a, z);
    if (ps.length == 0) {
        return Ok([text.slice(a, z), z + 1] as const);
    }
    const faults = map(iota(ps.length), (i) => escapeFault(b, ps, i, z));
    const bad = filter(iota(ps.length), (i) => {
        const [p, why] = faults[i];
        return p >= 0;
    });
    if (bad.length > 0) {
        return Err(faults[bad[0]]);
    }
    // each escape after the text before it (an escape taken by the one
    // before it: nothing)
    const ends = map(iota(ps.length), (i) => consumed(b, ps, i, z) ? ps[i] + 6 : ps[i] + escapeLength(b, ps, i, z));
    const pieces = map(iota(ps.length), (i) => consumed(b, ps, i, z) ? "" : text.slice(i == 0 ? a : ends[i - 1], ps[i]) + escapeText(b, ps, i, z));
    return Ok([join(pieces, "") + text.slice(ends[ps.length - 1], z), z + 1] as const);
}

// the digits from `at` (at least one when `one`): the place after them
function digitsEnd(b: u8[n], at: i64, end: i64): i64 {
    return at < end && b[at] >= 48u8 && b[at] <= 57u8 ? digitsEnd(b, at + 1, end) : at;
}

// the bytes from `at` to `end` are a number of JSON:
// -?(0|[1-9][0-9]*)(.[0-9]+)?([eE][+-]?[0-9]+)?
function numberOk(b: u8[n], at: i64, end: i64): boolean {
    const s = at < end && b[at] == 45u8 ? at + 1 : at;
    if (s >= end || b[s] < 48u8 || b[s] > 57u8) {
        return false;
    }
    const i = b[s] == 48u8 ? s + 1 : digitsEnd(b, s, end);
    const f = i < end && b[i] == 46u8 ? digitsEnd(b, i + 1, end) : i;
    if (f == i + 1) {
        return false;
    }
    if (f == end) {
        return true;
    }
    if (b[f] != 101u8 && b[f] != 69u8) {
        return false;
    }
    const sg = f + 1 < end && (b[f + 1] == 43u8 || b[f + 1] == 45u8) ? f + 2 : f + 1;
    const e = digitsEnd(b, sg, end);
    return e > sg && e == end;
}

// the index of a text `b`
function indexed(b: u8[n]): Index {
    return Ix(scan(map(b, (c) => i32(c)), (s, c) => {
        const st = s & 3i32;
        if (st == 0i32) {
            return c == 34i32 ? s + 1i32 : (c == 91i32 || c == 123i32 ? s + 4i32 : (c == 93i32 || c == 125i32 ? s - 4i32 : s));
        }
        return st == 1i32 ? (c == 92i32 ? s + 1i32 : (c == 34i32 ? s - 1i32 : s)) : s - 1i32;
    }, 0i32));
}

// the JSON value of `text`
export function parse(text: string): Result<Json, JsonError> {
    const b = bytes(text);
    const ix = indexed(b);
    const [tat, twhy] = checkText(b, ix);
    if (tat >= 0) {
        return Err(errorAt(b, tat, twhy));
    }
    const [end, at, why] = anyAt(b, text, ix, 0);
    if (at >= 0) {
        return Err(errorAt(b, at, "$" + why));
    }
    const after = skip(b, end);
    if (after != b.length) {
        return Err(errorAt(b, after, "$: text after the value"));
    }
    return Ok(buildAny(b, text, ix, 0));
}

// an object of the keys `ks` and the values `vs` (their sizes tested equal
// where it is called)
function objectOf(ks: string[m], vs: Json[m]): Json {
    return Obj(ks, vs);
}

// the value at `at`, checked: the elements of a container built in
// parallel, by `map`, from the places of its elements
function buildAny(b: u8[n], text: string, ix: Index, at: i64): Json {
    const a = skip(b, at);
    const c = b[a];
    if (c == 34u8) {
        const [v, e] = stringValueAt(b, text, ix, a);
        return Str(v);
    }
    if (c == 91u8) {
        const [ss, es] = elements(b, ix, a, closingOf(b, ix, a));
        return Arr(map(iota(ss.length), (j) => buildAny(b, text, ix, ss[j])));
    }
    if (c == 123u8) {
        const [ss, es] = elements(b, ix, a, closingOf(b, ix, a));
        const keys = map(iota(ss.length), (j) => {
            const [ka, kz, v, kp, kwhy] = keyAt(b, ix, ss[j]);
            return keyText(b, text, ix, ka, kz);
        });
        return objectOf(keys, map(iota(ss.length), (j) => {
            const [ka, kz, v, kp, kwhy] = keyAt(b, ix, ss[j]);
            return buildAny(b, text, ix, v);
        }));
    }
    if (c == 116u8) {
        return Bool(true);
    }
    if (c == 102u8) {
        return Bool(false);
    }
    if (c == 110u8) {
        return Null;
    }
    const [x, e] = numberValueAt(b, text, a);
    return Num(x);
}

// the text of `e`: `line L, column C: message`
export function message(e: JsonError): string {
    return `line ${e.line}, column ${e.column}: ${e.message}`;
}

// `s` as a string of JSON, between quotes
export function quote(s: string): string {
    // its bytes tested by masks (D396), one text made (D397: 9.4 times its
    // floor, two concatenations)
    const b = bytes(s);
    if (count(b, (c) => c < 32u8 || c == 34u8 || c == 92u8) == 0) {
        return `"${s}"`;
    }
    return escapeFrom(s, b, 0, 0, "\"") + "\"";
}

// the escape of a byte of a string of JSON: `\"`, `\\`, `\n`, `\r`, `\t`,
// `\u00XY` for the other controls
function escapeOf(c: u8): string {
    if (c == 34u8) {
        return "\\\"";
    }
    if (c == 92u8) {
        return "\\\\";
    }
    if (c == 10u8) {
        return "\\n";
    }
    if (c == 13u8) {
        return "\\r";
    }
    if (c == 9u8) {
        return "\\t";
    }
    const k = i64(c);
    return `\\u00${k < 16 ? "0" : "1"}${"0123456789abcdef".slice(k % 16, k % 16 + 1)}`;
}

// the text of `s` escaped from its byte `i`, those from `from` to `i` not
// yet written, after `acc` (owned: each part written after it in its
// block, rule A): one pass (D397: six `replaceAll` and a count of the text
// for each control, 14.1 times its floor)
function escapeFrom(s: string, b: u8[n], from: i64, i: i64, acc: string): string {
    if (i == b.length) {
        return acc + s.slice(from, i);
    }
    const c = b[i];
    if (c >= 32u8 && c != 34u8 && c != 92u8) {
        return escapeFrom(s, b, from, i + 1, acc);
    }
    return escapeFrom(s, b, i + 1, i + 1, acc + s.slice(from, i) + escapeOf(c));
}

// `j` as text, without spaces; a number in its shortest form, NaN and the
// infinities as `null` (as JavaScript)
export function stringify(j: Json): string {
    return match (j) {
        Null => "null",
        Bool(x) => x ? "true" : "false",
        Num(x) => numberText(x),
        Str(s) => quote(s),
        Arr(xs) => "[" + join(map(xs, stringify), ",") + "]",
        Obj(ks, vs) => "{" + join(map(iota(ks.length), (i) => quote(ks[i]) + ":" + stringify(vs[i])), ",") + "}",
    };
}

// ----- decoding into a type of the program (D336) ---------------------
//
// `decode<T>(text)` and `encode<T>(x)` are placeholders: at each call the
// compiler gives the functions it writes for `T` in this module (named
// `codec*`), over the functions below. A value of the text is a segment
// [s, e) of its bytes, spaces around it allowed; a check returns the place
// of the first fault and what it is (-1 and "" when none), its path given
// by the containers on the way back ("[3].x: a number expected").

// the value of `text` decoded into `T`: `decode<Point>(text)`
export function decode<T>(text: string): Result<T, JsonError> {
    return Err({ line: 0, column: 0, message: "decode" });
}

// `x` as text of JSON
export function encode<T>(x: T): string {
    return "";
}

function fine(): [i64, string] {
    return [-1, ""] as const;
}

// the text is UTF-8, at most 512 levels deep
function checkText(b: u8[n], ix: Index): [i64, string] {
    if (count(b, (x) => x >= 0x80u8) > 0 && !utf8(b)) {
        return [0, "not UTF-8"] as const;
    }
    if (b.length > 0 && max(ixPacked(ix)) >> 2i32 > 512i32) {
        return [0, "deeper than 512"] as const;
    }
    return fine();
}

// the magnitude of the digits from `a` to `z`, saturated at the largest
// `u64` with a flag
function magnitude(b: u8[n], a: i64, z: i64): [u64, boolean] {
    return fold(iota(z - a), [0u64, false] as const, (acc, j) => {
        const [v, over] = acc;
        const d = u64(b[a + j] - 48u8);
        return over || v > (18446744073709551615u64 - d) / 10u64 ? [18446744073709551615u64, true] as const : [v * 10u64 + d, false] as const;
    });
}

// the segments of the elements of the container from `a` to `c`: its
// commas, those of its level outside strings
function elements(b: u8[n], ix: Index, a: i64, c: i64): [i64[m], i64[m]] {
    const packed = ixPacked(ix);
    // a comma of the level of the container, outside strings: its packed
    // state is that of the opening
    const at = packed[a];
    const commas = map(filter(iota(c - a - 1), (j) => b[a + 1 + j] == 44u8 && packed[a + 1 + j] == at), (j) => a + 1 + j);
    const m = skip(b, a + 1) == c && commas.length == 0 ? 0 : commas.length + 1;
    return [map(iota(m), (j) => j == 0 ? a + 1 : commas[j - 1] + 1), map(iota(m), (j) => j + 1 < m ? commas[j] : c)] as const;
}

// the first fault of the elements [ss, es] by `check`, its index before it
// (each element checked once: in parallel, by `map`)
function firstFault(ss: i64[m], es: i64[m], check: (i64, i64) => [i64, string]): [i64, string] {
    const faults = map(iota(ss.length), (j) => check(ss[j], es[j]));
    const bad = filter(iota(ss.length), (j) => {
        const [at, why] = faults[j];
        return at >= 0;
    });
    if (bad.length == 0) {
        return fine();
    }
    const [at, why] = faults[bad[0]];
    return [at, `[${bad[0]}]${why}`] as const;
}

// the first place from `at` whose byte is not `c`
function firstNot(b: u8[n], c: u8, at: i64): i64 {
    return at < b.length && b[at] == c ? firstNot(b, c, at + 1) : at;
}

// the last place before `at` whose byte is not `c`, plus one
function lastNot(b: u8[n], c: u8, at: i64): i64 {
    return at > 0 && b[at - 1] == c ? lastNot(b, c, at - 1) : at;
}

// the digits of `t` (a number written without exponent: `-0.0005`,
// `1000`) with an exponent, as JavaScript writes them: `5e-4`, `1e+3`
function exponentForm(t: string): string {
    const neg = t.slice(0, 1) == "-";
    const body = neg ? t.slice(1, t.length) : t;
    const dot = body.indexOf(".");
    const whole = dot < 0 ? body : body.slice(0, dot);
    const part = dot < 0 ? "" : body.slice(dot + 1, body.length);
    const digits = bytes(whole + part);
    const lead = firstNot(digits, 48u8, 0);
    const end = lastNot(digits, 48u8, digits.length);
    const sig = stringOf(digits).slice(lead, Math.max(end, lead + 1));
    const exp = whole.length - 1 - lead;
    const mantissa = sig.length > 1 ? sig.slice(0, 1) + "." + sig.slice(1, sig.length) : sig;
    return `${neg ? "-" : ""}${mantissa}e${exp >= 0 ? "+" : "-"}${Math.abs(exp)}`;
}

// a number as text of JSON, as JavaScript writes it (`JSON.stringify`):
// its shortest digits, with an exponent from 1e21 and below 1e-6, -0 as 0,
// NaN and the infinities as `null`
function numberText(x: f64): string {
    if (x != x || x == 1.0 / 0.0 || x == -1.0 / 0.0) {
        return "null";
    }
    if (x == 0.0) {
        return "0";
    }
    const a = Math.abs(x);
    return a < 1e21 && a >= 1e-6 ? toString(x) : exponentForm(toString(x));
}

function number32Text(x: f32): string {
    if (x != x || x == 1.0f32 / 0.0f32 || x == -1.0f32 / 0.0f32) {
        return "null";
    }
    if (x == 0.0f32) {
        return "0";
    }
    const a = Math.abs(f64(x));
    return a < 1e21 && a >= 1e-6 ? toString(x) : exponentForm(toString(x));
}

// ----- reading by a cursor (D337) -------------------------------------
//
// A value is read from its place: a check returns the place after it, the
// place of its first fault (-1 for none) and what it is; a build returns
// the value and the place after it. The members of an object are read one
// after the other by a tail recursion (a loop), their names compared byte
// by byte where they are; the index of the text finds the closing of a
// container and the elements of an array, read in parallel.

// the place of the quote that ends the string whose bytes start at `p`
// (by the states of the index), or -1
function quoteEnd(b: u8[n], packed: i32[s], p: i64): i64 {
    if (p >= b.length) {
        return -1;
    }
    // a quote whose state before is "inside" (not escaped)
    return b[p] == 34u8 && stateBefore(packed, p) == 1i32 ? p : quoteEnd(b, packed, p + 1);
}

// the end of the string whose bytes start at `p`: its quote, the first one
// when no backslash comes before it (by the states otherwise)
function stringEnd(b: u8[n], ix: Index, p: i64): i64 {
    if (p >= b.length) {
        return -1;
    }
    const c = b[p];
    if (c == 34u8) {
        return p;
    }
    return c == 92u8 ? quoteEnd(b, ixPacked(ix), p) : stringEnd(b, ix, p + 1);
}

// the first place of [a, z) whose byte is `c`, or `z`
function findByte(b: u8[n], c: u8, a: i64, z: i64): i64 {
    return a >= z || b[a] == c ? a : findByte(b, c, a + 1, z);
}

// the bytes of [a, z) are neither control characters nor backslashes
function plain(b: u8[n], a: i64, z: i64): boolean {
    return a >= z || (b[a] >= 32u8 && b[a] != 92u8 && plain(b, a + 1, z));
}

// the bytes of `v` from `j` are those of `b` from `a`
function sameFrom(b: u8[n], a: i64, v: u8[m], j: i64): boolean {
    return j >= v.length || (b[a + j] == v[j] && sameFrom(b, a, v, j + 1));
}

// a byte of a number or of a literal
function wordByte(c: u8): boolean {
    return (c >= 48u8 && c <= 57u8) || (c >= 97u8 && c <= 122u8) || (c >= 65u8 && c <= 90u8) || c == 45u8 || c == 43u8 || c == 46u8;
}

// the place after the word of a number or a literal that starts at `a`
function wordAfter(b: u8[n], a: i64): i64 {
    return a < b.length && wordByte(b[a]) ? wordAfter(b, a + 1) : a;
}

// the bytes from `a` to `z` are those of `w`
function sameBytes(b: u8[n], a: i64, z: i64, w: string): boolean {
    const v = bytes(w);
    return z - a == v.length && sameFrom(b, a, v, 0);
}

// the first place from `q` where the depth falls below `level`, or -1
function below(packed: i32[s], level: i32, q: i64): i64 {
    if (q >= packed.length) {
        return -1;
    }
    return packed[q] >> 2i32 < level ? q : below(packed, level, q + 1);
}

// the closing of the container that opens at `a` (of either kind: the
// reader checks it), or -1
function closingOf(b: u8[n], ix: Index, a: i64): i64 {
    const packed = ixPacked(ix);
    return below(packed, packed[a] >> 2i32, a + 1);
}

// the number of elements of the container from `a` to `c`
function elementCount(b: u8[n], ix: Index, a: i64, c: i64): i64 {
    const packed = ixPacked(ix);
    const at = packed[a];
    const commas = count(iota(c - a - 1), (j) => b[a + 1 + j] == 44u8 && packed[a + 1 + j] == at);
    return skip(b, a + 1) == c && commas == 0 ? 0 : commas + 1;
}

function numberAt(b: u8[n], at: i64): [i64, i64, string] {
    const a = skip(b, at);
    const z = wordAfter(b, a);
    return a < z && numberOk(b, a, z) ? [z, -1, ""] as const : [z, a, ": a number expected"] as const;
}

function numberValueAt(b: u8[n], text: string, at: i64): [f64, i64] {
    const a = skip(b, at);
    const z = wordAfter(b, a);
    return [parseF64(text.slice(a, z)), z] as const;
}

// an integer of JSON (`-?(0|[1-9][0-9]*)`) from `-negMax` to `posMax`
function integerAt(b: u8[n], at: i64, negMax: u64, posMax: u64, what: string): [i64, i64, string] {
    const a = skip(b, at);
    const z = wordAfter(b, a);
    const neg = a < z && b[a] == 45u8;
    const d = neg ? a + 1 : a;
    if (d >= z || digitsEnd(b, d, z) != z || (b[d] == 48u8 && z - d > 1)) {
        return [z, a, `: an integer expected (${what})`] as const;
    }
    const [m, over] = magnitude(b, d, z);
    if (over || m > (neg ? negMax : posMax)) {
        return [z, a, `: out of the range of ${what}`] as const;
    }
    return [z, -1, ""] as const;
}

function integerValueAt(b: u8[n], at: i64): [i64, i64] {
    const a = skip(b, at);
    const z = wordAfter(b, a);
    const neg = b[a] == 45u8;
    const [m, over] = magnitude(b, neg ? a + 1 : a, z);
    return [neg ? -i64(m) : i64(m), z] as const;
}

function unsignedValueAt(b: u8[n], at: i64): [u64, i64] {
    const a = skip(b, at);
    const z = wordAfter(b, a);
    const [m, over] = magnitude(b, a, z);
    return [m, z] as const;
}

function boolAt(b: u8[n], at: i64): [i64, i64, string] {
    const a = skip(b, at);
    const z = wordAfter(b, a);
    return sameBytes(b, a, z, "true") || sameBytes(b, a, z, "false") ? [z, -1, ""] as const : [z, a, ": true or false expected"] as const;
}

function boolValueAt(b: u8[n], at: i64): [boolean, i64] {
    const a = skip(b, at);
    return [b[a] == 116u8, wordAfter(b, a)] as const;
}

// `null` at `at`: the place after it, or -1
function nullAt(b: u8[n], at: i64): i64 {
    const a = skip(b, at);
    const z = wordAfter(b, a);
    return sameBytes(b, a, z, "null") ? z : -1;
}

// a string at `at`: no control character, its escapes known
function stringCheckAt(b: u8[n], text: string, ix: Index, at: i64): [i64, i64, string] {
    const a = skip(b, at);
    if (a >= b.length || b[a] != 34u8) {
        return [a, a, ": a string expected"] as const;
    }
    const z = stringEnd(b, ix, a + 1);
    if (z < 0) {
        return [b.length, a, ": a string without its end"] as const;
    }
    if (plain(b, a + 1, z)) {
        return [z + 1, -1, ""] as const;
    }
    return match (stringAt(b, text, ix, a)) {
        Ok([v, end]) => [end, -1, ""] as const,
        Err(fault) => {
            const [p, why] = fault;
            return [z + 1, p, why] as const;
        },
    };
}

function stringValueAt(b: u8[n], text: string, ix: Index, at: i64): [string, i64] {
    const a = skip(b, at);
    const z = stringEnd(b, ix, a + 1);
    if (findByte(b, 92u8, a + 1, z) == z) {
        return [text.slice(a + 1, z), z + 1] as const;
    }
    return match (stringAt(b, text, ix, a)) {
        Ok([v, end]) => [v, end] as const,
        Err(_) => ["", z + 1] as const,
    };
}

// the place after the value at `at`, checked as any value (a member that
// the type does not name)
function anyAt(b: u8[n], text: string, ix: Index, at: i64): [i64, i64, string] {
    const a = skip(b, at);
    if (a >= b.length) {
        return [a, a, ": a value expected"] as const;
    }
    const c = b[a];
    if (c == 34u8) {
        return stringCheckAt(b, text, ix, a);
    }
    if (c == 91u8) {
        const [o, cl, p, why] = arrayCheckAt(b, ix, a, (x) => anyAt(b, text, ix, x));
        return [cl + 1, p, why] as const;
    }
    if (c == 123u8) {
        const z = emptyObject(b, a + 1);
        return z >= 0 ? [z, -1, ""] as const : anyMembers(b, text, ix, a + 1);
    }
    const z = wordAfter(b, a);
    if (sameBytes(b, a, z, "true") || sameBytes(b, a, z, "false") || sameBytes(b, a, z, "null") || (a < z && numberOk(b, a, z))) {
        return [z, -1, ""] as const;
    }
    return [z, a, a < z ? ": not a value" : ": a value expected"] as const;
}

// the members from `at` of an object, checked as any values
function anyMembers(b: u8[n], text: string, ix: Index, at: i64): [i64, i64, string] {
    const [ka, kz, v, kp, kwhy] = keyAt(b, ix, at);
    if (kp >= 0) {
        return [kp, kp, kwhy] as const;
    }
    const [e, p, why] = anyAt(b, text, ix, v);
    if (p >= 0) {
        return [e, p, `.${keyText(b, text, ix, ka, kz)}${why}`] as const;
    }
    const [next, after] = afterMember(b, e);
    if (next == 1) {
        return anyMembers(b, text, ix, after);
    }
    return next == 0 ? [after, -1, ""] as const : [after, after, ": a comma or a closing brace expected"] as const;
}

// the place after the value at `at`, already checked
function valueAfter(b: u8[n], ix: Index, at: i64): i64 {
    const a = skip(b, at);
    const c = b[a];
    if (c == 34u8) {
        return stringEnd(b, ix, a + 1) + 1;
    }
    if (c == 91u8 || c == 123u8) {
        return closingOf(b, ix, a) + 1;
    }
    return wordAfter(b, a);
}

// the elements of the array at `at` checked by `check` (each from its
// place: the place after it, its fault), each followed by a comma or the
// closing: its opening, closing, starts and the first fault
function arrayCheckAt(b: u8[n], ix: Index, at: i64, check: (i64) => [i64, i64, string]): [i64, i64, i64, string] {
    const a = skip(b, at);
    if (a >= b.length || b[a] != 91u8) {
        return [a, a, a, ": an array expected"] as const;
    }
    const c = closingOf(b, ix, a);
    if (c < 0) {
        return [a, b.length, a, ": a bracket without its end"] as const;
    }
    if (b[c] != 93u8) {
        return [a, c, c, ": a bracket closed by the other kind"] as const;
    }
    const [ss, es] = elements(b, ix, a, c);
    const [p, why] = firstFault(ss, es, (x, y) => {
        const [end, f, w] = check(x);
        const after = skip(b, end);
        return f >= 0 ? [f, w] as const : (after != y ? [after, ": a comma or a closing bracket expected"] as const : [-1, ""] as const);
    });
    return [a, c, p, why] as const;
}

// the starts of the elements of the array at `at` (checked)
function arrayStarts(b: u8[n], ix: Index, at: i64): [i64[m], i64] {
    const a = skip(b, at);
    const c = closingOf(b, ix, a);
    const [ss, es] = elements(b, ix, a, c);
    return [ss, c + 1] as const;
}

// after a member of an object at `at`: a comma (`1`, and the place after
// it), its closing brace (`0`), or a fault (-1)
function afterMember(b: u8[n], at: i64): [i64, i64] {
    const a = skip(b, at);
    if (a < b.length && b[a] == 44u8) {
        return [1, a + 1] as const;
    }
    if (a < b.length && b[a] == 125u8) {
        return [0, a + 1] as const;
    }
    return [-1, a] as const;
}

// the key of the member at `at`: its first and last bytes (inside its
// quotes), the place after its colon, a fault
function keyAt(b: u8[n], ix: Index, at: i64): [i64, i64, i64, i64, string] {
    const a = skip(b, at);
    if (a >= b.length || b[a] != 34u8) {
        return [a, a, a, a, ": a key expected"] as const;
    }
    const z = stringEnd(b, ix, a + 1);
    if (z < 0) {
        return [a, a, a, a, ": a string without its end"] as const;
    }
    const colon = skip(b, z + 1);
    if (colon >= b.length || b[colon] != 58u8) {
        return [a + 1, z, colon, colon, ": a colon expected"] as const;
    }
    return [a + 1, z, colon + 1, -1, ""] as const;
}

// the name of a key with escapes, read
function keyText(b: u8[n], text: string, ix: Index, a: i64, z: i64): string {
    if (findByte(b, 92u8, a, z) == z) {
        return text.slice(a, z);
    }
    return match (stringAt(b, text, ix, a - 1)) {
        Ok([v, end]) => v,
        Err(_) => text.slice(a, z),
    };
}

// an object at `at`: the place after its opening brace, or a fault
function objectOpen(b: u8[n], at: i64): [i64, i64, string] {
    const a = skip(b, at);
    return a < b.length && b[a] == 123u8 ? [a + 1, -1, ""] as const : [a, a, ": an object expected"] as const;
}

// the object at `at` is empty: the place after it, or -1
function emptyObject(b: u8[n], at: i64): i64 {
    const a = skip(b, at);
    return a < b.length && b[a] == 125u8 ? a + 1 : -1;
}
