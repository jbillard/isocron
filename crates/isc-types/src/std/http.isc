// The module `http` of the standard library (SPEC section 18): a client of
// HTTP/1.1 (D340) and a server (D342) over `net`, written in Isocron. A
// request of the client is sent on a connection of its own (`Connection:
// close`); the body of the response is read by `Content-Length`, by
// `chunked`, or to the end of the stream; the redirections are given as
// they are. `https://` is the module `https`'s. The server gives each
// request to a pure function, the requests ready at once by `map` (D327).
import { IoError, ioError, message as ioMessage } from "sys";
import * as net from "net";
import * as time from "time";

export type HttpError = Io(IoError) | Malformed(string) | TooLarge(i64) | BadUrl(string);
// a response, of a server to the client or of the handler of `serve`
// (arrays of their own size, D341)
export type Response = { status: i64, headers: [string, string][], body: u8[] };
// a request given to the handler of `serve`: the target cut at `?`
export type Request = { method: string, path: string, query: string, headers: [string, string][], body: u8[] };

// the most bytes of the head of a response, of its body
const HEAD_LIMIT = 65536;
const BODY_LIMIT = 67108864;

// the text of an error
export function message(e: HttpError): string {
    return match (e) {
        Io(x) => ioMessage(x),
        Malformed(w) => `malformed: ${w}`,
        TooLarge(n) => `too large: more than ${n} bytes`,
        BadUrl(u) => `bad url: ${u}`,
    };
}

// ----- the address --------------------------------------------------------

// the place of the first of the bytes `c` and `d` in `b` from `at`, or the
// end
function firstOf(b: u8[n], at: i64, c: u8, d: u8): i64 {
    return at >= b.length || b[at] == c || b[at] == d ? at : firstOf(b, at + 1, c, d);
}

// the place of the first of the bytes `c` and `d` in `b` from `at` to `z`,
// or `z`
function firstBefore(b: u8[n], at: i64, z: i64, c: u8, d: u8): i64 {
    return at >= z || b[at] == c || b[at] == d ? at : firstBefore(b, at + 1, z, c, d);
}

// a port: digits only, from 1 to 65535
function portOf(s: string): i64 {
    const b = bytes(s);
    if (b.length == 0 || b.length > 5 || count(b, (c) => c < 48u8 || c > 57u8) > 0) {
        return -1;
    }
    const p = fold(b, 0, (v, c) => v * 10 + i64(c - 48u8));
    return p >= 1 && p <= 65535 ? p : -1;
}

// the parts of an address of HTTP: [scheme, host, port, target]
export function parseUrl(url: string): Result<[string, string, i64, string], HttpError> {
    const i = url.indexOf("://");
    if (i <= 0) {
        return Err(BadUrl(url));
    }
    const scheme = url.slice(0, i).toLowerCase();
    if (scheme != "http" && scheme != "https") {
        return Err(BadUrl(url));
    }
    const rest = url.slice(i + 3, url.length);
    const b = bytes(rest);
    const end = firstOf(b, 0, 47u8, 63u8);
    const authority = rest.slice(0, end);
    const after = rest.slice(end, rest.length);
    const target = after == "" ? "/" : (after.startsWith("?") ? "/" + after : after);
    const fallback = scheme == "http" ? 80 : 443;
    // `[v6]:port`, `host:port`, `host`
    if (authority.startsWith("[")) {
        const close = authority.indexOf("]");
        if (close < 0) {
            return Err(BadUrl(url));
        }
        const host = authority.slice(1, close);
        const tail = authority.slice(close + 1, authority.length);
        const port = tail == "" ? fallback : (tail.startsWith(":") ? portOf(tail.slice(1, tail.length)) : -1);
        return host == "" || port < 0 ? Err(BadUrl(url)) : Ok([scheme, host, port, target] as const);
    }
    const colon = authority.indexOf(":");
    const host = colon < 0 ? authority : authority.slice(0, colon);
    const port = colon < 0 ? fallback : portOf(authority.slice(colon + 1, authority.length));
    if (host == "" || port < 0 || count(bytes(host), (c) => c <= 32u8 || c == 64u8) > 0) {
        return Err(BadUrl(url));
    }
    return Ok([scheme, host, port, target] as const);
}

// ----- the request ----------------------------------------------------------

// a name of a header: the characters of a token (RFC 9110)
function tokenOk(s: string): boolean {
    const b = bytes(s);
    return b.length > 0 && count(b, (c) => c <= 32u8 || c >= 127u8 || c == 40u8 || c == 41u8 || c == 44u8 || c == 47u8 || c == 58u8 || c == 59u8 || c == 60u8 || c == 61u8 || c == 62u8 || c == 63u8 || c == 64u8 || c == 91u8 || c == 92u8 || c == 93u8 || c == 123u8 || c == 125u8 || c == 34u8) == 0;
}

// a value of a header: no line feed, no carriage return, no zero byte
function valueOk(s: string): boolean {
    return count(bytes(s), (c) => c == 10u8 || c == 13u8 || c == 0u8) == 0;
}

// the head of a request
function requestHead(method: string, host: string, port: i64, fallback: i64, target: string, headers: [string, string][k], length: i64): string {
    const name = host.indexOf(":") >= 0 ? `[${host}]` : host;
    const where = port == fallback ? name : `${name}:${port}`;
    const extra = join(map(headers, (h) => {
        const [k, v] = h;
        return `${k}: ${v}\r\n`;
    }), "");
    const sized = length > 0 || method == "POST" || method == "PUT" || method == "PATCH" ? `Content-Length: ${length}\r\n` : "";
    return `${method} ${target} HTTP/1.1\r\nHost: ${where}\r\nUser-Agent: isocron\r\nConnection: close\r\n${extra}${sized}\r\n`;
}

// a fault of the request itself
function requestFault(method: string, target: string, headers: [string, string][k]): string {
    if (!tokenOk(method)) {
        return `the method ${method}`;
    }
    if (!valueOk(target) || target.indexOf(" ") >= 0) {
        return `the target ${target}`;
    }
    const bad = filter(headers, (h) => {
        const [k, v] = h;
        return !tokenOk(k) || !valueOk(v);
    });
    if (bad.length > 0) {
        const [k, v] = bad[0];
        return `the header ${k}`;
    }
    return "";
}

// ----- the response ---------------------------------------------------------

// arrays of bytes, the last read first
type Chunks = Done | More(u8[k], Chunks);

// the arrays of `cs` concatenated two by two onto `acc`, in the reverse
// order of `cs` (a loop); `newest` when `cs` has the newest first
function pairs(cs: Chunks, acc: Chunks, newest: boolean): Chunks {
    return match (cs) {
        Done => acc,
        More(x, rest) => match (rest) {
            Done => More(x, acc),
            More(y, more) => pairs(more, More(newest ? concat(y, x) : concat(x, y), acc), newest),
        },
    };
}

// the bytes of the `n` nodes of `cs` in the order they were read (`cs`
// has the newest first when `newest`): two by two, each byte copied
// log2(n) times, n nodes made in all
function flatten(cs: Chunks, n: i64, newest: boolean): u8[k] {
    if (n <= 1) {
        return match (cs) {
            Done => [],
            More(x, rest) => x,
        };
    }
    return flatten(pairs(cs, Done, newest), (n + 1) / 2, !newest);
}

// the place after the end of the head (CR LF CR LF) from `at`, or -1: a
// loop that stops there
function headEnd(b: u8[n], at: i64): i64 {
    if (at + 3 >= b.length) {
        return -1;
    }
    return b[at] == 13u8 && b[at + 1] == 10u8 && b[at + 2] == 13u8 && b[at + 3] == 10u8 ? at + 4 : headEnd(b, at + 1);
}

// the bytes of `c` until the end of the head: all the bytes read and the
// place after the head (the bytes before `from` already searched)
action readHead(c: net.Conn, buf: u8[n], from: i64): Result<[u8[k], i64], HttpError> {
    const at = headEnd(buf, from);
    if (at >= 0) {
        return Ok([buf, at] as const);
    }
    if (buf.length > HEAD_LIMIT) {
        return Err(TooLarge(HEAD_LIMIT));
    }
    return match (net.read(c, 65536)) {
        Ok(b) => b.length == 0 ? Err(Malformed("the connection closed before the end of the head")) : readHead(c, concat(buf, b), Math.max(buf.length - 3, 0)),
        Err(e) => Err(Io(e)),
    };
}

// the bytes of `c` until `want` of them are read (`have` already, in
// `count` nodes of `cs`)
action readLength(c: net.Conn, status: i64, hs: [string, string][h], cs: Chunks, count: i64, have: i64, want: i64): Result<Response, HttpError> {
    if (have >= want) {
        return Ok({ status: status, headers: hs, body: have == want ? flatten(cs, count, true) : flatten(cs, count, true).slice(0, want) });
    }
    return match (net.read(c, Math.min(want - have, 1048576))) {
        Ok(b) => b.length == 0 ? Err(Malformed(`the body ended after ${have} of ${want} bytes`)) : readLength(c, status, hs, More(b, cs), count + 1, have + b.length, want),
        Err(e) => Err(Io(e)),
    };
}

// the bytes of `c` until the end of the stream
action readToEnd(c: net.Conn, status: i64, hs: [string, string][h], cs: Chunks, count: i64, have: i64): Result<Response, HttpError> {
    if (have > BODY_LIMIT) {
        return Err(TooLarge(BODY_LIMIT));
    }
    return match (net.read(c, 1048576)) {
        Ok(b) => b.length == 0 ? Ok({ status: status, headers: hs, body: flatten(cs, count, true) }) : readToEnd(c, status, hs, More(b, cs), count + 1, have + b.length),
        Err(e) => Err(Io(e)),
    };
}

// the place of the first CR LF of `b` from `at`, or -1
function lineEnd(b: u8[n], at: i64): i64 {
    if (at + 1 >= b.length) {
        return -1;
    }
    return b[at] == 13u8 && b[at + 1] == 10u8 ? at : lineEnd(b, at + 1);
}

// the value of the hexadecimal digits of `b` from `a` to `z` (before any
// `;`), or -1
function hexSize(b: u8[n], a: i64, z: i64): i64 {
    const stop = firstBefore(b, a, z, 59u8, 32u8);
    if (stop == a || stop - a > 15) {
        return -1;
    }
    return fold(iota(stop - a), 0, (v, j) => {
        const c = b[a + j];
        const d = c >= 48u8 && c <= 57u8 ? i64(c) - 48 : (c >= 97u8 && c <= 102u8 ? i64(c) - 87 : (c >= 65u8 && c <= 70u8 ? i64(c) - 55 : -1));
        return v < 0 || d < 0 ? -1 : v * 16 + d;
    });
}

// the chunks of `buf` from `at` that are whole, after the `count` nodes of
// `cs` (`have` bytes): [the chunks, their count and bytes, a place, a
// state, a fault, a length]: the state 1 when the last chunk is there, -1
// a fault, -2 too large, 0 a line of a size not whole at the place, 2 the
// data of a chunk of the length not whole from the place; a function that
// only reads `buf` (passed to itself as it is: never copied)
function chunksIn(buf: u8[n], at: i64, cs: Chunks, count: i64, have: i64): [Chunks, i64, i64, i64, i64, string, i64] {
    const line = lineEnd(buf, at);
    if (line < 0) {
        return buf.length - at > 4096 ? [cs, count, have, at, -1, "a line of chunked longer than 4096 bytes", 0] as const : [cs, count, have, at, 0, "", 0] as const;
    }
    const len = hexSize(buf, at, line);
    if (len < 0) {
        return [cs, count, have, at, -1, "the size of a chunk", 0] as const;
    }
    if (len == 0) {
        return [cs, count, have, at, 1, "", 0] as const;
    }
    if (have + len > BODY_LIMIT) {
        return [cs, count, have, at, -2, "", 0] as const;
    }
    const start = line + 2;
    if (buf.length < start + len + 2) {
        return [cs, count, have, start, 2, "", len] as const;
    }
    if (buf[start + len] != 13u8 || buf[start + len + 1] != 10u8) {
        return [cs, count, have, at, -1, "a chunk not followed by CR LF", 0] as const;
    }
    return chunksIn(buf, start + len + 2, More(buf.slice(start, start + len), cs), count + 1, have + len);
}

// the body in chunks: `buf` the bytes read and not yet taken (after the CR
// LF that ends a chunk when `crlf`), the chunks found in `count` nodes of
// `cs`, `have` bytes of them; a chunk of `want` bytes not whole (0: none),
// `got` of them in the `pn` nodes of `ps`, read by pieces (each byte
// copied once, not with each read; `buf` then holds what follows them);
// each call with new bytes read
action readChunked(c: net.Conn, status: i64, hs: [string, string][h], buf: u8[n], crlf: boolean, cs: Chunks, count: i64, have: i64, ps: Chunks, pn: i64, got: i64, want: i64): Result<Response, HttpError> {
    if (want > 0) {
        if (got >= want) {
            return readChunked(c, status, hs, buf, true, More(flatten(ps, pn, true), cs), count + 1, have + want, Done, 0, 0, 0);
        }
        // at least 64 KiB read (what follows the chunk too, kept in `buf`)
        return match (net.read(c, Math.min(Math.max(want - got, 65536), 1048576))) {
            Ok(b) => {
                const k = Math.min(b.length, want - got);
                if (b.length == 0) {
                    return Err(Malformed("the body ended inside a chunk"));
                }
                return k == b.length ? readChunked(c, status, hs, buf, crlf, cs, count, have, More(b, ps), pn + 1, got + k, want) : readChunked(c, status, hs, b.slice(k, b.length), crlf, cs, count, have, More(b.slice(0, k), ps), pn + 1, got + k, want);
            },
            Err(e) => Err(Io(e)),
        };
    }
    if (crlf && buf.length >= 2 && (buf[0] != 13u8 || buf[1] != 10u8)) {
        return Err(Malformed("a chunk not followed by CR LF"));
    }
    const [found, n2, h2, at, state, why, len] = crlf && buf.length < 2 ? [cs, count, have, 0, 0, "", 0] as const : chunksIn(buf, crlf ? 2 : 0, cs, count, have);
    if (state == 1) {
        return Ok({ status: status, headers: hs, body: flatten(found, n2, true) });
    }
    if (state == -1) {
        return Err(Malformed(why));
    }
    if (state == -2) {
        return Err(TooLarge(BODY_LIMIT));
    }
    if (state == 2) {
        // its data so far (the CR of its end apart)
        const end = Math.min(buf.length, at + len);
        return readChunked(c, status, hs, buf.slice(end, buf.length), true, found, n2, h2, More(buf.slice(at, end), Done), 1, end - at, len);
    }
    return match (net.read(c, 65536)) {
        Ok(b) => b.length == 0 ? Err(Malformed("the body ended inside a chunk")) : readChunked(c, status, hs, concat(buf.slice(at, buf.length), b), crlf && at == 0, found, n2, h2, Done, 0, 0, 0),
        Err(e) => Err(Io(e)),
    };
}

// the bytes of `b` are UTF-8 as the runtime takes them (D451): each
// character a lead byte then the continuations it wants, the first in the
// range its lead allows (no overlong form, no surrogate, nothing above
// U+10FFFF). The state of the fold: -1 (not UTF-8), 0 (between
// characters), or the continuations still wanted times 65536 plus the
// range of the next one (its lowest byte times 256 plus its highest).
function utf8(b: u8[n]): boolean {
    if (count(b, (x) => x >= 0x80u8) == 0) {
        return true;
    }
    return fold(b, 0, (s, x) => {
        if (s < 0) {
            return -1;
        }
        const c = i64(x);
        if (s > 0) {
            const want = s / 65536;
            const fits = c >= (s / 256) % 256 && c <= s % 256;
            return fits ? (want == 1 ? 0 : (want - 1) * 65536 + 0x80BF) : -1;
        }
        if (c < 0x80) {
            return 0;
        }
        if (c >= 0xC2 && c <= 0xDF) {
            return 65536 + 0x80BF;
        }
        if (c >= 0xE0 && c <= 0xEF) {
            return 2 * 65536 + (c == 0xE0 ? 0xA0BF : (c == 0xED ? 0x809F : 0x80BF));
        }
        if (c >= 0xF0 && c <= 0xF4) {
            return 3 * 65536 + (c == 0xF0 ? 0x90BF : (c == 0xF4 ? 0x808F : 0x80BF));
        }
        return -1;
    }) == 0;
}

// the value of the header `name` (its case ignored) of `hs`, the last one
export function headerOf(hs: [string, string][k], name: string): Option<string> {
    // each name compared to `name` byte by byte, the case of ASCII ignored:
    // no text made for it, nor an array of those found (D395: 14.6 times
    // its floor, a text in lower case for each header)
    const at = fold(iota(hs.length), -1, (a, i) => {
        const [k, v] = hs[i];
        return sameName(k, name) ? i : a;
    });
    if (at < 0) {
        return None;
    }
    const [k, v] = hs[at];
    return Some(v);
}

// `k` and `n` the same name of a header, the case of ASCII ignored, as RFC
// 9110 compares the names of fields (tokens of ASCII); the other bytes as
// they are (D395)
function sameName(k: string, n: string): boolean {
    const b = bytes(k);
    const w = bytes(n);
    return b.length == w.length && count(iota(w.length), (i) => lower(b[i]) != lower(w[i])) == 0;
}

// the value of the header `name` of the response `r`
export function header(r: Response, name: string): Option<string> {
    return headerOf(r.headers, name);
}

// the body of `r` as text (a byte that is not UTF-8: `?`)
export function text(r: Response): string {
    return utf8(r.body) ? stringOf(r.body) : stringOf(map(r.body, (x) => x >= 0x80u8 ? 63u8 : x));
}

// the head of a response: [status, headers], or its fault
function parseHead(head: string): Result<[i64, [string, string][k]], HttpError> {
    const lines = head.split("\r\n");
    const status = lines[0];
    if (!status.startsWith("HTTP/1.") || status.length < 12 || status.slice(8, 9) != " ") {
        return Err(Malformed(`the status line ${status}`));
    }
    const code = portOf(status.slice(9, 12));
    if (code < 100 || code > 999) {
        return Err(Malformed(`the status line ${status}`));
    }
    const rest = filter(lines.slice(1, lines.length), (l) => l != "");
    const bad = filter(rest, (l) => l.indexOf(":") <= 0);
    if (bad.length > 0) {
        return Err(Malformed(`the header line ${bad[0]}`));
    }
    return Ok([code, map(rest, (l) => {
        const i = l.indexOf(":");
        return [l.slice(0, i).trim(), l.slice(i + 1, l.length).trim()] as const;
    })] as const);
}

// the response read from `c` to the request `method`
action readResponse(c: net.Conn, method: string): Result<Response, HttpError> {
    return match (readHead(c, [], 0)) {
        Ok([buf, at]) => {
            const headBytes = buf.slice(0, at - 4);
            if (!utf8(headBytes)) {
                return Err(Malformed("the head is not text"));
            }
            return match (parseHead(stringOf(headBytes))) {
                Ok([status, hs]) => {
                    const rest = buf.slice(at, buf.length);
                    const none = method == "HEAD" || status == 204 || status == 304 || (status >= 100 && status < 200);
                    const chunked = match (headerOf(hs, "transfer-encoding")) {
                        Some(v) => v.toLowerCase().indexOf("chunked") >= 0,
                        None => false,
                    };
                    const length = match (headerOf(hs, "content-length")) {
                        Some(v) => {
                            const t = bytes(v);
                            return t.length > 0 && t.length < 16 && count(t, (x) => x < 48u8 || x > 57u8) == 0 ? fold(t, 0, (n, x) => n * 10 + i64(x - 48u8)) : -2;
                        },
                        None => -1,
                    };
                    if (none) {
                        return Ok({ status: status, headers: hs, body: [] });
                    }
                    if (chunked) {
                        return readChunked(c, status, hs, rest, false, Done, 0, 0, Done, 0, 0, 0);
                    }
                    if (length == -2) {
                        return Err(Malformed("the header Content-Length"));
                    }
                    if (length > BODY_LIMIT) {
                        return Err(TooLarge(BODY_LIMIT));
                    }
                    return length >= 0 ? readLength(c, status, hs, More(rest, Done), 1, rest.length, length) : readToEnd(c, status, hs, More(rest, Done), 1, rest.length);
                },
                Err(e) => Err(e),
            };
        },
        Err(e) => Err(e),
    };
}

// the request sent on the connection `c` (which stays open), to `host` and
// `port` (`fallback` the port of its scheme), and its response read
export action exchange(c: net.Conn, method: string, host: string, port: i64, fallback: i64, target: string, headers: [string, string][k], body: u8[n]): Result<Response, HttpError> {
    const fault = requestFault(method, target, headers);
    if (fault != "") {
        return Err(Malformed(fault));
    }
    return match (net.write(c, concat(bytes(requestHead(method, host, port, fallback, target, headers, body.length)), body))) {
        Ok(_) => readResponse(c, method),
        Err(e) => Err(Io(e)),
    };
}

// the request `method` of `url` with the headers and the body given
export action request(method: string, url: string, headers: [string, string][k], body: u8[n]): Result<Response, HttpError> {
    return match (parseUrl(url)) {
        Ok([scheme, host, port, target]) => {
            if (scheme == "https") {
                return Err(BadUrl(`${url}: the module https sends it (import { get } from "https")`));
            }
            return match (net.connect(host, port)) {
                Ok(c) => {
                    const r = exchange(c, method, host, port, 80, target, headers, body);
                    net.close(c);
                    return r;
                },
                Err(e) => Err(Io(e)),
            };
        },
        Err(e) => Err(e),
    };
}

// the response to `GET url`
export action get(url: string): Result<Response, HttpError> {
    return request("GET", url, [], []);
}

// ----- the server (D342) ---------------------------------------------------

// the most bytes of the body of a request, of one read of a connection
const REQUEST_BODY_LIMIT = 16777216;
const READ_LIMIT = 65536;

// the bytes received from a connection and not yet a request
type Pending = { id: i64, buf: u8[] };

// a response ready to be sent: its connection, its bytes, whether the
// connection is kept after it
type Out = { id: i64, bytes: u8[], keep: boolean };

function pendingOf(id: i64, buf: u8[]): Pending {
    return { id: id, buf: buf };
}

function outOf(id: i64, x: u8[], keep: boolean): Out {
    return { id: id, bytes: x, keep: keep };
}

// the text of a status
function reason(status: i64): string {
    return match (status) {
        100 => "Continue",
        200 => "OK",
        201 => "Created",
        202 => "Accepted",
        204 => "No Content",
        206 => "Partial Content",
        301 => "Moved Permanently",
        302 => "Found",
        303 => "See Other",
        304 => "Not Modified",
        307 => "Temporary Redirect",
        308 => "Permanent Redirect",
        400 => "Bad Request",
        401 => "Unauthorized",
        403 => "Forbidden",
        404 => "Not Found",
        405 => "Method Not Allowed",
        408 => "Request Timeout",
        409 => "Conflict",
        411 => "Length Required",
        413 => "Content Too Large",
        415 => "Unsupported Media Type",
        422 => "Unprocessable Content",
        429 => "Too Many Requests",
        431 => "Request Header Fields Too Large",
        500 => "Internal Server Error",
        501 => "Not Implemented",
        502 => "Bad Gateway",
        503 => "Service Unavailable",
        _ => "Status",
    };
}

// a response of `status` whose body is the text `s` (`text/plain`)
export function textResponse(status: i64, s: string): Response {
    return { status: status, headers: [["Content-Type", "text/plain; charset=utf-8"] as const], body: bytes(s) };
}

// the instant `i` as HTTP writes a date (`Sun, 06 Nov 1994 08:49:37 GMT`)
export function httpDate(i: i64): string {
    const d = time.toDateTime(i, 0);
    // data of the program (D401)
    const days = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"];
    const months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
    // the fields of two digits written into the text itself, each as a pair
    // of the table of the digits (D446; D402: a text made then freed for
    // each before; D461: by its two digits before, two divisions a field)
    // the day of the week from the days since 1970-01-01 (a Thursday), the
    // division of `toDateTime` (D461: `time.weekday` found the days again
    // from the date, by more divisions)
    const q = i / 86400000000000;
    const w = ((i % 86400000000000 < 0 ? q - 1 : q) + 3) % 7;
    return `${days[w < 0 ? w + 7 : w]}, ${two(d.date.day)} ${months[d.date.month - 1]} ${d.date.year} ${two(d.time.hour)}:${two(d.time.minute)}:${two(d.time.second)} GMT`;
}

// `x` (0 to 99) in two digits
function two(x: i64): string {
    return toString(x).padStart(2, "0");
}

// the bytes of the response `r` (its body left out for HEAD), the
// connection kept or not; a response that cannot be sent as it is (its
// status, a header that is not a token or holds CR or LF): 500. The
// headers that the server writes itself left out of those of `r`, their
// names compared by bytes (no text made)
function responseBytes(r: Response, keep: boolean, head: boolean, date: string): u8[] {
    const ok = r.status >= 100 && r.status <= 999 && count(r.headers, (h) => {
        const [k, v] = h;
        return !tokenOk(k) || !valueOk(v);
    }) == 0;
    const x = ok ? r : textResponse(500, "the response of the handler cannot be sent (its status or a header)");
    const extra = join(map(x.headers, (h) => {
        const [k, v] = h;
        const b = bytes(k);
        const own = isName(b, 0, b.length, "content-length") || isName(b, 0, b.length, "connection") || isName(b, 0, b.length, "date") || isName(b, 0, b.length, "transfer-encoding");
        return own ? "" : `${k}: ${v}\r\n`;
    }), "");
    const none = x.status == 204 || x.status == 304 || x.status < 200;
    const top = none ? `HTTP/1.1 ${x.status} ${reason(x.status)}\r\nDate: ${date}\r\n${extra}${keep ? "" : "Connection: close\r\n"}\r\n` : `HTTP/1.1 ${x.status} ${reason(x.status)}\r\nDate: ${date}\r\n${extra}Content-Length: ${x.body.length}\r\n${keep ? "" : "Connection: close\r\n"}\r\n`;
    return head || none ? bytes(top) : concat(bytes(top), x.body);
}

// a byte in lower case (ASCII)
function lower(c: u8): u8 {
    return c >= 65u8 && c <= 90u8 ? c + 32u8 : c;
}

// the bytes of `b` from `a` to `z` are `name` (in lower case), their case
// ignored
function isName(b: u8[], a: i64, z: i64, name: string): boolean {
    const w = bytes(name);
    return z - a == w.length && count(iota(w.length), (i) => lower(b[a + i]) != w[i]) == 0;
}

// the bytes of `b` from `a` to `z` hold the word `w` (in lower case), its
// case ignored
function holdsWord(b: u8[], a: i64, z: i64, w: string): boolean {
    const n = bytes(w).length;
    return count(iota(Math.max(z - a - n + 1, 0)), (i) => isName(b, a + i, a + i + n, w)) > 0;
}

// the first place from `a` to `z` of `b` that is not a space or a tab
function spacesEnd(b: u8[], a: i64, z: i64): i64 {
    return a >= z || (b[a] != 32u8 && b[a] != 9u8) ? a : spacesEnd(b, a + 1, z);
}

// the last place before `z` (down to `a`) after a byte that is not a space
// or a tab
function spacesStart(b: u8[], a: i64, z: i64): i64 {
    return z <= a || (b[z - 1] != 32u8 && b[z - 1] != 9u8) ? z : spacesStart(b, a, z - 1);
}

// the value of the decimal digits of `b` from `a` to `z`, spaces around
// them apart, or -1
function decimalAt(b: u8[], a: i64, z: i64): i64 {
    const s = spacesEnd(b, a, z);
    const e = spacesStart(b, s, z);
    if (e - s <= 0 || e - s > 15) {
        return -1;
    }
    return fold(iota(e - s), 0, (v, j) => {
        const c = b[s + j];
        return v < 0 || c < 48u8 || c > 57u8 ? -1 : v * 10 + i64(c - 48u8);
    });
}

// a byte of a token (RFC 9110)
function tokenByte(c: u8): boolean {
    return (c >= 97u8 && c <= 122u8) || (c >= 65u8 && c <= 90u8) || (c >= 48u8 && c <= 57u8) || c == 45u8 || c == 33u8 || (c >= 35u8 && c <= 39u8) || c == 42u8 || c == 43u8 || c == 46u8 || c == 94u8 || c == 95u8 || c == 96u8 || c == 124u8 || c == 126u8;
}

// the head of a request in `b` from `a` to `z` (after its CR LF CR LF):
// the places that cut it, read once and shared by its frame and its
// request: the end of each line (the request line first), the two spaces
// of the request line
type Head = { eols: i64[], sp1: i64, sp2: i64 };

function headOf(b: u8[], a: i64, z: i64): Head {
    const eols = map(filter(iota(Math.max(z - 2 - a, 0)), (i) => b[a + i] == 13u8 && b[a + i + 1] == 10u8), (i) => a + i);
    const e0 = eols.length > 0 ? eols[0] : a;
    const sp1 = firstBefore(b, a, e0, 32u8, 32u8);
    const sp2 = firstBefore(b, Math.min(sp1 + 1, e0), e0, 32u8, 32u8);
    return { eols: eols, sp1: sp1, sp2: sp2 };
}

// what a server must know of a request before it answers it: the length
// of its body, the status of its fault (0: none), whether its connection
// is kept after it, whether its method is HEAD
type Frame = { length: i64, fault: i64, keep: boolean, head: boolean };

function fault(code: i64): Frame {
    return { length: 0, fault: code, keep: false, head: false };
}

// the frame of the request whose head is `b` from `a` to `z`
function frameOf(b: u8[], a: i64, z: i64, h: Head): Frame {
    const e0 = h.eols.length > 0 ? h.eols[0] : a;
    const v = h.sp2 + 1;
    const versionOk = e0 - v == 8 && isName(b, v, v + 7, "http/1.") && (b[v + 7] == 48u8 || b[v + 7] == 49u8);
    const methodOk = h.sp1 > a && count(iota(h.sp1 - a), (i) => !tokenByte(b[a + i])) == 0;
    const targetOk = h.sp2 > h.sp1 + 1 && (b[h.sp1 + 1] == 47u8 || (h.sp2 == h.sp1 + 2 && b[h.sp1 + 1] == 42u8));
    if (!versionOk || !methodOk || !targetOk || h.eols.length == 0 || count(b.slice(a, z), (c) => c >= 0x80u8) > 0 && !utf8(b.slice(a, z))) {
        return fault(400);
    }
    // each header: [its kind (1 Content-Length, 2 Transfer-Encoding, 3
    // Connection, 4 Host, 0 another, -1 not a header), the start and the
    // end of its value]
    const hs = map(iota(h.eols.length - 1), (j) => {
        const s = h.eols[j] + 2;
        const e = h.eols[j + 1];
        const colon = firstBefore(b, s, e, 58u8, 58u8);
        const ok = colon > s && colon < e && count(iota(colon - s), (i) => !tokenByte(b[s + i])) == 0;
        const kind = !ok ? -1 : (isName(b, s, colon, "content-length") ? 1 : (isName(b, s, colon, "transfer-encoding") ? 2 : (isName(b, s, colon, "connection") ? 3 : (isName(b, s, colon, "host") ? 4 : 0))));
        return [kind, colon + 1, e] as const;
    });
    const has = (k: i64) => count(hs, (x) => {
        const [kind, vs, ve] = x;
        return kind == k;
    }) > 0;
    const last = (k: i64) => fold(hs, -1, (at, x) => {
        const [kind, vs, ve] = x;
        return kind == k ? vs : at;
    });
    const http11 = b[v + 7] == 49u8;
    if (has(-1) || (http11 && !has(4))) {
        return fault(400);
    }
    if (has(2)) {
        return fault(501);
    }
    const cl = last(1);
    const length = cl < 0 ? 0 : decimalAt(b, cl, fold(hs, 0, (e, x) => {
        const [kind, vs, ve] = x;
        return vs == cl ? ve : e;
    }));
    if (length < 0) {
        return fault(400);
    }
    if (length > REQUEST_BODY_LIMIT) {
        return fault(413);
    }
    const close = count(hs, (x) => {
        const [kind, vs, ve] = x;
        return kind == 3 && holdsWord(b, vs, ve, "close");
    }) > 0;
    const alive = count(hs, (x) => {
        const [kind, vs, ve] = x;
        return kind == 3 && holdsWord(b, vs, ve, "keep-alive");
    }) > 0;
    return { length: length, fault: 0, keep: http11 ? !close : alive, head: isName(b, a, h.sp1, "head") && b[a] == 72u8 };
}

// the request whose head is `b` from `a` to `z`, its body after it
function requestAt(b: u8[], a: i64, z: i64, h: Head, length: i64): Request {
    const text = (s: i64, e: i64) => stringOf(b.slice(s, e));
    const target = text(h.sp1 + 1, h.sp2);
    const q = target.indexOf("?");
    const headers = map(iota(h.eols.length - 1), (j) => {
        const s = h.eols[j] + 2;
        const e = h.eols[j + 1];
        const colon = firstBefore(b, s, e, 58u8, 58u8);
        const vs = spacesEnd(b, colon + 1, e);
        return [text(s, colon), text(vs, spacesStart(b, vs, e))] as const;
    });
    return { method: text(a, h.sp1), path: q < 0 ? target : target.slice(0, q), query: q < 0 ? "" : target.slice(q + 1, target.length), headers: headers, body: b.slice(z, z + length) };
}

// the requests ready at the start of the bytes of a connection: those
// complete up to the first that has a body, closes the connection or is a
// fault (a pipeline of requests answered at once, in order): their places
// and frames, the bytes they take, whether the connection is closed after
type Ready = { starts: i64[], ends: i64[], frames: Frame[], heads: Head[], used: i64, closes: boolean };

function nothingReady(): Ready {
    return { starts: [], ends: [], frames: [], heads: [], used: 0, closes: false };
}

function tooLong(buf: u8[]): Ready {
    return { starts: [0], ends: [buf.length], frames: [fault(431)], heads: [headOf(buf, 0, 0)], used: buf.length, closes: true };
}

function readyOf(buf: u8[]): Ready {
    const ends = headEnds(buf);
    if (ends.length == 0) {
        // a head longer than the limit: 431 (all its bytes taken)
        return buf.length > HEAD_LIMIT ? tooLong(buf) : nothingReady();
    }
    const starts = map(iota(ends.length), (k) => k == 0 ? 0 : ends[k - 1]);
    const heads = map(iota(ends.length), (k) => headOf(buf, starts[k], ends[k]));
    const frames = map(iota(ends.length), (k) => frameOf(buf, starts[k], ends[k], heads[k]));
    // the first that stops the pipeline
    const stop = min(map(iota(ends.length), (k) => frames[k].fault != 0 || !frames[k].keep || frames[k].length > 0 ? k : ends.length));
    const whole = stop < ends.length && (frames[stop].fault != 0 || ends[stop] + frames[stop].length <= buf.length);
    const take = stop == ends.length ? ends.length : (whole ? stop + 1 : stop);
    const last = take - 1;
    const used = take == 0 ? 0 : (frames[last].fault != 0 ? buf.length : ends[last] + frames[last].length);
    const closes = take > 0 && (frames[last].fault != 0 || !frames[last].keep);
    // all of them taken (the common case): the arrays as they are, without
    // the copies of a slice (one of records is a new array, D377)
    if (take == ends.length) {
        return { starts: starts, ends: ends, frames: frames, heads: heads, used: used, closes: closes };
    }
    return { starts: starts.slice(0, take), ends: ends.slice(0, take), frames: frames.slice(0, take), heads: heads.slice(0, take), used: used, closes: closes };
}

// the end of each head of `buf` (after its CR LF CR LF)
function headEnds(buf: u8[]): i64[] {
    return map(filter(iota(Math.max(buf.length - 3, 0)), (i) => buf[i] == 13u8 && buf[i + 1] == 10u8 && buf[i + 2] == 13u8 && buf[i + 3] == 10u8), (i) => i + 4);
}

// the place of the connection `id` in `ps` (sorted by their numbers) from
// `lo` to `hi`, or -1
function placeOf(ps: Pending[n], id: i64, lo: i64, hi: i64): i64 {
    if (lo >= hi) {
        return -1;
    }
    const mid = (lo + hi) / 2;
    if (ps[mid].id == id) {
        return mid;
    }
    return ps[mid].id < id ? placeOf(ps, id, mid + 1, hi) : placeOf(ps, id, lo, mid);
}

// the arrivals `xs` added to the bytes pending of each connection (`ps`
// sorted by their numbers: each found by halving, its bytes added in place),
// those of new connections put at their places; the
// places of the connections that received bytes, and the numbers of those
// that ended (D354)
function arrive(ps: Pending[n], xs: net.Arrival[m]): [Pending[], i64[], i64[]] {
    const at = map(xs, (a) => placeOf(ps, a.id, 0, ps.length));
    const ended = map(filter(xs, (a) => a.bytes.length == 0), (a) => a.id);
    const grown = fold(iota(xs.length), ps, (acc, j) => at[j] >= 0 && xs[j].bytes.length > 0 ? acc.with(at[j], pendingOf(xs[j].id, concat(acc[at[j]].buf, xs[j].bytes))) : acc);
    const fresh = map(filter(iota(xs.length), (j) => at[j] < 0 && xs[j].bytes.length > 0), (j) => pendingOf(xs[j].id, xs[j].bytes));
    // (a connection is numbered when it is accepted, its first bytes may come
    // after those of one accepted later: the whole table sorted again)
    const all = fresh.length == 0 ? grown : concat(grown, fresh).sortBy((p) => p.id);
    const kept = ended.length == 0 ? all : filter(all, (p) => count(ended, (e) => e == p.id) == 0);
    // (a connection that ended in the same turn not read; each once)
    const read = filter(iota(xs.length), (j) => xs[j].bytes.length > 0 && count(ended, (e) => e == xs[j].id) == 0 && count(iota(j), (q) => xs[q].id == xs[j].id && xs[q].bytes.length > 0) == 0);
    const places = map(read, (j) => placeOf(kept, xs[j].id, 0, kept.length));
    return [kept, places, ended] as const;
}

// the connections `ids` from the `i`-th closed
action closeAll(s: net.Server, ids: i64[], i: i64): void {
    if (i < ids.length) {
        net.closeConn(s, ids[i]);
        closeAll(s, ids, i + 1);
    }
}

// the responses `outs` from the `i`-th sent; the numbers of the
// connections whose send failed (closed)
action sendAll(s: net.Server, outs: Out[n], i: i64, failed: i64[]): i64[] {
    if (i >= outs.length) {
        return failed;
    }
    const o = outs[i];
    return match (net.sendTo(s, o.id, o.bytes)) {
        Ok(_) => sendAll(s, outs, i + 1, failed),
        Err(e) => sendAll(s, outs, i + 1, concat(failed, [o.id])),
    };
}

// the place of `j` among the requests counted to the end of each connection
// by `ends` (inclusive): the first connection whose count passes it
function owner(ends: i64[], j: i64, lo: i64, hi: i64): i64 {
    if (lo >= hi) {
        return lo;
    }
    const mid = (lo + hi) / 2;
    return ends[mid] > j ? owner(ends, j, lo, mid) : owner(ends, j, mid + 1, hi);
}

// after the responses `outs` to the requests ready of the connections at
// the places `changed`: sent, the connections closed after their last
// response or whose send failed, the bytes after the requests kept (in
// place); the connections to read again (those that gave requests: more may
// be complete) (the two loops, D352, D354)
action afterAnswers(s: net.Server, ps: Pending[n], changed: i64[c], readies: Ready[c], outs: Out[k]): [Pending[], i64[]] {
    const failed = sendAll(s, outs, 0, []);
    const closing = map(filter(iota(changed.length), (i) => readies[i].closes || count(failed, (x) => x == ps[changed[i]].id) > 0), (i) => ps[changed[i]].id);
    closeAll(s, closing, 0);
    const cut = fold(iota(changed.length), ps, (acc, i) => readies[i].used == 0 ? acc : acc.with(changed[i], pendingOf(acc[changed[i]].id, acc[changed[i]].buf.slice(readies[i].used, acc[changed[i]].buf.length))));
    const again = map(filter(iota(changed.length), (i) => readies[i].used > 0), (i) => cut[changed[i]].id);
    const left = closing.length == 0 ? cut : filter(cut, (p) => count(closing, (x) => x == p.id) == 0);
    const live = filter(again, (id) => count(closing, (x) => x == id) == 0);
    return [left, map(live, (id) => placeOf(left, id, 0, left.length))] as const;
}

// the bytes of the responses to the requests ready from the `j`-th on,
// each asked to the action `handler` in its turn (a fault answered without
// it), written into `acc` (owned: changed in place, rule A of D351) as the
// `map` of `serveLoop` writes them (D352, D385)
action respondFrom(handler: action (Request) => Response, ps: Pending[n], changed: i64[c], readies: Ready[c], upto: i64[u], counts: i64[c], date: string, j: i64, acc: Out[m]): Out[m] {
    if (j == acc.length) {
        return acc;
    }
    const i = owner(upto, j, 0, upto.length);
    const r = readies[i];
    const k = j - (upto[i] - counts[i]);
    const f = r.frames[k];
    const keep = f.fault == 0 && f.keep;
    const response = f.fault != 0 ? textResponse(f.fault, reason(f.fault)) : handler(requestAt(ps[changed[i]].buf, r.starts[k], r.ends[k], r.heads[k], f.length));
    return respondFrom(handler, ps, changed, readies, upto, counts, date, j + 1, acc.with(j, outOf(ps[changed[i]].id, responseBytes(response, keep, f.head, date), keep)));
}

// the loop of a server whose handler is an action: as `serveLoop`, the
// requests ready answered one at a time by the action `handler` (D352)
action serveActionLoop(s: net.Server, handler: action (Request) => Response, ps: Pending[n], changed: i64[c], answered: i64, limit: i64): Result<void, IoError> {
    // only the connections that received bytes, or gave requests the turn
    // before, read (D354)
    const readies = map(changed, (i) => readyOf(ps[i].buf));
    const counts = map(readies, (r) => r.ends.length);
    const upto = scan(counts, (a, b) => a + b, 0);
    const total = upto.length == 0 ? 0 : upto[upto.length - 1];
    if (total == 0) {
        return match (net.wait(s, READ_LIMIT, -1)) {
            Ok(xs) => {
                const [next, places, ended] = arrive(ps, xs);
                closeAll(s, ended, 0);
                return serveActionLoop(s, handler, next, places, answered, limit);
            },
            Err(e) => {
                net.closeServer(s);
                return Err(e);
            },
        };
    }
    const date = httpDate(time.now());
    // the requests ready, each answered by `handler` in its turn (a fault
    // without it), its bytes written at once
    const outs = respondFrom(handler, ps, changed, readies, upto, counts, date, 0, fill(total, outOf(0, [], false)));
    const [left, again] = afterAnswers(s, ps, changed, readies, outs);
    const all = answered + total;
    if (limit > 0 && all >= limit) {
        net.closeServer(s);
        return Ok(());
    }
    return serveActionLoop(s, handler, left, again, all, limit);
}

// the loop of the server: the requests ready answered, all at once (the
// handler by `map`, in parallel), else the bytes that come waited for;
// `answered` requests so far, until `limit` (0: no end)
action serveLoop(s: net.Server, handler: (Request) => Response, ps: Pending[n], changed: i64[c], answered: i64, limit: i64): Result<void, IoError> {
    // only the connections that received bytes, or gave requests the turn
    // before, read (D354)
    const readies = map(changed, (i) => readyOf(ps[i].buf));
    const counts = map(readies, (r) => r.ends.length);
    const upto = scan(counts, (a, b) => a + b, 0);
    const total = upto.length == 0 ? 0 : upto[upto.length - 1];
    if (total == 0) {
        return match (net.wait(s, READ_LIMIT, -1)) {
            Ok(xs) => {
                const [next, places, ended] = arrive(ps, xs);
                closeAll(s, ended, 0);
                return serveLoop(s, handler, next, places, answered, limit);
            },
            Err(e) => {
                net.closeServer(s);
                return Err(e);
            },
        };
    }
    const date = httpDate(time.now());
    const outs = map(iota(total), (j) => {
        const i = owner(upto, j, 0, upto.length);
        const r = readies[i];
        const k = j - (upto[i] - counts[i]);
        const f = r.frames[k];
        const keep = f.fault == 0 && f.keep;
        const response = f.fault != 0 ? textResponse(f.fault, reason(f.fault)) : handler(requestAt(ps[changed[i]].buf, r.starts[k], r.ends[k], r.heads[k], f.length));
        return outOf(ps[changed[i]].id, responseBytes(response, keep, f.head, date), keep);
    });
    const [left, again] = afterAnswers(s, ps, changed, readies, outs);
    const all = answered + total;
    if (limit > 0 && all >= limit) {
        net.closeServer(s);
        return Ok(());
    }
    return serveLoop(s, handler, left, again, all, limit);
}

// the requests to the listener `l` (taken) answered by `handler`, until
// `limit` of them (0: no end): the server closed then
export action serveOn(l: net.Listener, handler: action (Request) => Response, limit: i64): Result<void, IoError> {
    return match (net.serverOf(l)) {
        Ok(s) => serveServer(s, handler, limit),
        Err(e) => Err(e),
    };
}

// the requests to the server `s` of `net` (taken: one of TLS, `https`)
// answered by `handler`, until `limit` of them (0: no end): a pure
// function applied to the requests ready all at once, by `map`, in
// parallel; an action (it may print, read files, call other services) to
// one request at a time, in the order they are ready (D352, D386)
export action serveServer(s: net.Server, handler: action (Request) => Response, limit: i64): Result<void, IoError> {
    if (isPure(handler)) {
        return serveLoop(s, handler, [], [], 0, limit);
    }
    return serveActionLoop(s, handler, [], [], 0, limit);
}

// the requests to `port` of every address of the machine answered by
// `handler`, a pure function or an action, with no end: under Linux a loop
// of events on each thread of the pool, each on a listener of its own of
// `port` (D374: the kernel shares the connections out among them,
// `SO_REUSEPORT`), the requests of two loops at the same time, as the
// actions of `mapParallel` (D373, D385); one loop under Windows, with one
// thread or for the port 0. A port that another socket listens to is
// refused first by a listener of its own (`AlreadyExists`): a second
// server, of this program or another, never shares it
export action serve(port: i64, handler: action (Request) => Response): Result<void, IoError> {
    const k = sysThreads();
    return match (net.listen("0.0.0.0", port)) {
        Ok(l) => {
            if (k <= 1 || port == 0 || sysPlatform() != 0) {
                return serveOn(l, handler, 0);
            }
            net.closeListener(l);
            return firstError(mapParallel(iota(k), (i) => serveShared(port, handler)), 0);
        },
        Err(e) => Err(e),
    };
}

// one of the loops of `serve` (D374), on a listener of its own of `port`
// (`Ok(0)` when it ends, which it does not)
action serveShared(port: i64, handler: action (Request) => Response): Result<i64, IoError> {
    const [l, code] = sysListenShared("0.0.0.0", port);
    if (code != 0) {
        sysCloseListener(l);
        return Err(ioError(code, `0.0.0.0:${port}`));
    }
    return match (serveOn(l, handler, 0)) {
        Ok(_) => Ok(0),
        Err(e) => Err(e),
    };
}

// the first error of the loops from `i` (each ends only on an error)
function firstError(rs: Result<i64, IoError>[n], i: i64): Result<void, IoError> {
    if (i >= rs.length) {
        return Ok(());
    }
    return match (rs[i]) {
        Ok(_) => firstError(rs, i + 1),
        Err(e) => Err(e),
    };
}
