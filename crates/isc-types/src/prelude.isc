        0x458897432107b0c8u64, 0x7ec12bebc9febde1u64,
        0x6f40f20501a5e7a7u64, 0x7e01dfdfa9979635u64,
        0x5900c19d9aeb1fb9u64, 0x4b34b319547944f7u64,
        0x4733ce17af227fc7u64, 0x55c3c27aa9fa9d93u64,
        0x71ec7cf2b1d0cc72u64, 0x560603f7765dc8eau64,
        0x5b2397288e40a38eu64, 0x7804cff92b7e3a55u64,
        0x48e945ba0b66e93fu64, 0x13370cc755fe9511u64,
        0x74a86f90123e41feu64, 0x51f1ae0bbcca881bu64,
        0x5d538c7341cb67feu64, 0x74c1580963d539afu64,
        0x4aa93d29016f8665u64, 0x43cde0078310faf3u64,
        0x77752ea8024c0a3cu64, 0x0616333f381b2b1eu64,
        0x5f90f22001d66e96u64, 0x3811c298f9af55b1u64,
        0x4c73f4e667debedeu64, 0x600e35472e25de28u64,
        0x7a532170a6313164u64, 0x3349eed849d6303fu64,
        0x61dc1ac084f42783u64, 0x42a18be03b11c033u64,
        0x4e49af006a5cec69u64, 0x1bb46fe695a7ccf5u64,
        0x7d42b19a43c7e0a8u64, 0x2c53e63dbc3fae55u64,
        0x64355ae1cfd31a20u64, 0x237651cafcffbeaau64,
        0x502aaf1b0ca8e1b3u64, 0x35f8416f30cc9888u64,
        0x402225af3d53e7c2u64, 0x5e603458f3d6e06du64,
        0x669d0918621fd937u64, 0x4a3386f4b957cd7bu64,
        0x52173a79e8197a92u64, 0x6e8f9f2a2ddfd796u64,
