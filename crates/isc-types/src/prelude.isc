// The text of the entry `e` (not 0): a part of the texts of its direction.
function $casePiece(e: i64, upper: boolean): string {
    const at = e >> 3;
    const end = at + (e & 7) + 1;
    return upper ? $upperTexts().slice(at, end) : $lowerTexts().slice(at, end);
