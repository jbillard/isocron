}

function $pointOut1(w0: u64, w1: u64, w2: u64, p: i64, mr: i64): [u64, u64, u64, i64, i64] {
    return [w0, $dropByte(w1, p) | (w2 << 56u64), w2 >> 8u64, mr - 1, mr - 9 - p];
}

function $pointOut2(w0: u64, w1: u64, w2: u64, p: i64, mr: i64): [u64, u64, u64, i64, i64] {
    return [w0, w1, $dropByte(w2, p), mr - 1, mr - 17 - p];
}

function $pointOutNone(w0: u64, w1: u64, w2: u64, mr: i64): [u64, u64, u64, i64, i64] {
    return [w0, w1, w2, mr, 0];
}

// The same where the first word has no point: sought in the second, then
// in the third (the first is where most numbers have it).
function $pointLater(w0: u64, w1: u64, w2: u64, mr: i64): [u64, u64, u64, i64, i64] {
    const dots = 0x2E2E2E2E2E2E2E2Eu64;
    const z1 = $bytesEqual(w1, dots);
    if (z1 != 0u64) {
        return $pointOut1(w0, w1, w2, $topByte(z1), mr);
    }
    const z2 = $bytesEqual(w2, dots);
    return z2 != 0u64 ? $pointOut2(w0, w1, w2, $topByte(z2), mr) : $pointOutNone(w0, w1, w2, mr);
}

// The first `c` bytes of `w`: all of them from 8 on, none below 1.
function $lowBytes(w: u64, c: i64): u64 {
    return c >= 8 ? w : c <= 0 ? 0u64 : w & ((1u64 << u64(c * 8)) - 1u64);
}

function $noDigits(): [u64, i64, u64] {
    return [0u64, 0, 1u64];
}

// The digits and the point of 21 to 40 bytes of `b` from `at`: a number
// written without exponent after zeros (`0.000…`): the point in its first
// 8 bytes and before its last 19 bytes, every other byte before those 19
// a `0`. Its integer is that of its last 19 bytes, digits (`$digitsRun`);
// the bytes before them: the first word without its point, then up to two
// words more (the second reaches the last 19 bytes when there are fewer
// than 16 bytes after the first word: only its bytes before them count).
function $mantissa40(b: u8[k], at: i64, mr: i64): [u64, i64, u64] {
    const zeros = 0x3030303030303030u64;
    const before = mr - 19;
    const w0 = readWord(b, at, 8);
    const z0 = $bytesEqual(w0, 0x2E2E2E2E2E2E2E2Eu64);
    const p = $topByte(z0);
    // the first word: its point taken out, then zeros, 7 of them or those
    // before the last 19 bytes
    const first = $lowBytes($dropByte(w0, p) ^ (zeros >> 8u64), before - 1);
    if (z0 == 0u64 || p >= before || first != 0u64) {
        return $noDigits();
    }
    const second = before > 8 ? $lowBytes(readWord(b, at + 8, 8) ^ zeros, before - 8) : 0u64;
    const third = before > 16 ? $lowBytes(readWord(b, at + 16, 8) ^ zeros, before - 16) : 0u64;
    const [h, bh] = $digits8(b, at + before, 3);
    const [m, bm] = $digits8(b, at + before + 3, 8);
    const [l, bl] = $digits8(b, at + before + 11, 8);
    return [(h * 100000000u64 + m) * 100000000u64 + l, mr - 1 - p, second | third | bh | bm | bl];
}

// The float nearest to `w` 10^`q`, with the sign `neg`: where `w` (up to
// 2^53) and the power of ten (up to 10^22) are floats without error, their
// quotient or their product, rounded once; else `$floatOf` (called).
function $floatScaled(b: u8[k], w: u64, q: i64, neg: boolean): [f64, u64] {
    if (w <= 9007199254740992u64 && q >= -22 && q <= 22) {
        const x = f64(i64(w));
        return [$signed(q < 0 ? x / $pow10F(0 - q) : x * $pow10F(q), neg), 0u64];
    }
    return $floatOf(b, w, q, neg);
}

// The same, the product of `$lemire` here too where it is needed; where
// it cannot tell, `$floatAny` reads the text `b` again.
function $decimalFloat(b: u8[k], w: u64, q: i64, neg: boolean): [f64, u64] {
    if (w <= 9007199254740992u64 && q >= -22 && q <= 22) {
        const x = f64(i64(w));
        return [$signed(q < 0 ? x / $pow10F(0 - q) : x * $pow10F(q), neg), 0u64];
    }
    return $productFloat(b, w, q, neg);
}

// The float nearest to `w` 10^`q` by the product of `$lemire`; where it
// cannot tell, `$floatAny` reads the text `b` again.
function $productFloat(b: u8[k], w: u64, q: i64, neg: boolean): [f64, u64] {
    const r = $decimalBits(w, q, true);
    return r == 0xFFFFFFFFFFFFFFFFu64 ? $floatAny(b) : [$bitsFloat(r | (neg ? 0x8000000000000000u64 : 0u64)), 0u64];
}

// The same, called: for the numbers that seldom need the product.
@cold
function $floatOf(b: u8[k], w: u64, q: i64, neg: boolean): [f64, u64] {
    return $productFloat(b, w, q, neg);
}

// The float that the bytes of `b` from `at` name, with the sign `neg`
// (`$named`); a word not 0 if they name none.
function $floatNamed(b: u8[k], at: i64, neg: boolean): [f64, u64] {
    const n = k - at;
    return n == 3 || n == 8 ? $named(readWord(b, at, n), n, neg) : $noFloat();
}

// The bits of the float nearest to `w` 10^`q`: zero and the infinity
// decided by `q` alone, as Rust's `compute_float`, else `$lemire`.
function $decimalBits(w: u64, q: i64, strict: boolean): u64 {
    return w == 0u64 || q < -342 ? 0u64 : q > 308 ? 0x7FF0000000000000u64 : $lemire(w, q, strict);
}

// The same, called: for `$floatAny`, which asks it up to three times. One
// function for each value of `strict`: compiled once, a function knows
// nothing of its callers (D611), and LLVM made one for the callers that
// give `true` when it saw them (17 instructions a text of 25 digits).
@cold
function $decimalBitsOf(w: u64, q: i64): u64 {
    return $decimalBits(w, q, true);
}

@cold
function $decimalBitsLoose(w: u64, q: i64): u64 {
    return $decimalBits(w, q, false);
}

// The bits of the float nearest to `w` 10^`q` (`w` not 0, `q` from -342
// to 308) by the algorithm of Eisel and Lemire (D. Lemire, "Number Parsing
// at a Gigabyte per Second"), as Rust's library has it (`compute_float`):
// `w` from its highest bit times the high 64 bits of the 128 of 5^`q`
// (`$pow5T`), times the low 64 too when the 9 bits after the 55 kept are
// all ones; the bits kept rounded to 53 (fewer for a subnormal float), a
// half to the even float where the product is exact. All ones (the bits of
// no number that this function gives) where 128 bits cannot tell and
// `strict`; else the float they give, which may then be the one next to
// the nearest.
function $lemire(w: u64, q: i64, strict: boolean): u64 {
    const lz = leadingZeros(w);
    const wn = w << u64(lz);
    const [t1, t0] = $pow5T(q);
    const hi1 = $mulHigh(wn, t1);
    const lo1 = wn * t1;
    const second = (hi1 & 0x1FFu64) == 0x1FFu64 ? $mulHigh(wn, t0) : 0u64;
    const lo = lo1 + second;
    const hi = hi1 + (second > lo ? 1u64 : 0u64);
    if (strict && lo == 0xFFFFFFFFFFFFFFFFu64 && (q < -27 || q > 55)) {
        return 0xFFFFFFFFFFFFFFFFu64;
    }
    const upper = i64(hi >> 63u64);
    const shift = u64(upper + 9);
    const m = hi >> shift;
    const p2 = ((q * 217706) >> 16) + 1086 + upper - lz;
    if (p2 <= 0) {
        // a subnormal float; zero from 64 bits below the least exponent
        const s = m >> u64(1 - p2);
        return p2 <= -63 ? 0u64 : (s + (s & 1u64)) >> 1u64;
    }
    // a half exactly (the product has no bit below those kept): not up
    const tie = lo <= 1u64 && q >= -4 && q <= 23 && (m & 3u64) == 1u64 && (m << shift) == hi;
    const m1 = tie ? m - 1u64 : m;
    const m2 = (m1 + (m1 & 1u64)) >> 1u64;
    // the 53 bits all ones rounded up: the next power of two
    const carry = m2 >= 0x20000000000000u64;
    const p3 = p2 + (carry ? 1 : 0);
    return p3 >= 2047 ? 0x7FF0000000000000u64 : (carry ? 0u64 : m2 & 0xFFFFFFFFFFFFFu64) | (u64(p3) << 52u64);
}

// The index of the first byte of `b` from `at` that is no digit (its
// length if none).
function $digitsEnd(b: u8[k], at: i64): i64 {
    const d = findIndex(b.slice(at, k), (c) => c < 48u8 || c > 57u8);
    return d < 0 ? k : at + d;
}

// The number of `0` at the start of the bytes `a` to `z` of `b`.
function $zerosFrom(b: u8[k], a: i64, z: i64): i64 {
    const d = findIndex(b.slice(a, z), (c) => c != 48u8);
    return d < 0 ? z - a : d;
}

// The integer of the `n` digits (0 to 19) of `b` from `o`, 8 a word.
function $digitsRun(b: u8[k], o: i64, n: i64): u64 {
    if (n <= 8) {
        const [v, x] = n >= 1 ? $digits8(b, o, n) : $noDigit();
        return v;
    }
    const [h, bh] = $digits8(b, o, 8);
    if (n <= 16) {
        const [l, bl] = $digits8(b, o + 8, n - 8);
        return h * $pow10W(n - 8) + l;
    }
    const [m, bm] = $digits8(b, o + 8, 8);
    const [l, bl] = $digits8(b, o + 16, n - 16);
    return (h * 100000000u64 + m) * $pow10W(n - 16) + l;
}

function $noDigit(): [u64, u64] {
    return [0u64, 0u64];
}

// The index in the text of its digit `i` (from 0), the digits starting at
// `at` and the point, if any, at `i1`.
function $digitAt(at: i64, i1: i64, i: i64): i64 {
    return at + i >= i1 ? at + i + 1 : at + i;
}

// Any text, as Rust's library reads it (`dec2flt`): a sign; digits, a
// point, digits (one digit at least); `e` or `E`, a sign, digits (one at
// least) up to the end; without a digit before the exponent, a name. The
// exponent stops growing from 65536 on, as Rust's (the digits after are
// read and not counted). The number is then `w` 10^`q`, `w` the digits
// from the first that is not zero, the first 19 of them when there are
// more: in that case the float is that of `w` if `w + 1` has the same one,
// since the number is between them; else it is that of `w` or the one
// after (the two are less than a float apart), and the digits themselves
// are compared with their middle (`$midOrder`). Where `$lemire` cannot
// tell, the float is sought from the one it gives (`$settle`).
@cold
function $floatAny(b: u8[k]): [f64, u64] {
    const c = k > 0 ? b[0] : 0u8;
    const neg = c == 45u8;
    const at = neg || c == 43u8 ? 1 : 0;
    const sign = neg ? 0x8000000000000000u64 : 0u64;
    const i1 = $digitsEnd(b, at);
    const dot = i1 < k && b[i1] == 46u8;
    const i2 = dot ? $digitsEnd(b, i1 + 1) : i1;
    const l1 = i1 - at;
    const nd = i2 - at - (dot ? 1 : 0);
    if (nd == 0) {
        return $floatNamed(b, at, neg);
    }
    const hasE = i2 < k && (b[i2] | 32u8) == 101u8;
    const c2 = hasE && i2 + 1 < k ? b[i2 + 1] : 0u8;
    const eneg = c2 == 45u8;
    const j = i2 + (hasE ? 1 : 0) + (eneg || c2 == 43u8 ? 1 : 0);
    const j2 = hasE ? $digitsEnd(b, j) : i2;
    if (j2 != k || (hasE && j2 == j)) {
        return $noFloat();
    }
    const ev = fold(b.slice(j, j2), 0, (e, d) => e < 65536 ? e * 10 + i64(d) - 48 : e);
    const ex = eneg ? 0 - ev : ev;
    // the zeros before the first other digit are not counted: those before
    // the point, and those after it when there is nothing else before
    const z1 = $zerosFrom(b, at, i1);
    const lead = z1 == l1 && dot ? l1 + $zerosFrom(b, i1 + 1, i2) : z1;
    const sig = nd - lead;
    const many = sig > 19;
    // the digits read (19 at most): those before the point, those after it
    const count = many ? 19 : sig;
    const n1 = lead >= l1 ? 0 : l1 - lead < count ? l1 - lead : count;
    const n2 = count - n1;
    const w = $digitsRun(b, at + lead, n1) * $pow10(n2) + $digitsRun(b, i1 + 1 + (lead > l1 ? lead - l1 : 0), n2);
    const q = l1 - (many ? lead + 19 : nd) + ex;
    const r = $decimalBitsOf(w, q);
    const r1 = many ? $decimalBitsOf(w + 1u64, q) : r;
    if (r == 0xFFFFFFFFFFFFFFFFu64) {
        return [$bitsFloat($settle(b, at, i1, i2, nd, lead, l1 + ex, $decimalBitsLoose(w, q)) | sign), 0u64];
    }
    if (r == r1 || r >= 0x7FF0000000000000u64) {
        return [$bitsFloat(r | sign), 0u64];
    }
    const o = $midOrder(b, at, i1, i2, nd, lead, l1 + ex, r);
    return [$bitsFloat((o > 0 || (o == 0 && (r & 1u64) == 1u64) ? r + 1u64 : r) | sign), 0u64];
}

// The exact comparison of a decimal with the middle of two floats, where
// the product of 128 bits cannot round: in scalars, without memory. The
// decimal is the `nd` digits of `b` (`$digitAt`: from `at`, the point at
// `i1`, their end at `i2`), the first `lead` of them zeros, `p` of them
// before the point once the exponent is counted (`p` below 0, or above
// `nd`: zeros there). The integers of the comparison are registers of
// 1088 bits, 17 words, the lowest first.
type $Wide = [u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64, u64];

// One word of a product: `w` times `m` plus `c`; [its low word, the carry].
function $wideStep(w: u64, m: u64, c: u64): [u64, u64] {
    const lo = w * m;
    const s = lo + c;
    return [s, $mulHigh(w, m) + (s < lo ? 1u64 : 0u64)];
}

// `x` times `m` plus `c`: [its 17 low words, the word above them].
function $wideMul(x: $Wide, m: u64, c: u64): [$Wide, u64] {
    const [x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11, x12, x13, x14, x15, x16] = x;
    const [a0, c0] = $wideStep(x0, m, c);
    const [a1, c1] = $wideStep(x1, m, c0);
    const [a2, c2] = $wideStep(x2, m, c1);
    const [a3, c3] = $wideStep(x3, m, c2);
    const [a4, c4] = $wideStep(x4, m, c3);
    const [a5, c5] = $wideStep(x5, m, c4);
    const [a6, c6] = $wideStep(x6, m, c5);
    const [a7, c7] = $wideStep(x7, m, c6);
    const [a8, c8] = $wideStep(x8, m, c7);
    const [a9, c9] = $wideStep(x9, m, c8);
    const [a10, c10] = $wideStep(x10, m, c9);
    const [a11, c11] = $wideStep(x11, m, c10);
    const [a12, c12] = $wideStep(x12, m, c11);
    const [a13, c13] = $wideStep(x13, m, c12);
    const [a14, c14] = $wideStep(x14, m, c13);
    const [a15, c15] = $wideStep(x15, m, c14);
    const [a16, c16] = $wideStep(x16, m, c15);
    return [[a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11, a12, a13, a14, a15, a16] as const, c16];
}

// The word `i` of `n` times 2^`s` (`s` not negative).
function $wideWord(n: u64, s: i64, i: i64): u64 {
    const d = s - 64 * i;
    return d >= 64 || d <= -64 ? 0u64 : d >= 0 ? n << u64(d) : n >> u64(0 - d);
}

// The 1088 low bits of `n` times 2^`s`.
function $wideOf(n: u64, s: i64): $Wide {
    return [$wideWord(n, s, 0), $wideWord(n, s, 1), $wideWord(n, s, 2), $wideWord(n, s, 3), $wideWord(n, s, 4),
        $wideWord(n, s, 5), $wideWord(n, s, 6), $wideWord(n, s, 7), $wideWord(n, s, 8), $wideWord(n, s, 9),
        $wideWord(n, s, 10), $wideWord(n, s, 11), $wideWord(n, s, 12), $wideWord(n, s, 13), $wideWord(n, s, 14),
        $wideWord(n, s, 15), $wideWord(n, s, 16)];
}

function $wideZero(x: $Wide): boolean {
    const [x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11, x12, x13, x14, x15, x16] = x;
    return (x0 | x1 | x2 | x3 | x4 | x5 | x6 | x7 | x8 | x9 | x10 | x11 | x12 | x13 | x14 | x15 | x16) == 0u64;
}

// The order of two words, then of the words below them (`rest`).
function $wordOrder(a: u64, b: u64, rest: i64): i64 {
    return a < b ? -1 : a > b ? 1 : rest;
}

// The order of two registers: -1, 0 or 1.
function $wideOrder(x: $Wide, y: $Wide): i64 {
    const [x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11, x12, x13, x14, x15, x16] = x;
    const [y0, y1, y2, y3, y4, y5, y6, y7, y8, y9, y10, y11, y12, y13, y14, y15, y16] = y;
    const low = $wordOrder(x7, y7, $wordOrder(x6, y6, $wordOrder(x5, y5, $wordOrder(x4, y4,
        $wordOrder(x3, y3, $wordOrder(x2, y2, $wordOrder(x1, y1, $wordOrder(x0, y0, 0))))))));
    return $wordOrder(x16, y16, $wordOrder(x15, y15, $wordOrder(x14, y14, $wordOrder(x13, y13, $wordOrder(x12, y12,
        $wordOrder(x11, y11, $wordOrder(x10, y10, $wordOrder(x9, y9, $wordOrder(x8, y8, low)))))))));
}

// The integer of the `c` digits (19 at most) from the digit `i`; a digit
// before the first or after the last is a zero.
function $digitsAround(b: u8[k], at: i64, i1: i64, nd: i64, i: i64, c: i64): u64 {
    return fold(iota(c), 0u64, (a, t) => a * 10u64 + (i + t >= 0 && i + t < nd ? u64(b[$digitAt(at, i1, i + t)] - 48u8) : 0u64));
}

// A digit from the digit `i` on is not zero.
function $digitsLeft(b: u8[k], at: i64, i1: i64, i2: i64, nd: i64, i: i64): boolean {
    const from = i > 0 ? i : 0;
    const a = $digitAt(at, i1, from);
    return from >= nd ? false
        : a < i1 ? $zerosFrom(b, a, i1) < i1 - a || (i2 > i1 && $zerosFrom(b, i1 + 1, i2) < i2 - i1 - 1)
        : $zerosFrom(b, a, i2) < i2 - a;
}

// The digits `i` to `end` (not included) put after those of `x`: `x`
// times a power of ten plus up to 19 digits, each turn.
function $wideDigits(b: u8[k], at: i64, i1: i64, nd: i64, x: $Wide, i: i64, end: i64): $Wide {
    if (i >= end) {
        return x;
    }
    const c = end - i < 19 ? end - i : 19;
    const [y, over] = $wideMul(x, $pow10(c), $digitsAround(b, at, i1, nd, i, c));
    return $wideDigits(b, at, i1, nd, y, i + c, end);
}

// The order of the digits after the point, from the digit `i`, and of a
// fraction `r` (of 2^1088): 19 digits of each a turn, those of the
// fraction the word above the register times 10^19; at the end of the
// digits, or of the fraction (a fraction of a power of two ends), what is
// left of the other decides.
function $fractionOrder(b: u8[k], at: i64, i1: i64, i2: i64, nd: i64, r: $Wide, i: i64): i64 {
    if (i >= nd) {
        return $wideZero(r) ? 0 : -1;
    }
    if ($wideZero(r)) {
        return $digitsLeft(b, at, i1, i2, nd, i) ? 1 : 0;
    }
    const [y, m] = $wideMul(r, 10000000000000000000u64, 0u64);
    const v = $digitsAround(b, at, i1, nd, i, 19);
    return v < m ? -1 : v > m ? 1 : $fractionOrder(b, at, i1, i2, nd, y, i + 19);
}

// The order (-1, 0, 1) of the decimal and of the middle of the float of
// the bits `c` (not negative, below the infinity) and of the float after
// it: with `m` 2^`e` that float, the middle is `n` 2^(`e` - 1), `n` = 2
// `m` + 1. An integer (`e` - 1 not negative): the digits before the point
// made an integer (below 10^327: they are not compared for more than the
// floats hold) and compared with it, then the digits after the point.
// Else the digits before the point (19 at most: the middle is below 2^54)
// against its integer part, then those after the point against its
// fraction.
function $midOrder(b: u8[k], at: i64, i1: i64, i2: i64, nd: i64, lead: i64, p: i64, c: u64): i64 {
    const be = i64(c >> 52u64);
    const f = c & 0xFFFFFFFFFFFFFu64;
    const n = 2u64 * (be == 0 ? f : f | 0x10000000000000u64) + 1u64;
    const e = (be == 0 ? -1074 : be - 1075) - 1;
    if (e >= 0) {
        if (p - lead > 327) {
            return 1;
        }
        const o = $wideOrder($wideDigits(b, at, i1, nd, $wideOf(0u64, 0), lead, p), $wideOf(n, e));
        return o != 0 ? o : $digitsLeft(b, at, i1, i2, nd, p) ? 1 : 0;
    }
    if (p - lead > 19) {
        return 1;
    }
    const whole = e > -64 ? n >> u64(0 - e) : 0u64;
    const v = p > lead ? $digitsAround(b, at, i1, nd, lead, p - lead) : 0u64;
    return v < whole ? -1 : v > whole ? 1 : $fractionOrder(b, at, i1, i2, nd, $wideOf(n, 1088 + e), p);
}

// From the float of the bits `c`, the float nearest to the decimal: the
// one after while the decimal is above their middle, the one before while
// it is below; on a middle, the float whose bits are even.
function $settle(b: u8[k], at: i64, i1: i64, i2: i64, nd: i64, lead: i64, p: i64, c: u64): u64 {
    const up = c < 0x7FF0000000000000u64 ? $midOrder(b, at, i1, i2, nd, lead, p, c) : -1;
    if (up > 0 || (up == 0 && (c & 1u64) == 1u64)) {
        return $settle(b, at, i1, i2, nd, lead, p, c + 1u64);
    }
    const down = c > 0u64 ? $midOrder(b, at, i1, i2, nd, lead, p, c - 1u64) : 1;
    if (down < 0 || (down == 0 && (c & 1u64) == 1u64)) {
        return $settle(b, at, i1, i2, nd, lead, p, c - 1u64);
    }
    return c;
}

// The text of an integer written in Isocron (D588, SPEC section 17, order
// 2): `toString` of an `i64` or a `u64` that no fusion of the code
// generator writes in place (`padStart`, a concatenation: D348, D359),
// lowered once when a program writes one and called by the code generator
// in place of the runtime's `isc_to_string_i64`.
function $rtIntText(x: i64): string {
    const neg = x < 0;
    return $digitsText(neg ? 0u64 - u64(x) : u64(x), neg);
}

function $rtUintText(x: u64): string {
    return $digitsText(x, false);
}

// The digits of `v`, a `-` before them when `neg`: the text of the last
// bytes of the words of `$rtDigitWords`, written into its block
// (`$textTail`).
function $digitsText(v: u64, neg: boolean): string {
    const [hi, mid, lo, n] = $rtDigitWords(v);
    return $textTail(hi, mid, lo, n, neg);
}

// The digits of `v` in three words and their number: the number from the
// bits of `v` (1233 / 4096 below log10 2) and one power of ten; the last 8
// digits, the 8 before and the first 4, only those the number has (a word
// of 4 for a part below 10^4). Lowered once too for the padded text of an
// integer, which the code generator writes from these words into the block
// of the padded text (`toString(x).padStart(n, "0")`, D348, D606).
function $rtDigitWords(v: u64): [u64, u64, u64, i64] {
    const powers = [1u64, 10u64, 100u64, 1000u64, 10000u64, 100000u64, 1000000u64, 10000000u64,
        100000000u64, 1000000000u64, 10000000000u64, 100000000000u64, 1000000000000u64,
        10000000000000u64, 100000000000000u64, 1000000000000000u64, 10000000000000000u64,
        100000000000000000u64, 1000000000000000000u64, 10000000000000000000u64];
    const t = ((64 - leadingZeros(v | 1u64)) * 1233) >> 12;
    const n = t + ((v | 1u64) >= powers[t] ? 1 : 0);
    const lo = v < 10000u64 ? $asciiWord4(v) : v < 100000000u64 ? $asciiWord8(v) : $asciiWord8(v % 100000000u64);
    const h = v / 100000000u64;
    const mid = v < 100000000u64 ? 0u64 : h < 10000u64 ? $asciiWord4(h) : $asciiWord8(h % 100000000u64);
    const hi = v < 10000000000000000u64 ? 0u64 : $asciiWord4(v / 10000000000000000u64);
    return [hi, mid, lo, n];
}

// The 4 digits of `v` (below 10^4) at the end of a word of 8 (`0`s before
// them): its two pairs of digits from the table of `$pair`.
function $asciiWord4(v: u64): u64 {
    const q = v / 100u64;
    return ((($pair(q) | ($pair(v - q * 100u64) << 16u64))) << 32u64) | 0x30303030u64;
}

// The 8 digits of `v` (below 10^8) in a word, the highest at the lowest
// place, as ASCII: its four pairs of digits, their quotients by 100, 10^4
// and 10^6 made at once (not one after the other: a short chain of
// products), each pair read from a table (D588).
function $asciiWord8(v: u64): u64 {
    const q1 = v / 100u64;
    const q2 = v / 10000u64;
    const q3 = v / 1000000u64;
    return $pair(q3) | ($pair(q2 - q3 * 100u64) << 16u64) | ($pair(q1 - q2 * 100u64) << 32u64) | ($pair(v - q1 * 100u64) << 48u64);
}

// The two ASCII digits of `r` (below 100), the tens at the lowest place:
// a table of 256 pairs (those past 99 never read), so that its index,
// `r & 255` twice, is inside it whatever `r` and its check of bounds goes
// at compilation.
function $pair(r: u64): u64 {
    return readWord(bytes(""), i64(r & 255u64) * 2, 2);
}

// `trim(s)`, `trimStart(s)` and `trimEnd(s)` written in Isocron (D590): the
// white space of Unicode at the ends removed, as Rust's
// `char::is_whitespace` (that the runtime used): U+0009 to U+000D, U+0020,
// U+0085, U+00A0, U+1680, U+2000 to U+200A, U+2028, U+2029, U+202F, U+205F
// and U+3000. The bytes of ASCII first (`findIndex`: it stops at the first
// that is not white space); a byte above 0x7F there, the start or the end
// of a character of several bytes, goes to the rarer path that reads the
// characters (`@cold`). The text kept, copied by `slice`.
function trim(s: string): string {
    const b = bytes(s);
    const a = $spacesFrom(b);
    return s.slice(a, $spacesBack(b, a));
}

function trimStart(s: string): string {
    const b = bytes(s);
    return s.slice($spacesFrom(b), b.length);
}

function trimEnd(s: string): string {
    const b = bytes(s);
    return s.slice(0, $spacesBack(b, 0));
}

// The byte of ASCII `c` is white space.
function $asciiSpace(c: u8): boolean {
    return c == 32u8 || (c >= 9u8 && c <= 13u8);
}

// The index of the first character of `b` that is not white space (its
// length if none).
function $spacesFrom(b: u8[k]): i64 {
    const i = findIndex(b, (c) => !$asciiSpace(c));
    return i < 0 ? k : b[i] < 128u8 ? i : $spacesFromSlow(b, i);
}

// From `p`, the first character that is not white space, character by
// character.
@cold
function $spacesFromSlow(b: u8[k], p: i64): i64 {
    const w = $spaceWidth(b, p);
    return w == 0 ? p : $spacesFromSlow(b, p + w);
}

// One past the last character of `b` that is not white space, not below
// `low` (`low` if none from there).
function $spacesBack(b: u8[k], low: i64): i64 {
    const d = findIndex(iota(k - low), (j) => !$asciiSpace(b[k - 1 - j]));
    const q = k - 1 - d;
    return d < 0 ? low : b[q] < 128u8 ? q + 1 : $spacesBackSlow(b, low, q + 1);
}

// Below `end`, one past the last character that is not white space, not
// below `low`, character by character from the end.
@cold
function $spacesBackSlow(b: u8[k], low: i64, end: i64): i64 {
    const start = $charStart(b, end - 1, low);
    return end <= low ? low : $spaceWidth(b, start) == end - start ? $spacesBackSlow(b, low, start) : end;
}

// The first byte of the character whose byte `p` is, not below `low` (the
// bytes `10xxxxxx` continue a character).
function $charStart(b: u8[k], p: i64, low: i64): i64 {
    const c1 = p > low && (b[p] & 192u8) == 128u8;
    const c2 = c1 && p - 1 > low && (b[p - 1] & 192u8) == 128u8;
    const c3 = c2 && p - 2 > low && (b[p - 2] & 192u8) == 128u8;
    return p - (c3 ? 3 : c2 ? 2 : c1 ? 1 : 0);
}

// The bytes of the character of white space at `p` (0 if it is not one, or
// if `p` is the end).
function $spaceWidth(b: u8[k], p: i64): i64 {
    const c = p < k ? b[p] : 0u8;
    const x = p + 1 < k ? b[p + 1] : 0u8;
    const y = p + 2 < k ? b[p + 2] : 0u8;
    return $asciiSpace(c) ? 1
        : c == 0xC2u8 ? (x == 0x85u8 || x == 0xA0u8 ? 2 : 0)
        : c == 0xE1u8 ? (x == 0x9Au8 && y == 0x80u8 ? 3 : 0)
        : c == 0xE2u8 ? ((x == 0x80u8 && ((y >= 0x80u8 && y <= 0x8Au8) || y == 0xA8u8 || y == 0xA9u8 || y == 0xAFu8)) || (x == 0x81u8 && y == 0x9Fu8) ? 3 : 0)
        : c == 0xE3u8 ? (x == 0x80u8 && y == 0x80u8 ? 3 : 0)
        : 0;
}

// ---------------------------------------------------------------------
// `indexOf` and `includes` (D596): the search of a text in a text.
//
// A byte: `findIndex`. More: in a long text, the places of one byte of the
// needle first, while it is rare there; then, and at once in a short text,
// the places where two bytes of the needle both are (two reads by vectors);
// at each, its bytes compared, as one or two words up to 16 bytes, by
// vectors beyond. The two bytes: the last one, and the
// first one; when they are the same byte, the last byte that differs from
// it instead (`$filterAt`: in a text of one byte repeated, a needle of that
// byte but one is then never a candidate). A text that repeats otherwise
// would cost the length of the needle at each place: past a budget of bytes
// compared in vain, the search of Crochemore and Perrin (two-way) takes
// over, linear in the lengths whatever the texts.

// `s.indexOf(t)`: the byte index of the first `t` in `s`, -1 if none (0 for
// an empty `t`).
function indexOf(s: string, t: string): i64 {
    return $find(bytes(s), bytes(t));
}

// `s.includes(t)`: `t` is somewhere in `s`.
function includes(s: string, t: string): boolean {
    return $find(bytes(s), bytes(t)) >= 0;
}

// The first byte `c` of `b`, -1 if none.
function $findByte(b: u8[k], c: u8): i64 {
    return findIndex(b, (x) => x == c);
}

// The first index where `h` holds `first` and `t` holds `last`.
function $pairAt(h: u8[n], t: u8[n], first: u8, last: u8): i64 {
    return findIndex(iota(n), (j) => h[j] == first && t[j] == last);
}

// The bytes of `p` (2 to 16) are those of `b` from `i`.
function $sameWords(b: u8[k], i: i64, p: u8[m]): boolean {
    return m <= 8 ? readWord(b, i, m) == readWord(p, 0, m)
        : readWord(b, i, 8) == readWord(p, 0, 8) && readWord(b, i + m - 8, 8) == readWord(p, m - 8, 8);
}

// The first index from `from` where `p` differs from `b` at `i`, -1 if none.
function $mismatch(b: u8[k], i: i64, p: u8[m], from: i64): i64 {
    const at = i + from;
    const d = findIndex(iota(m - from), (j) => b[j + at] != p[j + from]);
    return d < 0 ? -1 : d + from;
}

// The place of the byte of `p` (2 bytes or more) tested with its last one:
// its first byte; when that is the last byte too, the last byte that
// differs from it (0 if none: one byte repeated).
function $filterAt(p: u8[m]): i64 {
    const last = p[m - 1];
    const d = p[0] != last ? -1 : findIndex(iota(m - 1), (j) => p[m - 2 - j] != last);
    return d < 0 ? 0 : m - 2 - d;
}

// The first place of `p` (2 to 16 bytes) in `b` from `at`: the places where
// its byte `x` (at `o`) and its last byte are, then its bytes compared as
// words.
function $findShort(b: u8[k], p: u8[m], o: i64, x: u8, last: u8, at: i64): i64 {
    const d = at + m > k ? -1 : $pairAt(b.slice(at + o, k - m + 1 + o), b.slice(at + m - 1, k), x, last);
    return d < 0 ? -1 : $sameWords(b, at + d, p) ? at + d : $findShort(b, p, o, x, last, at + d + 1);
}

// The first place of `p` (more than 16 bytes) in `b` from `at`, the same
// way, its bytes compared by vectors; `spent` the bytes compared in vain:
// past 8 for each byte passed, the search of linear time takes over (a text
// of one byte repeated and a needle of it but one byte: each place would
// cost the length of the needle).
function $findLong(b: u8[k], p: u8[m], o: i64, x: u8, last: u8, at: i64, spent: i64): i64 {
    const d = at + m > k ? -1 : $pairAt(b.slice(at + o, k - m + 1 + o), b.slice(at + m - 1, k), x, last);
    const i = at + d;
    const w = d < 0 ? -1 : $mismatch(b, i, p, 0);
    return d < 0 ? -1 : w < 0 ? i : spent + w > 8 * i + 4096 ? $twoWay(b, p, i + 1) : $findLong(b, p, o, x, last, i + 1, spent + w + 64);
}

// ---- the search of Crochemore and Perrin (two-way): linear time, no memory

// The maximal suffix of `p` for the order of the bytes (`rev`: reversed):
// [its start - 1, its period].
function $maxSuffix(p: u8[m], rev: boolean, ms: i64, j: i64, q: i64, per: i64): [i64, i64] {
    if (j + q >= m) {
        return [ms, per];
    }
    const a = p[j + q];
    const c = p[ms + q];
    const less = rev ? c < a : a < c;
    return less ? $maxSuffix(p, rev, ms, j + q, 1, j + q - ms)
        : a == c ? (q != per ? $maxSuffix(p, rev, ms, j, q + 1, per) : $maxSuffix(p, rev, ms, j + per, 1, per))
        : $maxSuffix(p, rev, j, j + 1, 1, 1);
}

// From `i` down to above `low`, the last index where `p` differs from `b`
// at `j`; `low` if none.
function $mismatchBack(b: u8[k], j: i64, p: u8[m], i: i64, low: i64): i64 {
    return i <= low ? low : p[i] != b[j + i] ? i : $mismatchBack(b, j, p, i - 1, low);
}

// `p` whose start repeats with the period `per`: the part already known
// equal (`memory`) is not compared again.
function $twoWayPeriodic(b: u8[k], p: u8[m], ell: i64, per: i64, j: i64, memory: i64): i64 {
    if (j + m > k) {
        return -1;
    }
    const from = (ell > memory ? ell : memory) + 1;
    const x = $mismatch(b, j, p, from);
    if (x >= 0) {
        return $twoWayPeriodic(b, p, ell, per, j + x - ell, -1);
    }
    const y = $mismatchBack(b, j, p, ell, memory);
    return y <= memory ? j : $twoWayPeriodic(b, p, ell, per, j + per, m - per - 1);
}

function $twoWayPlain(b: u8[k], p: u8[m], ell: i64, per: i64, j: i64): i64 {
    if (j + m > k) {
        return -1;
    }
    const x = $mismatch(b, j, p, ell + 1);
    if (x >= 0) {
        return $twoWayPlain(b, p, ell, per, j + x - ell);
    }
    const y = $mismatchBack(b, j, p, ell, -1);
    return y < 0 ? j : $twoWayPlain(b, p, ell, per, j + per);
}

// The first place of `p` in `b` from `at`, in time linear in their lengths.
@cold
function $twoWay(b: u8[k], p: u8[m], at: i64): i64 {
    const [i1, p1] = $maxSuffix(p, false, -1, 0, 1, 1);
    const [i2, p2] = $maxSuffix(p, true, -1, 0, 1, 1);
    const ell = i1 > i2 ? i1 : i2;
    const per = i1 > i2 ? p1 : p2;
    // the start of `p`, up to `ell`, is found again `per` further
    const periodic = per + ell + 1 <= m && findIndex(iota(ell + 1), (t) => p[t] != p[t + per]) < 0;
    const side = ell + 1 > m - ell - 1 ? ell + 1 : m - ell - 1;
    return periodic ? $twoWayPeriodic(b, p, ell, per, at, -1) : $twoWayPlain(b, p, ell, side + 1, at);
}

function $find(b: u8[k], p: u8[m]): i64 {
    return m == 0 ? 0 : m > k ? -1 : m == 1 ? $findByte(b, p[0]) : $findFrom(b, p, $filterAt(p));
}

// In a long text, first by one byte of the needle alone (`$findOne`): a
// rare byte passes the text at the speed of the search of a byte. A short
// text: by two bytes at once, one pass.
function $findFrom(b: u8[k], p: u8[m], o: i64): i64 {
    return k > 256 ? $findOne(b, p, o, p[o], p[m - 1], 0, 0) : $findPairs(b, p, o, p[o], p[m - 1], 0);
}

function $findPairs(b: u8[k], p: u8[m], o: i64, x: u8, last: u8, at: i64): i64 {
    return m <= 16 ? $findShort(b, p, o, x, last, at) : $findLong(b, p, o, x, last, at, 0);
}

// The first place of `p` in `b` from `at` by its byte `x` (at `o`) alone,
// then its last byte and the others. `misses`: the places where `x` was
// and `p` was not; more than 8 and one for 32 bytes passed, `x` is not
// rare in this text: by two bytes at once from there.
function $findOne(b: u8[k], p: u8[m], o: i64, x: u8, last: u8, at: i64, misses: i64): i64 {
    const d = at + m > k ? -1 : $findByte(b.slice(at + o, k - m + 1 + o), x);
    const i = at + d;
    return d < 0 ? -1
        : b[i + m - 1] == last && $sameAt(b, i, p) ? i
        : misses * 32 > i + 256 ? $findPairs(b, p, o, x, last, i + 1)
        : $findOne(b, p, o, x, last, i + 1, misses + 1);
}

// The bytes of `p` (2 or more) are those of `b` from `i`.
function $sameAt(b: u8[k], i: i64, p: u8[m]): boolean {
    return m <= 16 ? $sameWords(b, i, p) : $mismatch(b, i, p, 0) < 0;
}

// The text of a float written in Isocron (SPEC section 17, order 2):
// `toString` and `print` of a `f64` or of a `f32`, lowered once when a
// program writes one and called by the code generator in place of the
// runtime's `isc_to_string_f64`, `isc_to_string_f32`, `isc_print_f64` and
// `isc_print_f32` (for `print`, its text in a buffer of the stack). The shortest decimal that
// reads back to the float (Schubfach: R. Giulietti, "The Schubfach way to
// render doubles", as `f64text` of the interpreter, D467), written as
// Rust's `Display` writes it: no exponent, `-0`, `NaN`, `inf`, `-inf`.
// An integer below 2^53 (2^24 for a `f32`) is its own digits, written as
// the integer (`$digitsText`), zero too; the other floats of the common
// kind have 16 or 17 digits (7 to 9 for a `f32`), made 17 by a power of
// ten: the first, then two words of 8 (`$asciiWord8`), laid out by
// `$decimalText`. What is not a number and the subnormal floats, the rare
// ones, out of the way (`$rareFloatText`, `@cold`).
function $rtF64Text(x: f64): string {
    const bits = $floatBits(x);
    const neg = (bits >> 63u64) != 0u64;
    const t = bits & 0xFFFFFFFFFFFFFu64;
    const bq = i64((bits >> 52u64) & 0x7FFu64);
    const c = t | 0x10000000000000u64;
    // the binary digits of `c` after the point
    const up = 1075 - bq;
    if (bq == 0 || bq == 2047) {
        return bq == 0 && t == 0u64 ? $digitsText(0u64, neg) : $rareF64Text(t, bq != 0, neg);
    }
    if (up > 0 && up < 53 && (c & ((1u64 << u64(up)) - 1u64)) == 0u64) {
        return $digitsText(c >> u64(up), neg);
    }
    return $shortestText(0 - up, c, t != 0u64 || bq == 1, neg);
}

// The text of the shortest decimal that reads back to the double `c`
// 2^`q` (`$shortest`): its 16 or 17 digits made 17. For `$rtF64Text`, and
// for `toFixed` from 1e21 on (`$fixedRest`), which so has no use of the
// whole function.
function $shortestText(q: i64, c: u64, regular: boolean, neg: boolean): string {
    const [f, k] = $shortest(q, c, regular);
    const wide = f >= 10000000000000000u64;
    return $digits17Text(wide ? f : f * 10u64, k + (wide ? 17 : 16), neg);
}

// The same for a `f32`: its bits in the low half of the word, 24 of them
// its digits, and the reading back that of a `f32`.
function $rtF32Text(x: f32): string {
    const bits = $floatBits(x);
    const neg = (bits >> 31u64) != 0u64;
    const t = bits & 0x7FFFFFu64;
    const bq = i64((bits >> 23u64) & 0xFFu64);
    const c = t | 0x800000u64;
    const up = 150 - bq;
    if (bq == 0 || bq == 255) {
        return bq == 0 && t == 0u64 ? $digitsText(0u64, neg) : $rareF32Text(t, bq != 0, neg);
    }
    if (up > 0 && up < 24 && (c & ((1u64 << u64(up)) - 1u64)) == 0u64) {
        return $digitsText(c >> u64(up), neg);
    }
    const [f, k] = $shortest(0 - up, c, t != 0u64 || bq == 1);
    const n = f < 10000000u64 ? 7 : f < 100000000u64 ? 8 : 9;
    return $digits17Text(f * (n == 7 ? 10000000000u64 : n == 8 ? 1000000000u64 : 100000000u64), k + n, neg);
}

// The digits and the power of ten of the shortest decimal that reads back
// to `c` 2^`q` (`decimal` of the interpreter): `regular` when the float
// below it is as far as the one above (not the first of its power of two).
function $shortest(q: i64, c: u64, regular: boolean): [u64, i64] {
    const [vb, vbl, vbr, k] = $scaled(q, c, regular);
    return [$nearest(vb, vbl, vbr, c & 1u64), k];
}

// `c` 2^`q` and the two ends of the decimals that read back to it (half
// way to the floats below and above), times 4 and the power of ten 10^-`k`
// that leaves the digits before the point; each rounded to odd (`$rop`):
// its comparisons with 4 times an integer are those of the exact value.
function $scaled(q: i64, c: u64, regular: boolean): [u64, u64, u64, i64] {
    const cb = c << 2u64;
    // floor(log10(2^q)), of three quarters of it where the float below is
    // nearer; then the place of the bits of 10^-k
    const k = (q * 661971961083 - (regular ? 0 : 274743187321)) >> 41;
    const h = u64(q + (((0 - k) * 913124641741) >> 38) + 2);
    const [g1, g0] = $pow10G(k);
    return [$rop(g1, g0, cb << h), $rop(g1, g0, (cb - (regular ? 2u64 : 1u64)) << h), $rop(g1, g0, (cb + 2u64) << h), k];
}

// The high bits of `cp` times the 126 bits of a power of ten (`g1` its
// high 63 bits, `g0` its low 63), the lowest set when a bit below is.
function $rop(g1: u64, g0: u64, cp: u64): u64 {
    const m = 0x7FFFFFFFFFFFFFFFu64;
    const x1 = $mulHigh(g0, cp);
    const y0 = g1 * cp;
    const y1 = $mulHigh(g1, cp);
    const z = (y0 >> 1u64) + x1;
    const vbp = y1 + (z >> 63u64);
    return vbp | (((z & m) + m) >> 63u64);
}

// The digits chosen between the ends `vbl` and `vbr` for the value `vb`
// (`out`: 1 when the ends themselves read back to another float, the bits
// of the float odd): a multiple of ten when one alone of the two around
// the value is inside (a digit less), else the integer below or above, the
// one inside, the nearer when both are, the one above when as near (as
// `Display`: Schubfach takes the even one).
function $nearest(vb: u64, vbl: u64, vbr: u64, out: u64): u64 {
    const s = vb >> 2u64;
    const sp10 = 10u64 * $mulHigh(s, 1844674407370955168u64);
    const tp10 = sp10 + 10u64;
    const upin = vbl + out <= (sp10 << 2u64);
    const wpin = (tp10 << 2u64) + out <= vbr;
    const t = s + 1u64;
    const uin = vbl + out <= (s << 2u64);
    const win = (t << 2u64) + out <= vbr;
    const below = i64(vb - ((s + t) << 1u64)) < 0;
    // both computed, then one taken: which one is not foreseen
    const tens = upin ? sp10 : tp10;
    const ones = (uin != win ? uin : below) ? s : t;
    const shorter = s >= 100u64 && upin != wpin;
    return shorter ? tens : ones;
}

// The text of the 17 digits of `f`, `point` of them before the point: the
// first, the 16 others in two words, the zeros at their end counted in
// the words and not written after the point.
function $digits17Text(f: u64, point: i64, neg: boolean): string {
    // the first digit and the 9 first from `f` at once, the 8 last without
    // waiting for the first: short chains of products; each half of 8
    // digits is below 2^32, and said so (a product of 32 bits by digit pair)
    const d = f / 10000000000000000u64;
    const top = f / 100000000u64;
    const w1 = $asciiWord8(u64(u32(top - d * 100000000u64)));
    const w2 = $asciiWord8(u64(u32(f - top * 100000000u64)));
    const zeros = 0x3030303030303030u64;
    const z1 = leadingZeros(w1 ^ zeros) >> 3;
    const z2 = leadingZeros(w2 ^ zeros) >> 3;
    return $decimalText(d, w1, w2, 17 - (z2 == 8 ? 8 + z1 : z2), point, neg);
}

// The texts of the floats that are no number (`top`: `t` 0 for an
// infinity) and of the subnormal ones (`t` 2^-1074 for 64 bits, 2^-149 for
// 32). One function for each width: the exponent is a constant in each,
// whatever the program prints (these functions are compiled once, without
// the code that calls them, D611).
@cold
function $rareF64Text(t: u64, top: boolean, neg: boolean): string {
    return top ? $rtFloatName(t != 0u64, neg) : $subnormalText(t, -1074, neg);
}

@cold
function $rareF32Text(t: u64, top: boolean, neg: boolean): string {
    return top ? $rtFloatName(t != 0u64, neg) : $subnormalText(t, -149, neg);
}

// The name of a float that is no number: `nan`, or an infinity and its
// sign. Lowered with `$rtF64Text` and `$rtF32Text`: `print` of a float
// tests what is not a number before any digit and writes its name from
// here, without the buffer of the digits (the code generator calls it with
// constants: each name is data of the program at the place of its test).
function $rtFloatName(nan: boolean, neg: boolean): string {
    return nan ? "NaN" : neg ? "-inf" : "inf";
