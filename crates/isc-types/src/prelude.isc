// The integer `m` 2^`e` below 1e21 (`e` from 0 to 17) with `d` zeros after
// its point: its last 8 digits and the ones before (below 2^64 both, where
// the integer is not), then the zeros, those past 24 added 24 at a time
// (not by `repeat`: a program may give that name to a function of its own,
// which then takes its place here too).
function $fixedWhole(m: u64, e: i64, d: i64, neg: boolean): string {
    const a = m / 100000000u64;
    const b = (m - a * 100000000u64) << u64(e);
    const top = (a << u64(e)) + b / 100000000u64;
    const th = top / 100000000u64;
    const zeros = 0x3030303030303030u64;
    const head = $fixedText($asciiWord8(th), $asciiWord8(top - th * 100000000u64), $asciiWord8(b % 100000000u64),
