// The entry of the character whose block is `block` and whose last byte has
// the low bits `low`, in the table of its direction.
function $caseOf(block: i64, low: i64, upper: boolean): i64 {
    return upper ? $upperEntry(block, low) : $lowerEntry(block, low);
