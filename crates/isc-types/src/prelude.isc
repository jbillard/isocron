// ---------------------------------------------------------------------
// `toUpperCase` and `toLowerCase` (SPEC section 17, order 2): the case
// mappings of Unicode without a locale, each character on its own (no rule
// of context: a final sigma is a sigma), as Rust's `char::to_uppercase` and
// `char::to_lowercase`, which the runtime applied.
//
// The code generator writes the copy of the text whose ASCII letters are
// in the other case, by vectors: the result for a text of ASCII. When a
// byte is not ASCII it calls `$caseText` with the bytes of the text and
// that copy. Here each character of several bytes is looked up in the
// tables (`$caseEntry`); the text of its other case is written over it in
// the copy when it has as many bytes (`$withText`: whole characters
// replaced by a text, so the copy stays a text); those whose text has
// another length (the sharp s, U+00DF, is `SS`, as many bytes; the dotless
// i, U+0131, is `I`, one less) are counted, and `$caseSplice` then writes
// the parts between them and their texts into a text of the final length.

// `s.toUpperCase()` (`upper`) or `s.toLowerCase()` of a text that is not
// ASCII, called by the code generator with `b`, its bytes, `t`, the text
// with its ASCII letters already in the other case (owned here, copied on
// entry: written where it is), and three zeros. From `i` on, each
// character of several bytes of `b` that has another case: its text
// written into `t` when it has as many bytes. `odd`: the characters whose
// text has another length, `grow` the bytes they add; none: `t` is the
// result. A byte below 0xC0 is ASCII (the bytes `10xxxxxx` are passed with
// their character): the bytes of ASCII after it are passed with it
// (`$asciiRun`).
function $caseText(b: u8[k], t: string, i: i64, grow: i64, odd: i64, upper: boolean): string {
    if (i >= k) {
        return odd == 0 ? t : $caseSplice(b, t, $spaces(k + grow), 0, 0, 0, upper);
    }
    const c = b[i];
    if (c < 0xC0u8) {
        return $caseText(b, t, i + $asciiRun(b, i), grow, odd, upper);
    }
    const n = c < 0xE0u8 ? 2 : c < 0xF0u8 ? 3 : 4;
    const e = $caseEntry(b, i, n, upper);
    const m = (e & 7) + 1;
    return e == 0 ? $caseText(b, t, i + n, grow, odd, upper)
        : m == n ? $caseText(b, $withText(t, i, $casePiece(e, upper)), i + n, grow, odd, upper)
        : $caseText(b, t, i + n, grow + m - n, odd + 1, upper);
}

// The text of `b` in the other case when some characters change its
// length: `u`, the text where every other character is already in the
// other case; `out`, a text of the final length (owned here), where the
// part of `u` from `a` up to each such character is written at `q`, then
// the text of the character; after the last one, the rest of `u`.
function $caseSplice(b: u8[k], u: string, out: string, i: i64, a: i64, q: i64, upper: boolean): string {
    if (i >= k) {
        return $withText(out, q, u.slice(a, k));
    }
    const c = b[i];
    if (c < 0xC0u8) {
        return $caseSplice(b, u, out, i + $asciiRun(b, i), a, q, upper);
    }
    const n = c < 0xE0u8 ? 2 : c < 0xF0u8 ? 3 : 4;
    const e = $caseEntry(b, i, n, upper);
    const m = (e & 7) + 1;
    if (e == 0 || m == n) {
        return $caseSplice(b, u, out, i + n, a, q, upper);
    }
    const kept = $withText(out, q, u.slice(a, i));
    return $caseSplice(b, u, $withText(kept, q + i - a, $casePiece(e, upper)), i + n, i + n, q + i - a + m, upper);
}

// From `i`, where a byte of ASCII is: that byte and the bytes of ASCII
// right after it, at most 8 of them (1 to 8). The bytes in a word (8 read
// at once when the text has them), the highest bit of each but the first:
// the lowest one set, the first byte that is not ASCII, by the leading
// zeros of that bit alone.
function $asciiRun(b: u8[k], i: i64): i64 {
    const whole = i + 8 <= k;
    const high = (whole ? readWord(b, i, 8) : readWord(b, i, k - i)) & 0x8080808080808000u64;
    return high != 0u64 ? (63 - leadingZeros(high & (0u64 - high))) >> 3 : whole ? 8 : k - i;
}

// A text of `n` spaces: every place in it is between two characters. (Its
// bytes are known to be ASCII when the program is compiled: nothing is
// checked when it runs, D450.)
function $spaces(n: i64): string {
    return $stringOf(map(iota(n), (j) => 32u8));
}

// The entry of the character of `n` bytes (2 to 4) at `i` in the table of
// its direction: 0 when it has no other case; else 8 times the place of
// the text of its other case in `$upperTexts` or `$lowerTexts`, plus the
// bytes of that text less one. Its block: its scalar value divided by 64,
// what its bytes but the last say. A character of 2 bytes, the most
// frequent, from its two bytes; a longer one from its bytes in a word (4
// read at once when the text has them).
function $caseEntry(b: u8[k], i: i64, n: i64, upper: boolean): i64 {
    if (n == 2) {
        return $caseOf(i64(b[i] & 0x1Fu8), i64(b[i + 1] & 0x3Fu8), upper);
    }
    const w = i64(i + 4 <= k ? readWord(b, i, 4) : readWord(b, i, k - i));
    const block = n == 3 ? ((w & 0xF) << 6) | ((w >> 8) & 0x3F) : ((w & 7) << 12) | (((w >> 8) & 0x3F) << 6) | ((w >> 16) & 0x3F);
