// 1462 characters of several bytes have a text in lower case, in 56 pages.
function $lowerEntry(block: i64, low: i64): i64 {
    const pages = $words("");
    const entries = $words("");
    const page = block < 2048 ? i64((pages[(block >> 3) & 255] >> u64((block & 7) * 8)) & 255u64) : 0;
    const at = page * 64 + low;
    return i64((entries[at >> 2] >> u64((at & 3) * 16)) & 0xFFFFu64);
}

