// `f` `p` / 2^`s` rounded to the nearest integer, a half up (`s` from 1
// on): the product in 128 bits (below 2^113: `f` below 2^53, `p` at most
// 10^18), half of 2^`s` added before the shift; from 2^114 on, zero.
function $roundShift(f: u64, p: u64, s: i64): u64 {
    const lo = f * p;
    const hi = $mulHigh(f, p);
    if (s < 64) {
        const l = lo + (1u64 << u64(s - 1));
        const h = hi + (l < lo ? 1u64 : 0u64);
        return (h << u64(64 - s)) | (l >> u64(s));
