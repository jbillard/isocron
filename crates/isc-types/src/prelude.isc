// Isocron standard library (POC subset, SPEC section 6).
// `sqrt` is a primitive of the runtime (correctly rounded, SPEC section 10).
function sum<T extends Num>(x: T[n]): T {
    return reduce(x, (+), 0);
}

function product<T extends Num>(x: T[n]): T {
    return reduce(x, (*), 1);
}

function mean(x: f64[n]): f64 {
    return sum(x) / f64(n);
}

function dot<T extends Num>(a: T[n], b: T[n]): T {
    return sum(a * b);
}

function count<T>(x: T[n], p: (T) => boolean): i64 {
    return sum(map(x, (v) => p(v) ? 1 : 0));
}

// the first index of `x` whose element satisfies `p`, or -1 (TypeScript's
// `findIndex`); `p` is not called past it. Rule F (D505): a loop that
// stops at it, by vectors of lanes when `p` cannot stop the program
function findIndex<T>(x: T[n], p: (T) => boolean): i64 {
    return fold(iota(n), -1, (a, i) => a < 0 && p(x[i]) ? i : a);
}

// `scatter` (SPEC section 16, v1; DECISIONS D111): `dest` where each
// `vals[k]` is combined with `op` into the element at `idx[k]`, in the order
// of k (the rule of collisions: several values at one index are combined
// in that order); an index out of bounds is a panic.
function scatter<T>(dest: T[m], idx: i64[n], vals: T[n], op: (T, T) => T): T[m] {
    return fold(zip(idx, vals), dest, (r, p) => {
        const [i, v] = p;
        return r.with(i, op(r[i], v));
    });
}

// `Result` (DECISIONS D138): the value of an action that can fail, or the
// message of its error. Each `try_` action returns it where the action of
// the same name would panic; a program that declares `Result`, `Ok` or
// `Err` replaces this type, and the `try_` actions are then left out.
type Result<T, E> = Ok(T) | Err(E);

// the functions of a program take precedence over the primitives, even
// here: the prelude compares with `""` rather than calling `len`
function resultOf<T>(r: [T, string]): Result<T, string> {
    const [v, e] = r;
    return e == "" ? Ok(v) : Err(e);
}

function doneOr(e: string): Result<void, string> {
    return e == "" ? Ok(()) : Err(e);
}

// `tryParseI64(s)` written in Isocron (D586): the reading of `parseI64`,
// its message in `Err` where `parseI64` panics.
function tryParseI64(s: string): Result<i64, string> {
    const [v, bad] = $parseI64Value(s);
    return bad == 0u64 ? Ok(v) : Err($parseI64Message(s));
}

function tryParseF64(s: string): Result<f64, string> {
    return resultOf(parseF64OrError(s));
}

action tryReadBytes(path: string): Result<u8[k], string> {
    return resultOf(readBytesOrError(path));
}

action tryReadF64(path: string): Result<f64[k], string> {
    return resultOf(readF64OrError(path));
}

action tryReadText(path: string): Result<string, string> {
    return resultOf(readTextOrError(path));
}

// an array of arrays is not a value of a type parameter: no `resultOf`
action tryReadCsvF64(path: string, skip: i64): Result<f64[r][c], string> {
    const [m, e] = readCsvF64OrError(path, skip);
    return e == "" ? Ok(m) : Err(e);
}

action tryWriteBytes(path: string, x: u8[n]): Result<void, string> {
    return doneOr(writeBytesOrError(path, x));
}

action tryWriteText(path: string, s: string): Result<void, string> {
    return doneOr(writeTextOrError(path, s));
}

// Seeded random numbers (D155): `random(seed, i)` is the number `i` of the
// sequence of `seed`, uniform in [0, 1) (53 bits), by SplitMix64 on a
// counter: no state, the same bits everywhere, computed in parallel.
function splitMix64(z0: u64): u64 {
    const z1 = (z0 ^ (z0 >> 30u64)) * 0xbf58476d1ce4e5b9u64;
    const z2 = (z1 ^ (z1 >> 27u64)) * 0x94d049bb133111ebu64;
    return z2 ^ (z2 >> 31u64);
}

function random(seed: i64, i: i64): f64 {
    const x = splitMix64(splitMix64(u64(seed)) + (u64(i) + 1u64) * 0x9e3779b97f4a7c15u64);
    return f64(x >> 11u64) * 0.00000000000000011102230246251565;
}

// an integer in [0, n), from `random`
function randomInt(seed: i64, i: i64, n: i64): i64 {
    return i64(random(seed, i) * f64(n));
}

// Sorting (D155): stable, by the order of the type (integers and booleans
// by value, floats with -0 before +0 and NaN last, strings by bytes); never
// in place. `argsort` is a primitive: the order of the elements.
function sort<T extends Ord>(x: T[n]): T[n] {
    return map(argsort(x), (i) => x[i]);
}

function sortBy<T, K extends Ord>(x: T[n], key: (v: T) => K): T[n] {
    return map(argsort(map(x, key)), (i) => x[i]);
}

// the elements in the reverse order (TypeScript's `toReversed`)
function toReversed<T>(x: T[n]): T[n] {
    return map(iota(n), (i) => x[n - 1 - i]);
}

// `Option` (D158): the result of `get` of a `Map`, read with `??` or
// `match`; a program that declares `Option`, `None` or `Some` replaces it.
type Option<T> = None | Some(T);

// `Map<K, V>` (D158): a dictionary, never changed in place. Its three
// arrays: the keys in the order of their first insertion, their values,
// and `index`, a table of hashes of the keys (D492: each slot 0 or the
// position of a key plus one, a power of two of slots at most half full; a
// fixed hash, the same bits everywhere; the ranks of the keys sorted and a
// bisection before: `get` 51 times its floor). Built at once from its
// entries, in O(n); `set` and `delete` give a new map, in O(n).

// the position of `k` among the keys, -1 if absent. The functions of maps
// read sizes from their parameters, never with `len`, which a program may
// replace.
function $findIn<K extends Key>(keys: K[n], index: i64[s], k: K): i64 {
    return $hashFind(keys, index, k);
}

// the map of `ks` and `vs`: each distinct key at its first position, with
// its last value (as `set` of TypeScript, entry after entry). `$group`
// gives, for the m distinct keys in the order of their first occurrence,
// their first indices, their last ones and their counts (a table of
// hashes, D167); then the index of the m keys (D492).
// the number of keys of a result of `$group` (no `len`: a program may
// replace it)
function $third(g: i64[t]): i64 {
    return t / 3;
}

function $mapFrom<K extends Key, V>(ks: K[n], vs: V[n]): Map<K, V> {
    const g = $group(ks);
    return $mapPick(ks, vs, g, iota($third(g)));
}

function $mapPick<K extends Key, V>(ks: K[n], vs: V[n], g: i64[t], r: i64[m]): Map<K, V> {
    const keys = map(r, (i) => ks[g[i]]);
    return $mapOf(keys, map(r, (i) => vs[g[m + i]]), $hashIndex(keys));
}

// `Map(entries)`: TypeScript's `new Map(entries)`
function Map<K extends Key, V>(entries: [K, V][n]): Map<K, V> {
    const ks = map(entries, (e) => {
        const [k, v] = e;
        return k;
    });
    const vs = map(entries, (e) => {
        const [k, v] = e;
        return v;
    });
    return $mapFrom(ks, vs);
}

// `countBy(xs, f)`: the number of the elements of each key `f(x)`, the keys
// in the order of their first element. The keys are grouped as they are
// made, never stored all (D244): the key of each group is made again from
// its first element; its last element is not needed (`$groupCounts`, D317).
function countBy<T, K extends Key>(xs: T[n], f: (x: T) => K): Map<K, i64> {
    const g = $groupCounts(map(xs, f));
    return $countPick(xs, f, g, iota($third(g)));
}

function $countPick<T, K extends Key>(xs: T[n], f: (x: T) => K, g: i64[t], r: i64[m]): Map<K, i64> {
    const keys = map(r, (i) => f(xs[g[i]]));
    return $mapOf(keys, map(r, (i) => g[2 * m + i]), $hashIndex(keys));
}

function get<K extends Key, V>(m: Map<K, V>, k: K): Option<V> {
    const [keys, values, index] = $mapParts(m);
    const i = $findIn(keys, index, k);
    if (i < 0) {
        return None;
    } else {
        return Some(values[i]);
    }
}

function has<K extends Key, V>(m: Map<K, V>, k: K): boolean {
    const [keys, values, index] = $mapParts(m);
    return $findIn(keys, index, k) >= 0;
}

function keys<K extends Key, V>(m: Map<K, V>): K[k] {
    const [ks, vs, index] = $mapParts(m);
    return ks;
}

function values<K extends Key, V>(m: Map<K, V>): V[k] {
    const [ks, vs, index] = $mapParts(m);
    return vs;
}

function $pairs<K, V>(ks: K[n], vs: V[n]): [K, V][n] {
    return map(iota(n), (i) => [ks[i], vs[i]] as const);
}

function entries<K extends Key, V>(m: Map<K, V>): [K, V][k] {
    const [ks, vs, index] = $mapParts(m);
    return $pairs(ks, vs);
}

function $set<K extends Key, V>(ks: K[n], vs: V[n], index: i64[s], k: K, v: V): Map<K, V> {
    const i = $findIn(ks, index, k);
    if (i >= 0) {
        return $mapOf(ks, vs.with(i, v), index);
    } else {
        return $mapFrom(map(iota(n + 1), (j) => j < n ? ks[j] : k), map(iota(n + 1), (j) => j < n ? vs[j] : v));
    }
}

// a new map: `k` with the value `v`, at its place if `m` has it, else last
function set<K extends Key, V>(m: Map<K, V>, k: K, v: V): Map<K, V> {
    const [ks, vs, index] = $mapParts(m);
    return $set(ks, vs, index, k, v);
}

function $delete<K extends Key, V>(ks: K[n], vs: V[n], index: i64[s], k: K): Map<K, V> {
    const i = $findIn(ks, index, k);
    const kept = filter(iota(n), (j) => j != i);
    return $mapFrom(map(kept, (j) => ks[j]), map(kept, (j) => vs[j]));
}

// a new map without `k`
function delete<K extends Key, V>(m: Map<K, V>, k: K): Map<K, V> {
    const [ks, vs, index] = $mapParts(m);
    return $delete(ks, vs, index, k);
}

// `f` applied to each element of `x` from the `i`-th on, in order (D352)
action forEachFrom<T>(x: T[n], f: action (T) => void, i: i64): void {
    if (i < x.length) {
        f(x[i]);
        forEachFrom(x, f, i + 1);
    }
}

// `f` applied to each element of `x`, in order, once each (D352)
action forEach<T>(x: T[n], f: action (T) => void): void {
    forEachFrom(x, f, 0);
}

// the results of `f` from the `i`-th element of `x` on, each written into
// `acc` (owned: changed in place, D351) (D352)
action mapInOrderFrom<T, U>(x: T[n], f: action (T) => U, i: i64, acc: U[n]): U[n] {
    if (i == x.length) {
        return acc;
    }
    const y = f(x[i]);
    return mapInOrderFrom(x, f, i + 1, acc.with(i, y));
}

// `map(x, f)` of an action `f` (D387): the results of `f` applied to each
// element of `x`, in order, once each, as many as `x` has (an array of its
// own size: no value of `U` fills an empty one, D352); called by the
// compiler
action mapInOrder<T, U>(x: T[n], f: action (T) => U): U[] {
    return x.length == 0 ? [] : mapInOrderFirst(x, f);
}

// `mapInOrder` of `x` not empty: the first result fills the array the
// others are written into (D352)
action mapInOrderFirst<T, U>(x: T[n], f: action (T) => U): U[n] {
    const first = f(x[0]);
    return mapInOrderFrom(x, f, 1, fill(x.length, first));
}

// `parseI64(s)` written in Isocron (D582, SPEC section 17, step 2): a
// decimal integer, its sign optional, the answers of Rust's
// `str::parse::<i64>`, and for any other text the panic of the runtime's.
// 1 to 8 digits, or a sign and 1 to 7, in one word (`$digits8`), the place
// of the digits a constant on each path: the word never waits for the
// first byte (a branch, foreseen, rather than a place computed from it);
// 9 to 16 bytes in two words, a sign in the first made a `0`
// (`$digits16`); more, and the texts that are no number, out of the loop
// (`$parseRest`, `@cold`, D584).
function parseI64(s: string): i64 {
    const [v, bad] = $parseI64Value(s);
    return bad == 0u64 ? v : $panic("parseI64: `", s, "` is not a valid integer");
}

// The value of `s` and a word not 0 if it is no integer (`parseI64`,
// `tryParseI64`).
function $parseI64Value(s: string): [i64, u64] {
    const b = bytes(s);
    const k = b.length;
    const c = k > 0 ? b[0] : 0u8;
    const neg = c == 45u8;
    const [v, bad] = k >= 1 && k <= 8 && c >= 48u8 ? $digits8(b, 0, k)
        : k >= 2 && k <= 8 && (neg || c == 43u8) ? $digits8(b, 1, k - 1)
        : k > 8 && k <= 16 ? $digits16(b, k)
        : $parseRest(b, k, neg);
    return [i64(neg ? 0u64 - v : v), bad];
}

// The message of `tryParseI64`, made where a text is no integer only
// (`@cold`): the panic of `parseI64` writes the same in three parts.
@cold
function $parseI64Message(s: string): string {
    return "parseI64: `" + s + "` is not a valid integer";
}

// The texts of `parseI64` of more than 16 bytes (after their sign and
// leading zeros, at most 19 digits); up to 8, none, a sign alone or a first
// byte below `0` that is no sign: no number.
@cold
function $parseRest(b: u8[k], k: i64, neg: boolean): [u64, u64] {
    const c = k > 0 ? b[0] : 0u8;
    const sign = neg || c == 43u8;
    return k > 16 ? $digitsHuge(b, sign ? 1 : 0, k - (sign ? 1 : 0), neg) : [0u64, 1u64];
}

// The value of the `n` bytes (1 to 8) of `b` from `at`, and a word not 0
// if one is not a decimal digit: the bytes in one word (`readWord`), `0`s
// before them up to 8, a byte below `0` or above `9` found in every byte at
// once, then the digits paired, by fours, by eights (as `digits8` of the
// runtime core).
function $digits8(b: u8[k], at: i64, n: i64): [u64, u64] {
    return $digitsWord(readWord(b, at, n), n);
}

function $digitsWord(w0: u64, n: i64): [u64, u64] {
    const zeros = 0x3030303030303030u64;
    const w = n == 8 ? w0 : (w0 << u64((8 - n) * 8)) | (zeros >> u64(n * 8));
    const bad = ((w + 0x4646464646464646u64) | (w - zeros)) & 0x8080808080808080u64;
    const v1 = w - zeros;
    const v2 = v1 * 10u64 + (v1 >> 8u64);
    const m = 0x000000FF000000FFu64;
    const v3 = ((v2 & m) * 0x000F424000000064u64 + ((v2 >> 16u64) & m) * 0x0000271000000001u64) >> 32u64;
    return [v3, bad];
}

// 9 to 16 bytes: the first `k - 8` (a sign there made a `0`: the word read
// from the first byte), then the last 8, each in a word.
function $digits16(b: u8[k], k: i64): [u64, u64] {
    const w0 = readWord(b, 0, k - 8);
    const c = w0 & 0xFFu64;
    const w = c == 45u64 || c == 43u64 ? (w0 & 0xFFFFFFFFFFFFFF00u64) | 0x30u64 : w0;
    const [hi, bh] = $digitsWord(w, k - 8);
    const [lo, bl] = $digits8(b, k - 8, 8);
    return [hi * 100000000u64 + lo, bh | bl];
}

// More than 16 digits from `at`: their leading zeros skipped, at most 19
// left (the first 1 to 3 in a word of their own), below 2^63 or equal for
// a negative.
function $digitsHuge(b: u8[k], at: i64, n: i64, neg: boolean): [u64, u64] {
    const end = at + n;
    const z = fold(iota(n), end, (a, i) => a == end && b[at + i] != 48u8 ? at + i : a);
    const m = end - z;
    const [hi, bh] = m > 16 && m <= 19 ? $digits8(b, z, m - 16) : [0u64, 0u64];
    const [mid, bm] = m > 8 ? $digits8(b, end - (m <= 16 ? m : 16), m <= 16 ? m - 8 : 8) : [0u64, 0u64];
    const [lo, bl] = m > 0 ? $digits8(b, end - (m >= 8 ? 8 : m), m >= 8 ? 8 : m) : [0u64, 0u64];
    const v = (hi * 100000000u64 + mid) * 100000000u64 + lo;
    const limit = (1u64 << 63u64) - (neg ? 0u64 : 1u64);
    const over = m > 19 || (m == 19 && v > limit) ? 1u64 : 0u64;
    return [v, bh | bm | bl | over];
}

// The text of an integer written in Isocron (D588, SPEC section 17, order
// 2): `toString` of an `i64` or a `u64` that no fusion of the code
// generator writes in place (`padStart`, a concatenation: D348, D359),
// lowered once when a program writes one and called by the code generator
// in place of the runtime's `isc_to_string_i64`.
function $rtIntText(x: i64): string {
    const neg = x < 0;
    return $digitsText(neg ? 0u64 - u64(x) : u64(x), neg);
}

function $rtUintText(x: u64): string {
    return $digitsText(x, false);
}

// The digits of `v`, a `-` before them when `neg`: their number from the
// bits of `v` (1233 / 4096 below log10 2) and one power of ten; the last 8
// digits, the 8 before and the first 4 in three words, only those the
// number has (a word of 4 for a part below 10^4), then the text of the
// last bytes of the words, written into its block (`$textTail`).
function $digitsText(v: u64, neg: boolean): string {
    const powers = [1u64, 10u64, 100u64, 1000u64, 10000u64, 100000u64, 1000000u64, 10000000u64,
        100000000u64, 1000000000u64, 10000000000u64, 100000000000u64, 1000000000000u64,
        10000000000000u64, 100000000000000u64, 1000000000000000u64, 10000000000000000u64,
        100000000000000000u64, 1000000000000000000u64, 10000000000000000000u64];
    const t = ((64 - leadingZeros(v | 1u64)) * 1233) >> 12;
    const n = t + ((v | 1u64) >= powers[t] ? 1 : 0);
    const lo = v < 10000u64 ? $asciiWord4(v) : v < 100000000u64 ? $asciiWord8(v) : $asciiWord8(v % 100000000u64);
    const h = v / 100000000u64;
    const mid = v < 100000000u64 ? 0u64 : h < 10000u64 ? $asciiWord4(h) : $asciiWord8(h % 100000000u64);
    const hi = v < 10000000000000000u64 ? 0u64 : $asciiWord4(v / 10000000000000000u64);
    return $textTail(hi, mid, lo, n, neg);
}

// The 4 digits of `v` (below 10^4) at the end of a word of 8 (`0`s before
// them): its two pairs of digits from the table of `$pair`.
function $asciiWord4(v: u64): u64 {
    const q = v / 100u64;
    return ((($pair(q) | ($pair(v - q * 100u64) << 16u64))) << 32u64) | 0x30303030u64;
}

// The 8 digits of `v` (below 10^8) in a word, the highest at the lowest
// place, as ASCII: its four pairs of digits, their quotients by 100, 10^4
// and 10^6 made at once (not one after the other: a short chain of
// products), each pair read from a table (D588).
function $asciiWord8(v: u64): u64 {
    const q1 = v / 100u64;
    const q2 = v / 10000u64;
    const q3 = v / 1000000u64;
    return $pair(q3) | ($pair(q2 - q3 * 100u64) << 16u64) | ($pair(q1 - q2 * 100u64) << 32u64) | ($pair(v - q1 * 100u64) << 48u64);
}

// The two ASCII digits of `r` (below 100), the tens at the lowest place:
// a table of 256 pairs (those past 99 never read), so that its index,
// `r & 255` twice, is inside it whatever `r` and its check of bounds goes
// at compilation.
function $pair(r: u64): u64 {
    return readWord(bytes(""), i64(r & 255u64) * 2, 2);
}
