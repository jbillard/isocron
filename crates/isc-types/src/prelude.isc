// What `$rtFixedText` leaves: what is not a number, a number from 1e21 on
// (the text of `print`, as the runtime: `$shortestText`), an integer from 2^52 on
// (`$fixedWhole`), more than 18 decimals (`$fixedLong`).
@cold
function $fixedRest(x: f64, d: i64): string {
    const bits = $floatBits(x);
    const mag = bits & 0x7FFFFFFFFFFFFFFFu64;
    const neg = bits > 0x8000000000000000u64;
    if (mag >= 0x7FF0000000000000u64) {
        return mag > 0x7FF0000000000000u64 ? "NaN" : neg ? "-Infinity" : "Infinity";
    }
    const bq = i64(mag >> 52u64);
    const t = mag & 0xFFFFFFFFFFFFFu64;
    const m = bq == 0 ? t : t | 0x10000000000000u64;
