// One added to the decimals at the block `j`: a block of nines made
// zeros and one added to the block before; before the first, the whole
// part.
function $fixedUp(blocks: u64[k], j: i64, d: i64): u64[k] {
    if (j == 0) {
        return blocks.with(0, 1u64);
