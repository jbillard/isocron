// entries of 16 bits a page, 4 to a word (the page 0: zeros); and the texts
// of the characters in the other case, one after the other (a text already
// there is not written twice), after a space, so that no entry is 0. The
// words of `pages` and `entries` are written as their hexadecimal digits in
// one literal (`$words`: one token to read at each compilation, where an
// array literal has one a word). Made from the mappings of the Rust that
// builds the compiler, which the interpreter applies: the test
// `case_tables_of_the_prelude` (`crates/iscc/tests/strings.rs`) writes
// them and fails when they differ.
// Generated by the test `case_tables_of_the_prelude` (Unicode 17.0.0): do not edit.
// 1554 characters of several bytes have a text in upper case, in 63 pages.
function $upperEntry(block: i64, low: i64): i64 {
    const pages = $words("");
    const entries = $words("");
    const page = block < 2048 ? i64((pages[(block >> 3) & 255] >> u64((block & 7) * 8)) & 255u64) : 0;
    const at = page * 64 + low;
    return i64((entries[at >> 2] >> u64((at & 3) * 16)) & 0xFFFFu64);
}

