// for every block it gives back; a larger block is the runtime's.
//
// The arena. Its first 512 bytes: at 0 the next byte never given, at 8 the
// end of its committed bytes, at 16 the lock of both; from 64, for each class
// c, at 64 + 16 * c the batches of free blocks that the threads gave, at 72
// + 16 * c the lock of those batches. A block of the class c (64 * (c + 1)
// bytes, 16 classes) is 64 bytes after its header: at 0 its class (4 bytes),
// at 4 its state (1 byte: in use or free), at 5 the mark of the blocks of
// the arena (0x41: the allocator of the runtime, whose blocks in use have 0
// there, tests both bytes at once and never takes one for its own, without
// a test more on its fast path), at 8 the next block of its list;
// the first block of a batch holds at 16 the batch given before it, at 24
// the count of its blocks.
// The zone of the thread: at 8 * c the list of its free blocks of the class
// c, at 128 + 2 * c their count (at most 64), at 160 + 8 * c a batch it
// keeps in reserve. A list changes hands whole, in one step, never walked
// (D605): a thread that fills its list keeps it as its batch in reserve and
// gives the batch it had to all the threads; a thread whose list is empty
// takes its batch in reserve, or one that a thread gave, or cuts new
// blocks. A thread that takes and gives blocks back around the limit stays
// in its own lists.
//
// A header is tested once to be in the arena, its 64 bytes (`$arenaHas`);
// the tests of its words then fold in the generated code. The statements of
// these actions are not those of a program: the generated code moves and
// merges them as it does those of a function.

@requireNoAlloc
action $kStart(): u64 {
    // (once: a program that calls it again keeps its arena)
    if ($arenaBase() != 0u64) {
        return $arenaBase();
    }
    const base = $arenaReserve();
    if (base == 0u64) {
        return 0u64;
    }
    // (1 MiB first: pages the system cannot make a huge one of, which a
    // small program would pay to have cleared; the blocks start in the
    // page of these words)
    const code = $arenaCommit(base, 1048576u64);
    if (code != 0) {
        return 0u64;
    }
    $store64(base, base + 512u64);
    $store64(base + 8u64, base + 1048576u64);
    return base;
}

// The panics of the fast paths, in one place (their texts and their places
// are not copied at every allocation and every free of a program): a block
// given back that is not one in use (0), a block of a free list that is not
// free (1), a word of a free list that is not a block of the arena (2).
@cold
action $kDamaged(what: i64): u64 {
    if (what == 0) {
        $panic("invalid free (a block freed twice or not allocated by the runtime)", "", "");
    }
    if (what == 1) {
        $panic("the heap is damaged (a block of a free list is not free)", "", "");
    }
    $panic("the heap is damaged (a free block that is not in the arena)", "", "");
    return 0u64;
}

// The lock at `a` taken: the word 0 made 1 in one step, tried again while
// another thread holds it.
@requireTail
action $kLock(a: u64): i64 {
    if ($cas64(a, 0u64, 1u64) == 0u64) {
        return 0;
    }
    $spinHint();
    return $kLock(a);
}

action $kUnlock(a: u64): i64 {
    $atomicStore64(a, 0u64);
    return 0;
}

// A block of `bytes` bytes (1 to 1024): the first of the list of the
// thread, or blocks from the shared list, or new ones.
@requireNoAlloc
action $kAlloc(bytes: i64): u64 {
    const class = (bytes + 63) / 64 - 1;
    const head = $zoneLoad64(class * 8);
    // (no block, the word 0, is not in the arena: one test for both)
    if (!$arenaHas(head, 64u64)) {
        return $kRefill(class, bytes);
    }
    if ($load8(head + 4u64) != 0x5Au64) {
        return $kDamaged(1);
    }
    $zoneStore64(class * 8, $load64(head + 8u64));
    $zoneStore16(128 + class * 2, $zoneLoad16(128 + class * 2) - 1u64);
    $store16(head + 4u64, 0x41A5u64);
    return head + 64u64;
}

// The list of the thread is empty: its batch in reserve, or a batch that a
// thread gave, or 32 new blocks; the first block is given, the others are
// the list. Without an arena (the allocator of the system asked for by
// `ISC_ALLOC`, or no range of addresses to reserve), the block is the
// runtime's.
@cold
action $kRefill(class: i64, bytes: i64): u64 {
    const base = $arenaBase();
    if (base == 0u64) {
        return $runtimeAlloc(bytes);
    }
    if ($zoneLoad64(class * 8) != 0u64) {
        return $kDamaged(2);
    }
    const spare = $zoneLoad64(160 + class * 8);
    if (spare != 0u64) {
        $zoneStore64(160 + class * 8, 0u64);
        return $kOpen(class, spare);
    }
    const shared = base + 64u64 + u64(class) * 16u64;
    const l = $kLock(shared + 8u64);
    const b = $load64(shared);
    if (b != 0u64) {
        $store64(shared, $load64(b + 16u64));
    }
    const u = $kUnlock(shared + 8u64);
    if (b == 0u64) {
        return $kCarve(class);
    }
    return $kOpen(class, b);
}

// The batch `b` becomes the list of the thread: its first block given, the
// others, counted when the batch was made, the list.
action $kOpen(class: i64, b: u64): u64 {
    if (!$arenaHas(b, 64u64) || $load8(b + 4u64) != 0x5Au64) {
        return $kDamaged(1);
    }
    $zoneStore64(class * 8, $load64(b + 8u64));
    $zoneStore16(128 + class * 2, $load64(b + 24u64) - 1u64);
    $store16(b + 4u64, 0x41A5u64);
    return b + 64u64;
}

// 32 new blocks of the class cut after the last byte given, under the lock
// of that byte (their pages committed by 2 MiB): the first one given, the
// others the list of the thread.
@cold
action $kCarve(class: i64): u64 {
    const base = $arenaBase();
    const step = u64(class + 1) * 64u64 + 64u64;
    const count = 32;
    const l = $kLock(base + 16u64);
    const start = $load64(base);
    const end = start + step * u64(count);
    const committed = $load64(base + 8u64);
    if (end > committed) {
        // (up to a multiple of 2 MiB from the base)
        const more = (end - base + 2097151u64) / 2097152u64 * 2097152u64 - (committed - base);
        const code = $arenaCommit(committed, more);
        if (code != 0) {
            $panic("out of memory", "", "");
        }
        $store64(base + 8u64, committed + more);
    }
    $store64(base, end);
    const u = $kUnlock(base + 16u64);
    const linked = $kLink(start + step, step, class, count - 1);
    $zoneStore64(class * 8, start + step);
    $zoneStore16(128 + class * 2, u64(count - 1));
    $store32(start, u64(class));
    $store16(start + 4u64, 0x41A5u64);
    return start + 64u64;
}

// `left` blocks from `h`, each `step` bytes after the one before, made free
// blocks of the class, each the next of the one before, the last the end of
// their list. (A loop written as a tail call: the code of the allocator
// builds no array, it would call itself.)
@requireTail
action $kLink(h: u64, step: u64, class: i64, left: i64): i64 {
    $store32(h, u64(class));
    $store8(h + 4u64, 0x5Au64);
    if (left <= 1) {
        $store64(h + 8u64, 0u64);
        return 0;
    }
    $store64(h + 8u64, h + step);
    return $kLink(h + step, step, class, left - 1);
}

// The block `p` given back: 1, the block the first of the list of its
// class (a list of 64 blocks is kept in reserve first, `$kSpill`); or 0,
// nothing done, when `p` is not a block of the arena (the runtime's, or no
// block).
@requireNoAlloc
action $kFree(p: u64): i64 {
    const h = p - 64u64;
    if (!$arenaHas(h, 64u64)) {
        return 0;
    }
    const class = i64($load32(h));
    if ($load8(h + 4u64) != 0xA5u64 || class >= 16 || p % 64u64 != 0u64) {
        return i64($kDamaged(0));
    }
    const held = $zoneLoad16(128 + class * 2);
    if (held >= 64u64) {
        // (given back whatever `$kSpill` did with the lists: said here, for
        // the code that calls this one from another module, D611)
        const spilled = $kSpill(class, h);
        return 1;
    }
    $store8(h + 4u64, 0x5Au64);
    $store64(h + 8u64, $zoneLoad64(class * 8));
    $zoneStore64(class * 8, h);
    $zoneStore16(128 + class * 2, held + 1u64);
    return 1;
}

// The list of the thread is full (64 blocks) and the block `h` is given
// back: the list becomes the batch in reserve of the thread, its count
// written in its first block; the batch in reserve before goes to all the
// threads, under the lock of the class; `h` starts the list again.
@cold
action $kSpill(class: i64, h: u64): i64 {
    // (a class, which `$kFree` tested: said again here, for this function is
    // compiled once, without the code that calls it, D611; one test, and the
    // words of the zone below are read without any)
    if (class < 0 || class >= 16) {
        return i64($kDamaged(0));
    }
    const old = $zoneLoad64(160 + class * 8);
    if (old != 0u64) {
        const shared = $arenaBase() + 64u64 + u64(class) * 16u64;
        const l = $kLock(shared + 8u64);
        $store64(old + 16u64, $load64(shared));
        $store64(shared, old);
        const u = $kUnlock(shared + 8u64);
    }
    const full = $zoneLoad64(class * 8);
    $store64(full + 24u64, $zoneLoad16(128 + class * 2));
    $zoneStore64(160 + class * 8, full);
    $store8(h + 4u64, 0x5Au64);
    $store64(h + 8u64, 0u64);
    $zoneStore64(class * 8, h);
    $zoneStore16(128 + class * 2, 1u64);
    return 1;
}
