// A subnormal float `c` 2^`q`: of few bits, so that Schubfach, which tries
// one digit less only, keeps digits it does not need (two for the least
// double, 4.9e-324): digits are removed while a decimal of one less reads
// back to it (`$fewerDigits`), then the digits left are made 17.
function $subnormalText(c: u64, q: i64, neg: boolean): string {
    const [vb, vbl, vbr, k] = $scaled(q, c, true);
    const out = c & 1u64;
    const [f, e] = $fewerDigits($nearest(vb, vbl, vbr, out), 1u64, vbl + out, vbr - out, k);
    const n = $digitCount(f);
