// `f` 10^`e` with a digit less while one of the two decimals around it
// reads back to the same float, that is, lies between its ends (`low` and
// `high`, times 4, in units of the first exponent; `p` the power of ten of
// `e` in those units): the one that does, the nearer of `f` when both do,
// the one above when as near (`shorter` of the interpreter, which reads
// the decimals back with `str::parse`).
function $fewerDigits(f: u64, p: u64, low: u64, high: u64, e: i64): [u64, i64] {
    const lo = f / 10u64;
    const a4 = lo * p * 40u64;
    const b4 = a4 + p * 40u64;
    const a = low <= a4 && a4 <= high;
    const b = low <= b4 && b4 <= high;
    if (f < 10u64 || !(a || b)) {
        return [f, e];
    }
    const d = a && b ? (f - lo * 10u64 < (lo + 1u64) * 10u64 - f ? lo : lo + 1u64) : a ? lo : lo + 1u64;
    return $fewerDigits(d, p * 10u64, low, high, e + 1);
