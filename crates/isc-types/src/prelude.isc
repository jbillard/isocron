// The blocks of decimals from the `j`-th on (`blocks[0]` is what they
// carry into the whole part): the fraction times 10^8 (for the first
// block, the power of ten of its decimals), each limb with the carry of
// the one below, the carry of the last the block. After the last block,
// a fraction left of a half or more: one added to the decimals
// (`$fixedUp`).
function $fixedBlocks(limbs: u64[l], blocks: u64[k], j: i64, d: i64): u64[k] {
    if (j == k) {
        return (limbs[l - 1] & 0x80000000u64) != 0u64 ? $fixedUp(blocks, k - 1, d) : blocks;
    }
    const mult = j == 1 ? $pow10(d - 8 * (k - 2)) : 100000000u64;
    // (a `fold` that writes each limb in place, the one below already
    // written, and not a `scan`, which says the same in half an instruction
    // less a limb: the prelude calls no name that it did not call before,
    // since a program may give any of them to a function of its own, which
    // then takes its place here too; a recursion over the limbs with the
    // carry as an argument was measured slower than this `fold`)
    const next = fold(iota(l), limbs, (acc, i) => acc.with(i, (acc[i] & 0xFFFFFFFFu64) * mult + (i == 0 ? 0u64 : acc[i - 1] >> 32u64)));
    return $fixedBlocks(next, blocks.with(j, next[l - 1] >> 32u64), j + 1, d);
