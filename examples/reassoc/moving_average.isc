// moving_average.isc (reassociated)  usage: moving_average <input.f64> <output.f64> <reps>
// `allow_reassoc` (SPEC section 10): compared with the reassociated variants
// of the other languages (section 14, DECISIONS D123)
@allow_reassoc
function moving_average(x: f64[n]): f64[n - 63] {
    return map(window(x, 64), (w) => sum(w) / 64.0);
}

action main(args: string[k]): i32 {
    const x = read_f64(args[0]);
    // one call before the timer: the pages of its result are touched, as
    // the other languages touch their output buffers (DECISIONS D117)
    const [_, _] = bench(1, () => moving_average(x));
    const [r, ns] = bench(parse_i64(args[2]), () => moving_average(x));
    print(ns);
    write_f64(args[1], r);
    return 0;
}
