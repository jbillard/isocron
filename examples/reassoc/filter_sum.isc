// filter_sum.isc (reassociated)  usage: filter_sum <input.f64> <output.f64> <reps>
// `allowReassoc` (SPEC section 10): a rejected element counts as 0.0, no
// compaction (DECISIONS D123); compared with the reassociated variants of
// the other languages (section 14)
@allowReassoc
function filterSum(x: f64[n]): f64 {
    return sum(filter(x, (v) => v > 0.0));
}

action main(args: string[k]): i32 {
    if (args.length < 3) {
        print("usage: filter_sum <input.f64> <output.f64> <reps>");
        return 2;
    }
    const x = readF64(args[0]);
    const [r, ns] = bench(parseI64(args[2]), () => filterSum(x));
    print(ns);
    writeF64(args[1], [r]);
    return 0;
}
