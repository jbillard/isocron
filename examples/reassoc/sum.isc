// sum.isc (reassociated)  usage: sum <input.f64> <output.f64> <reps>
// `allowReassoc` (SPEC section 10): compared with the reassociated variants
// of the other languages (section 14, DECISIONS D123)
@allowReassoc
function fastSum(x: f64[n]): f64 {
    return sum(x);
}

action main(args: string[k]): i32 {
    const x = readF64(args[0]);
    const [r, ns] = bench(parseI64(args[2]), () => fastSum(x));
    print(ns);
    writeF64(args[1], [r]);
    return 0;
}
