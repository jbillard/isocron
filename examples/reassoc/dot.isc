// dot.isc (reassociated)  usage: dot <a.f64> <b.f64> <output.f64> <reps>
// `allowReassoc` (SPEC section 10): compared with the reassociated variants
// of the other languages (section 14, DECISIONS D123)
@allowReassoc
function fastDot(a: f64[n], b: f64[n]): f64 {
    return dot(a, b);
}

action main(args: string[k]): i32 {
    const a = readF64(args[0]);
    const b = readF64(args[1]);
    const [r, ns] = bench(parseI64(args[3]), () => fastDot(a, b));
    print(ns);
    writeF64(args[2], [r]);
    return 0;
}
