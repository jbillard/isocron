// std_dev.isc (reassociated)  usage: std_dev <input.f64> <output.f64> <reps>
// `allow_reassoc` (SPEC section 10): compared with the reassociated variants
// of the other languages (section 14, DECISIONS D123)
@allow_reassoc
function std_dev(x: f64[n]): f64 {
    const m = mean(x);
    return sqrt(sum((x - m) ** 2) / f64(n));
}

action main(args: string[k]): i32 {
    const x = read_f64(args[0]);
    const [r, ns] = bench(parse_i64(args[2]), () => std_dev(x));
    print(ns);
    write_f64(args[1], [r]);
    return 0;
}
