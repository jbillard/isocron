// sum.isc        usage: sum <input.f64> <output.f64> <reps>
action main(args: string[k]): i32 {
    if (args.length < 3) {
        print("usage: sum <input.f64> <output.f64> <reps>");
        return 2;
    }
    const x = readF64(args[0]);
    const [r, ns] = bench(parseI64(args[2]), () => sum(x));
    print(ns);
    writeF64(args[1], [r]);
    return 0;
}
