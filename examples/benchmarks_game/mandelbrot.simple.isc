// mandelbrot (The Computer Language Benchmarks Game), the simplest form: the
// escape tested at each iteration (mandelbrot.isc tests it every 4); the
// Mandelbrot set
// as a P4 bitmap of N x N pixels on the standard output.
// usage: mandelbrot <N>
// a point stays in the set while |z|^2 <= 4, for at most 50 iterations
function inside(cr: f64, ci: f64, zr: f64, zi: f64, i: i64): boolean {
    const tr = zr * zr;
    const ti = zi * zi;
    if (i == 50 || tr + ti > 4.0) return tr + ti <= 4.0;
    return inside(cr, ci, tr - ti + cr, 2.0 * zr * zi + ci, i + 1);
}

// the 8 pixels from x0 on row y, the first one in the high bit
function byte(n: i64, y: i64, x0: i64): u8 {
    const ci = 2.0 * f64(y) / f64(n) - 1.0;
    const pixel = (x) => x < n && inside(2.0 * f64(x) / f64(n) - 1.5, ci, 0.0, 0.0, 0) ? 1u8 : 0u8;
    return fold(iota(8), 0u8, (acc, k) => acc << 1 | pixel(x0 + k));
}

function pixels(n: size, nb: size): u8[n * nb] {
    return map(iota(n * nb), (i) => byte(n, i / nb, 8 * (i % nb)));
}

action main(args: string[k]): i32 {
    const n = parse_i64(args[0]);
    const nb = (n + 7) / 8;
    print_bytes(bytes("P4\n" + to_string(n) + " " + to_string(n) + "\n"));
    print_bytes(pixels(n, nb));
    return 0;
}
