// n-body (The Computer Language Benchmarks Game): the Jovian planets
// around the Sun, N steps of 0.01 days of a symplectic integrator; the
// energy of the system before and after, with 9 decimals. Each step
// updates the velocities pair after pair (i < j), in the order of the
// reference programs, then the positions.
// usage: nbody <N>
type Bodies = {
    x: f64[5], y: f64[5], z: f64[5],
    vx: f64[5], vy: f64[5], vz: f64[5],
};

const DT = 0.01;

function solarMass(): f64 {
    return 4.0 * Math.PI * Math.PI;
}

function masses(): f64[5] {
    const s = solarMass();
    return [s, 9.54791938424326609e-04 * s, 2.85885980666130812e-04 * s, 4.36624404335156298e-05 * s, 5.15138902046611451e-05 * s];
}

function start(): Bodies {
    const d = 365.24;
    const vx = [0.0, 1.66007664274403694e-03 * d, -2.76742510726862411e-03 * d, 2.96460137564761618e-03 * d, 2.68067772490389322e-03 * d];
    const vy = [0.0, 7.69901118419740425e-03 * d, 4.99852801234917238e-03 * d, 2.37847173959480950e-03 * d, 1.62824170038242295e-03 * d];
    const vz = [0.0, -6.90460016972063023e-05 * d, 2.30417297573763929e-05 * d, -2.96589568540237556e-05 * d, -9.51592254519715870e-05 * d];
    const m = masses();
    // the momentum of the planets, given to the Sun so that it is zero
    const px = fold(iota(5), 0.0, (p, i) => p + vx[i] * m[i]);
    const py = fold(iota(5), 0.0, (p, i) => p + vy[i] * m[i]);
    const pz = fold(iota(5), 0.0, (p, i) => p + vz[i] * m[i]);
    return {
        x: [0.0, 4.84143144246472090e+00, 8.34336671824457987e+00, 1.28943695621391310e+01, 1.53796971148509165e+01],
        y: [0.0, -1.16032004402742839e+00, 4.12479856412430479e+00, -1.51111514016986312e+01, -2.59193146099879641e+01],
        z: [0.0, -1.03622044471123109e-01, -4.03523417114321381e-01, -2.23307578892655734e-01, 1.79258772950371181e-01],
        vx: vx.with(0, -px / solarMass()),
        vy: vy.with(0, -py / solarMass()),
        vz: vz.with(0, -pz / solarMass()),
    };
}

// the pairs (i, j), i < j, in the order of the loops of the reference
function pairI(): i64[10] {
    return [0, 0, 0, 0, 1, 1, 1, 2, 2, 3];
}

function pairJ(): i64[10] {
    return [1, 2, 3, 4, 2, 3, 4, 3, 4, 4];
}

function advance(b: Bodies): Bodies {
    const m = masses();
    const pi = pairI();
    const pj = pairJ();
    const v = fold(iota(10), [b.vx, b.vy, b.vz] as const, (v, k) => {
        const [vx, vy, vz] = v;
        const i = pi[k];
        const j = pj[k];
        const dx = b.x[i] - b.x[j];
        const dy = b.y[i] - b.y[j];
        const dz = b.z[i] - b.z[j];
        const distance = Math.sqrt(dx * dx + dy * dy + dz * dz);
        const mag = DT / (distance * distance * distance);
        return [
            vx.with(i, vx[i] - dx * m[j] * mag).with(j, vx[j] + dx * m[i] * mag),
            vy.with(i, vy[i] - dy * m[j] * mag).with(j, vy[j] + dy * m[i] * mag),
            vz.with(i, vz[i] - dz * m[j] * mag).with(j, vz[j] + dz * m[i] * mag),
        ] as const;
    });
    const [vx, vy, vz] = v;
    return { x: b.x + DT * vx, y: b.y + DT * vy, z: b.z + DT * vz, vx: vx, vy: vy, vz: vz };
}

function steps(b: Bodies, n: i64): Bodies {
    if (n == 0) return b;
    return steps(advance(b), n - 1);
}

function energy(b: Bodies): f64 {
    const m = masses();
    return fold(iota(5), 0.0, (e, i) => {
        const kinetic = e + 0.5 * m[i] * (b.vx[i] * b.vx[i] + b.vy[i] * b.vy[i] + b.vz[i] * b.vz[i]);
        return fold(iota(4 - i), kinetic, (f, t) => {
            const j = i + 1 + t;
            const dx = b.x[i] - b.x[j];
            const dy = b.y[i] - b.y[j];
            const dz = b.z[i] - b.z[j];
            return f - m[i] * m[j] / Math.sqrt(dx * dx + dy * dy + dz * dz);
        });
    });
}

action main(args: string[k]): i32 {
    if (args.length < 1) {
        print("usage: nbody <N>");
        return 2;
    }
    const n = parseI64(args[0]);
    const b = start();
    print(energy(b).toFixed(9));
    print(energy(steps(b, n)).toFixed(9));
    return 0;
}
