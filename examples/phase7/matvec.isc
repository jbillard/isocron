// matvec.isc  usage: matvec <matrix.f64> <vector.f64> <output.f64> <reps>
// y = A v, A stored row after row: each row a view (a slice), its dot
// product with v fused
function rowsOf(a: f64[k], v: f64[m]): i64 {
    return k / m;
}

function matvec(a: f64[k], v: f64[m], rows: size): f64[rows] {
    return map(iota(rows), (i) => dot(a.slice(i * m, i * m + m), v));
}

action main(args: string[k]): i32 {
    if (args.length < 4) {
        print("usage: matvec <matrix.f64> <vector.f64> <output.f64> <reps>");
        return 2;
    }
    const a = readF64(args[0]);
    const v = readF64(args[1]);
    const rows = rowsOf(a, v);
    // one call before the timer: the pages of its result are touched, as
    // the other languages touch their output buffers (DECISIONS D117)
    const [_, _] = bench(1, () => matvec(a, v, rows));
    const [r, ns] = bench(parseI64(args[3]), () => matvec(a, v, rows));
    print(ns);
    writeF64(args[2], r);
    return 0;
}
