{
  "files.associations": { "*.isc": "isocron" },
  "isocron.iscc": "${workspaceFolder}/target/release/iscc",
  "[isocron]": { "editor.tabSize": 4, "editor.insertSpaces": true },
  "rust-analyzer.linkedProjects": ["Cargo.toml", "crates/isc-runtime/Cargo.toml"],
  "rust-analyzer.cargo.targetDir": true,
  "files.watcherExclude": {
    "**/target/**": true,
    "bench/build/**": true,
    "bench/benchmarks_game/bin/**": true,
    "bench/benchmarks_game/build/**": true,
    "bench/benchmarks_game/upstream/**": true
  },
  "search.exclude": {
    "**/target": true,
    "bench/build": true,
    "bench/benchmarks_game/bin": true,
    "bench/benchmarks_game/build": true,
    "bench/benchmarks_game/upstream": true
  }
}
